# build outputs (guest images, kernels, staged root trees) are produced on the build box
/build/
/target/
# kernel-module and C build artefacts
*.o
*.ko
# kernel-module build artefacts only (go.mod files must be tracked)
hv/hvx/*.mod
*.mod.c
.*.cmd
modules.order
Module.symvers
# backups and editor files
*.bak
*-bak
*.partA-bak
.DS_Store
__pycache__/
# local machine details (addresses, logins); never commit
/AGENTS.local.md
# hydo-read keeps its own Cargo workspace (its bytes are inside guest images)
/hydo/crates/hydo-read/target/

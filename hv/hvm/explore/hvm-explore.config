# Additions for manifest-built (hvx/onboard) guests on the Mac VMM, on top of ../linux/hvm.config,
# ../linux/hvm-virtio.config and ../services/svc.config: MBR partitions (hydo-init.sh mounts
# /dev/vda2 of the virtio disk) and the loop driver (not used by the images; kept so this
# kernel is the one the results were measured with).
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=4
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSCTL=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
# Network faults (explorer N= / O=): hydo-init.sh's net_on() puts a prio root qdisc on lo, a
# netem qdisc under band 4 and a u32 filter on the service's port. Built in, so its insmod of
# sch_prio/sch_netem/cls_u32 finds nothing to load and the tc commands just work.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_U32=y

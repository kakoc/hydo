# The cgroup lines of the Mac engine's guest kernels from the fingerprint epoch 3 on
# (Image-explore-cg, Image-explore-netns-cg; build-guest-cg.sh; docs/design/guest-cgroups.md),
# appended to the lists of Image-explore and Image-explore-netns on top of allnoconfig. The same
# lines as the KVM kernels' hv/kvm/linux/hydo-kvm-cgroups.config.
#
# cgroup v2 with threaded cgroups and cgroup.freeze: the thread pause P=workload/<thread>@...
# (Milestone 226) moves the named threads into a threaded cgroup and freezes it. The v2 freezer is
# part of CONFIG_CGROUPS; CONFIG_CGROUP_FREEZER is the v1 controller, which hydo does not use.
CONFIG_CGROUPS=y
# the cpu controller and cpu.max, a CPU limit (the etcd example's `limit`, Milestone 211)
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# nothing else: no other controller, no automatic per-session groups, no pressure accounting
# (its averages are updated by a timer)
CONFIG_CGROUP_FREEZER=n
CONFIG_MEMCG=n
CONFIG_BLK_CGROUP=n
CONFIG_CGROUP_PIDS=n
CONFIG_CPUSETS=n
CONFIG_RT_GROUP_SCHED=n
CONFIG_SCHED_AUTOGROUP=n
CONFIG_PSI=n

# Additions for the SECOND arm64 guest kernel, Image-explore-netns (Milestone 99), on top of
# exactly what Image-explore has (../linux/hvm.config, ../linux/hvm-virtio.config,
# ../services/svc.config, hvm-explore.config and CONFIG_ARM64_HVM_IDLE_HVC). Only arm64 manifests
# that need it boot this kernel (hydo-build --arch arm64 records it in the image):
#   network: bridge  (hvx/onboard/hydo-init-netns.sh, M95)  namespaces, veth, bridge, IPv6 on lo
#   addr:            (hvx/onboard/hydo-init-links.sh, M60)  policy routing (`ip rule ... uidrange`)
#   faults: [freeze] (hvx/onboard/hydo-init-freeze.sh, M70) iptables (legacy) + NFQUEUE
# Everything is built in: the kernel has CONFIG_MODULES=n, and the init's insmod calls find
# nothing to load. The x86_64 guest kernel (NixOS 6.6.35) has every option below, as y or m.
# Every other arm64 manifest keeps Image-explore, so its fingerprints are unchanged.

# a network namespace per service (busybox unshare --net=FILE, nsenter -n)
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
# veth pairs and the bridge hydo0 (STP is off at run time; llc/stp are selected by BRIDGE)
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_LLC=y
CONFIG_STP=y
# lo keeps ::1 in every namespace, as on x86_64 (IPv6 is switched off on hydo0, the veths and
# eth0 at run time: no router solicitations, duplicate-address checks or multicast reports)
CONFIG_IPV6=y
# addr: with per-user source routes (the etcd example: ip rule ... uidrange ... lookup ...)
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# F= (freeze at a call): iptables-legacy rules -j NFQUEUE --queue-num 7 --queue-bypass, read by
# /bin/hydo_fc over nfnetlink. The filter table only: no connection tracking, no NAT.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
# kept off on purpose: bridged packets do not go through iptables (as on x86_64, where
# br_netfilter is never loaded), and the bridge runs no multicast snooping timers
CONFIG_BRIDGE_NETFILTER=n
CONFIG_BRIDGE_IGMP_SNOOPING=n
CONFIG_NF_CONNTRACK=n

# The I/O accounting lines of the Mac engine's guest kernels from the fingerprint epoch 7 on
# (Image-explore-io, Image-explore-netns-io, Image-explore-containers-io; build-guest-cg.sh and
# build-guest-containers.sh with PROCIO=1; Milestone 376), appended to the lists of
# Image-explore-cg, Image-explore-netns-cg and Image-explore-containers on top of allnoconfig. The
# same lines as the KVM kernels' hv/kvm/linux/hydo-kvm-procio.config.
#
# /proc/<pid>/io: brpc's bvar (Typesense) reads /proc/self/io in a static initializer and stops
# with SIGSEGV without it; VictoriaMetrics' metrics package, psutil and others read it too. The
# file needs CONFIG_TASK_IO_ACCOUNTING, which needs CONFIG_TASK_XACCT, which needs
# CONFIG_TASKSTATS. The counters count the guest's own reads and writes, so they add nothing
# that differs between two runs of one schedule.
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
# nothing else: no delay accounting (it reads the clock at every wait), no BSD process
# accounting (it writes a file)
CONFIG_TASK_DELAY_ACCT=n
CONFIG_BSD_PROCESS_ACCT=n

# The container lines of the Mac engine's guest kernel variant `containers`
# (Image-explore-containers; build-guest-containers.sh; docs/design/k3s-in-guest.md, Milestone
# 256). An image asks for it with `guest.kernel: containers`. The script takes the list of
# Image-explore-netns-cg (the service networks' options and hvm-cgroups.config), drops from it
# every option this file names, and appends this file. The same lines as the KVM engine's
# hv/kvm/linux/hydo-kvm-containers.config, and CONFIG_CPUSETS=y, which needs SMP (always on
# arm64; the KVM engine's one-vCPU kernel has no SMP). Everything is built in: the guest has no
# module tree.

# containers: the namespaces, seccomp, the POSIX message queue that runc mounts, and keys (the
# kubelet sets kernel.keys.*; runc makes a session keyring)
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# container limits on cgroup v2: memory, pids and cpuset besides cpu (hvm-cgroups.config), and
# the BPF programs that runc attaches as a cgroup v2 device filter
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# image layers
CONFIG_OVERLAY_FS=y

# the pod network: the node's dummy interface, flannel's bridge, and bridged traffic through
# iptables
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_BRIDGE_NETFILTER=y

# Service addresses (kube-proxy) and the CNI port mappings: connection tracking, NAT, the tables
# and matches, for iptables-legacy and for nftables
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y

# network policies (ipsets)
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_NETFILTER_XT_SET=y

# still off, as in hvm-cgroups.config: pressure accounting (a timer updates its averages) and
# automatic per-session groups
CONFIG_PSI=n
CONFIG_SCHED_AUTOGROUP=n

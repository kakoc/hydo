# Minimal arm64 guest kernel for the deterministic Hypervisor.framework VMM (hydo-hvm; hvm.c before M147).
# LSE atomics are required: hvm single-steps short stretches of kernel code, and an
# LDXR/STXR loop can never complete under single-step (each step clears the monitor).
# Applied on top of allnoconfig: make ARCH=arm64 allnoconfig KCONFIG_ALLCONFIG=hvm.config
CONFIG_64BIT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_NR_CPUS=1
CONFIG_LOCALVERSION="-hydo-hvm"
CONFIG_DEFAULT_HOSTNAME="hvm"
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_ELF_CORE=n
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=n
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_250=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_OF=y
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_FORCE_CNTPCT=y
CONFIG_ARM_PSCI_FW=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_ARM64_USE_LSE_ATOMICS=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_PTR_AUTH=n
CONFIG_ARM64_BTI=n
CONFIG_ARM64_MTE=n
CONFIG_ARM64_SVE=n
CONFIG_ARM64_SME=n
CONFIG_ARM64_AMU_EXTN=n
CONFIG_ARM64_E0PD=n
CONFIG_ARM64_PSEUDO_NMI=n
CONFIG_CPU_IDLE=n
CONFIG_SUSPEND=n
CONFIG_PM=n
CONFIG_MODULES=n
CONFIG_KALLSYMS=y
CONFIG_STACKPROTECTOR=n
CONFIG_STACKPROTECTOR_STRONG=n

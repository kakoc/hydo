# Added on top of hvm.config for the virtio kernel (Image-virtio): virtio-mmio block and
# network devices and ext4. The plain Image (no devices) is built without these, so its
# boot fingerprint stays the Milestone 48 baseline.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

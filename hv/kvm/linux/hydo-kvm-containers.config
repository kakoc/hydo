# The container lines of the KVM engine's guest kernel variant `containers` (bzImage-kvm-containers,
# bzImage-kvm-smp-containers; kernel-containers.nix; docs/design/k3s-in-guest.md, Milestone 256).
# An image asks for it with `guest.kernel: containers`. The recipe takes hydo-kvm.config (or the
# SMP list), then hydo-kvm-cgroups.config, drops from both every option this file names, and
# appends this file. kernel-containers.nix fails when a =y line here is not y in the result, or a
# =n line is y. Everything is built in: the guest has no module tree.
#
# The options are those k3s, containerd with runc, flannel and kube-proxy use
# (hydo/onboard/examples/k3s-lease, which loads them as modules of hvx's kernel). The SMP build
# adds CONFIG_CPUSETS=y; the cpuset controller needs SMP, and the kubelet uses only the controllers
# the kernel has.

# containers: the namespaces, seccomp, the POSIX message queue that runc mounts, and keys (the
# kubelet sets kernel.keys.*; runc makes a session keyring)
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# container limits on cgroup v2: memory and pids besides cpu (hydo-kvm-cgroups.config), and the
# BPF programs that runc attaches as a cgroup v2 device filter
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# image layers
CONFIG_OVERLAY_FS=y

# the pod network: the node's dummy interface, flannel's bridge, and bridged traffic through
# iptables
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_BRIDGE_NETFILTER=y

# Service addresses (kube-proxy) and the CNI port mappings: connection tracking, NAT, the tables
# and matches, for iptables-legacy and for nftables
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y

# network policies (ipsets)
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_NETFILTER_XT_SET=y

# still off, as in hydo-kvm-cgroups.config: pressure accounting (a timer updates its averages)
# and automatic per-session groups
CONFIG_PSI=n
CONFIG_SCHED_AUTOGROUP=n

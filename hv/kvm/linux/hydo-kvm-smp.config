# The SMP guest kernel of hydo's KVM engine, for several vCPUs (docs/design/kvm-vcpus.md):
# these lines on top of hydo-kvm.config (kernel-smp.nix drops that file's CONFIG_SMP and
# CONFIG_X86_X2APIC lines and appends this file), with hydo-kvm-smp.patch on top of
# hydo-kvm-guest.patch. The UP kernel bzImage-kvm is built from hydo-kvm.config alone.
#
# The machine with several vCPUs: a local APIC per vCPU in x2APIC mode that the engine emulates
# (its accesses are MSR exits), the CPUs listed in an MP table (no ACPI), every device interrupt
# through the 8259 PIC to CPU 0 (the command line adds noapic), and each CPU's clock event its
# APIC timer on the exit clock.

CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_X86_X2APIC=y
CONFIG_X86_MPPARSE=y

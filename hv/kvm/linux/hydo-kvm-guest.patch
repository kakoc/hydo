diff -ruN a/arch/x86/include/asm/hydo.h b/arch/x86/include/asm/hydo.h
--- /dev/null
+++ b/arch/x86/include/asm/hydo.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * The guest side of hydo's KVM engine (hydo/crates/hydo-kvm): the engine's
+ * exit clock and its devices on I/O ports. Every value read here is a pure
+ * function of the guest's own execution, so the kernel never reads the TSC.
+ *
+ *   HYDO_PORT_CLOCK  IN, two dwords with `rep insl`: the low and the high half
+ *                    of the clock in nanoseconds, both of the same VM exit.
+ *   HYDO_PORT_WALL   IN, two dwords with `rep insl`: the wall clock at boot,
+ *                    in seconds since the epoch (a constant of the engine).
+ *   HYDO_PORT_TIMER  OUT dword: raise IRQ 0 when the clock has advanced by
+ *                    this many nanoseconds (one shot); 0 disarms. The engine
+ *                    disarms it when it delivers the interrupt.
+ *   HYDO_PORT_CTL    OUT dword: 1 powers the machine off, 2 resets it.
+ */
+#ifndef _ASM_X86_HYDO_H
+#define _ASM_X86_HYDO_H
+
+#include <linux/types.h>
+
+#define HYDO_CPUID_SIGNATURE	"hydo-kvm-x86"
+#define HYDO_PORT_CLOCK		0x5e0
+#define HYDO_PORT_WALL		0x5e4
+#define HYDO_PORT_TIMER		0x5e8
+#define HYDO_PORT_CTL		0x5ec
+
+/* Two dwords from one port in one instruction, so in one VM exit. */
+static __always_inline u64 hydo_read_pair(u16 port)
+{
+	u32 v[2] __attribute__((aligned(8)));
+	void *p = v;
+	unsigned long n = 2;
+
+	asm volatile("rep insl"
+		     : "+D" (p), "+c" (n), "=m" (v)
+		     : "d" (port)
+		     : "memory");
+	return ((u64)v[1] << 32) | v[0];
+}
+
+/* The engine's clock in nanoseconds: every read is one VM exit. */
+static __always_inline u64 hydo_clock(void)
+{
+	return hydo_read_pair(HYDO_PORT_CLOCK);
+}
+
+struct pt_regs;
+
+#ifdef CONFIG_HYDO_KVM_GUEST
+extern bool hydo_guest;
+extern bool hydo_tsd_on;
+static inline bool hydo_tsd_forced(void)
+{
+	return hydo_tsd_on;
+}
+/*
+ * Flush the TLB at every change of a present page-table entry, also when x86 would rely on a
+ * spurious fault instead (a permission upgrade): whether a stale entry is still cached when the
+ * guest uses it depends on the host (TLB size, eviction), and the spurious fault it causes is
+ * counted by the guest (vm events, a task's minor faults).
+ */
+static inline bool hydo_strict_tlb(void)
+{
+	return hydo_guest;
+}
+/* The kernel runs as hydo's guest (detected at boot). */
+static inline bool hydo_active(void)
+{
+	return hydo_guest;
+}
+bool hydo_emulate_rdtsc(struct pt_regs *regs);
+#else
+static inline bool hydo_tsd_forced(void)
+{
+	return false;
+}
+static inline bool hydo_strict_tlb(void)
+{
+	return false;
+}
+static inline bool hydo_active(void)
+{
+	return false;
+}
+static inline bool hydo_emulate_rdtsc(struct pt_regs *regs)
+{
+	return false;
+}
+#endif
+
+#endif /* _ASM_X86_HYDO_H */

+		/*
+		 * hydo: a stale entry would give a spurious fault later, or not, depending on
+		 * how long the TLB kept it (host-dependent): flush it now.
+		 */
+		if (hydo_strict_tlb())
+			flush_tlb_page(vma, address);
+	}
 
 	return changed;
 }
@@ -607,7 +614,15 @@
 	 * shouldn't really matter because there's no real memory
 	 * pressure for swapout to react to. ]
 	 */
-	return ptep_test_and_clear_young(vma, address, ptep);
+	int young = ptep_test_and_clear_young(vma, address, ptep);
+
+	/*
+	 * hydo: whether the next access sets the accessed bit again depends on whether the TLB
+	 * still holds the entry (host-dependent), and reclaim decides by that bit: flush it now.
+	 */
+	if (young && hydo_strict_tlb())
+		flush_tlb_page(vma, address);
+	return young;
 }


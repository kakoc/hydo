diff -ruN a/arch/x86/kernel/hydo.c b/arch/x86/kernel/hydo.c
--- /dev/null
+++ b/arch/x86/kernel/hydo.c
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The guest of hydo's KVM engine (hydo/crates/hydo-kvm, docs/design/kvm-engine.md).
+ *
+ * The engine runs one vCPU on stock KVM with no in-kernel interrupt
+ * controller and counts the VM exits that reach it: that count is the
+ * machine's only clock, and every interrupt is delivered at such an exit.
+ * This file makes Linux take all of its time from that clock:
+ *
+ *  - a clocksource and sched_clock that read HYDO_PORT_CLOCK (asm/hydo.h);
+ *  - a one-shot clock event device on IRQ 0 of the 8259 PIC, armed through
+ *    HYDO_PORT_TIMER (the engine's CPUID hides the local APIC, the TSC,
+ *    the TSC deadline timer, kvmclock and every other KVM feature);
+ *  - the wall clock at boot from HYDO_PORT_WALL, no CMOS RTC;
+ *  - a preset delay loop (the calibration would spin without an exit);
+ *  - CR4.TSD, so user-space RDTSC faults and is emulated with the same
+ *    clock in the #GP handler (hydo_emulate_rdtsc);
+ *  - power off and reset through HYDO_PORT_CTL;
+ *  - a TLB flush at every change of a present page-table entry, so no
+ *    spurious page fault depends on what the host's TLB kept (asm/hydo.h);
+ *  - a clock read (an exit) in every sched_yield, so a thread that yields
+ *    while it waits sees time move (kernel/sched/core.c).
+ *
+ * rdtsc() and rdtsc_ordered() themselves read HYDO_PORT_CLOCK in this
+ * configuration (asm/msr.h), so no kernel path reads the TSC.
+ */
+
+#include <linux/init.h>
+#include <linux/clocksource.h>
+#include <linux/clockchips.h>
+#include <linux/interrupt.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/pm.h>
+#include <linux/uaccess.h>
+#include <linux/sched.h>
+#include <asm/cpuid.h>
+#include <asm/hypervisor.h>
+#include <asm/hydo.h>
+#include <asm/io.h>
+#include <asm/paravirt.h>
+#include <asm/x86_init.h>
+#include <asm/time.h>
+#include <asm/tlbflush.h>
+#include <asm/reboot.h>
+
+/* loops_per_jiffy of the delay loop: a fixed value instead of a calibration */
+#define HYDO_LPJ	100000
+
+bool hydo_guest __read_mostly;
+bool hydo_tsd_on __read_mostly;
+
+static u64 hydo_cs_read(struct clocksource *cs)
+{
+	return hydo_clock();
+}
+
+static struct clocksource hydo_cs = {
+	.name	= "hydo",
+	.rating	= 450,
+	.read	= hydo_cs_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static noinstr u64 hydo_sched_clock(void)
+{
+	return hydo_clock();
+}
+
+static int hydo_set_next_event(unsigned long delta, struct clock_event_device *evt)
+{
+	outl((u32)delta, HYDO_PORT_TIMER);
+	return 0;
+}
+
+static int hydo_timer_shutdown(struct clock_event_device *evt)
+{
+	outl(0, HYDO_PORT_TIMER);
+	return 0;
+}
+
+static struct clock_event_device hydo_ce = {
+	.name			= "hydo",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 400,
+	.irq			= 0,
+	.set_next_event		= hydo_set_next_event,
+	.set_state_shutdown	= hydo_timer_shutdown,
+	.set_state_oneshot_stopped = hydo_timer_shutdown,
+};
+
+static irqreturn_t hydo_timer_interrupt(int irq, void *dev_id)
+{
+	/* the engine disarmed the timer when it delivered this interrupt */
+	hydo_ce.event_handler(&hydo_ce);
+	return IRQ_HANDLED;
+}
+
+static void __init hydo_time_init(void)
+{
+	clocksource_register_hz(&hydo_cs, NSEC_PER_SEC);
+	if (request_irq(0, hydo_timer_interrupt,
+			IRQF_NOBALANCING | IRQF_IRQPOLL | IRQF_TIMER, "timer", NULL))
+		pr_err("hydo: cannot get IRQ 0 for the timer\n");
+	hydo_ce.cpumask = cpumask_of(0);
+	clockevents_config_and_register(&hydo_ce, NSEC_PER_SEC, 1000, 0xffffffffUL);
+	global_clock_event = &hydo_ce;
+}
+
+static void hydo_get_wallclock(struct timespec64 *ts)
+{
+	ts->tv_sec = hydo_read_pair(HYDO_PORT_WALL);
+	ts->tv_nsec = 0;
+}
+
+static int hydo_set_wallclock(const struct timespec64 *ts)
+{
+	return -ENODEV;
+}
+
+static unsigned long hydo_calibrate(void)
+{
+	return 0;
+}
+
+static void hydo_power_off(void)
+{
+	outl(1, HYDO_PORT_CTL);
+	for (;;)
+		native_halt();
+}
+
+static void hydo_restart(char *cmd)
+{
+	outl(2, HYDO_PORT_CTL);
+	for (;;)
+		native_halt();
+}
+
+bool hydo_emulate_rdtsc(struct pt_regs *regs)
+{
+	unsigned char b[2];
+	u64 t;
+
+	if (!hydo_tsd_on || test_thread_flag(TIF_NOTSC))
+		return false;
+	if (copy_from_user(b, (const void __user *)regs->ip, 2))
+		return false;
+	if (b[0] != 0x0f || b[1] != 0x31)
+		return false;
+	t = hydo_clock();
+	regs->ax = (u32)t;
+	regs->dx = t >> 32;
+	regs->ip += 2;
+	return true;
+}
+
+static int __init hydo_tsd_init(void)
+{
+	if (!hypervisor_is_type(X86_HYPER_HYDO))
+		return 0;
+	cr4_set_bits(X86_CR4_TSD);
+	hydo_tsd_on = true;
+	return 0;
+}
+early_initcall(hydo_tsd_init);
+
+static uint32_t __init hydo_detect(void)
+{
+	return hypervisor_cpuid_base(HYDO_CPUID_SIGNATURE, 0);
+}
+
+static void __init hydo_init_platform(void)
+{
+	hydo_guest = true;
+	x86_init.timers.timer_init = hydo_time_init;
+	x86_platform.calibrate_tsc = hydo_calibrate;
+	x86_platform.calibrate_cpu = hydo_calibrate;
+	x86_platform.get_wallclock = hydo_get_wallclock;
+	x86_platform.set_wallclock = hydo_set_wallclock;
+	x86_platform.legacy.rtc = 0;
+	x86_platform.legacy.i8042 = X86_LEGACY_I8042_PLATFORM_ABSENT;
+	x86_platform.legacy.no_vga = 1;
+	paravirt_set_sched_clock(hydo_sched_clock);
+	preset_lpj = HYDO_LPJ;
+	pm_power_off = hydo_power_off;
+	machine_ops.restart = hydo_restart;
+	pr_info("hydo: the exit clock is the only clock\n");
+}
+
+const __initconst struct hypervisor_x86 x86_hyper_hydo = {
+	.name			= "hydo",
+	.detect			= hydo_detect,
+	.type			= X86_HYPER_HYDO,
+	.init.init_platform	= hydo_init_platform,
+	.ignore_nopv		= true,
+};

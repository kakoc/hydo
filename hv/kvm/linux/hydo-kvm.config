# The x86_64 guest kernel of hydo's KVM engine (hydo/crates/hydo-kvm, docs/design/kvm-engine.md),
# applied on top of allnoconfig: make ARCH=x86_64 allnoconfig KCONFIG_ALLCONFIG=hydo-kvm.config.
# kernel.nix fails when an option set to y here is not y in the result (allnoconfig drops an
# option silently when a dependency is missing) or one set to n here is y.
#
# The machine: one vCPU, no local APIC and no in-kernel interrupt controller (the engine's
# CPUID hides the APIC; Linux keeps the 8259 PIC, which the engine emulates), the hydo clock
# and timer of hydo-kvm-guest.patch, a 16550 on 0x3f8 (IRQ 4), and virtio-mmio devices named
# on the command line (IRQ 5 and 6). Everything is built in (CONFIG_MODULES=n): the image's
# initramfs and the host controller insmod their modules with errors ignored, so a built-in
# driver simply works. The list of features follows the Mac guest kernels'
# (hv/hvm/linux/hvm.config, hvm-virtio.config, hv/hvm/services/svc.config,
# hv/hvm/explore/hvm-explore.config and hvm-netns.config), which run the same images' services.

CONFIG_64BIT=y
CONFIG_SMP=n
CONFIG_LOCALVERSION_AUTO=n
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HZ_250=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_MODULES=n
CONFIG_KALLSYMS=y
# the boot canary would come from the random pool before it is seeded; as the Mac kernels
CONFIG_STACKPROTECTOR=n
CONFIG_CPU_IDLE=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_PM=n
# no firmware tables and no PCI: the devices are the PIC, the UART, the hydo ports and
# virtio-mmio, all known to the kernel without probing
CONFIG_ACPI=n
CONFIG_PCI=n
# the guest of hydo-kvm-guest.patch; no other paravirtual guest code
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_HYDO_KVM_GUEST=y
CONFIG_KVM_GUEST=n
CONFIG_XEN=n
CONFIG_X86_MCE=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_X2APIC=n
CONFIG_EARLY_PRINTK=y
CONFIG_RTC_CLASS=n

# the image's disk (MBR: the root on vda1, the data on vda2), ext4 for ext2 too
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_MSDOS_PARTITION=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# what the services need (hv/hvm/services/svc.config)
CONFIG_SYSVIPC=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSCTL=y

# network faults (N=, O=): prio + netem + u32
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_U32=y

# network: bridge, addr: and the freeze (hv/hvm/explore/hvm-netns.config)
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_LLC=y
CONFIG_STP=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_BRIDGE_NETFILTER=n
CONFIG_BRIDGE_IGMP_SNOOPING=n
CONFIG_NF_CONNTRACK=n

# hvx safety net on the bare-metal machine itself (Milestone 140).
# Merged by onbox.sh on top of the running Ubuntu kernel's config (/boot/config-6.8.0-146-generic,
# trimmed to the loaded modules by `make localmodconfig`) for kernel.org Linux 6.8.12, the
# tarball of kernel/hvx-debug.config (M97). Unlike that kernel, this one boots the real box: it
# keeps Ubuntu's drivers (ahci, md raid1, igb) and runs the bare-metal machine's own userspace. Only bug
# detectors and what they need are added; nothing here is needed by hvx itself.

# --- identity: never confused with Ubuntu's kernels, never listed by update-grub (not in /boot)
CONFIG_LOCALVERSION="-hydodbg"
CONFIG_LOCALVERSION_AUTO=n

# --- hvx owns VMX: no KVM in this kernel at all
CONFIG_KVM=n

# --- build without Ubuntu's signing keys and without pahole (module signing stays on, because
# the lockdown LSM selects it; the build makes its own key and signatures are not enforced)
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
CONFIG_DEBUG_INFO_BTF=n
CONFIG_WERROR=n

# --- fewer possible CPUs: the bare-metal machine has 8 threads; 8192 per-cpu areas under KASAN and lockdep
# only cost memory and boot time
CONFIG_MAXSMP=n
CONFIG_NR_CPUS=64

# --- preemption: full, so a missed preempt_disable in the run loop shows up
CONFIG_PREEMPT=y
CONFIG_DEBUG_PREEMPT=y

# --- memory errors (KASAN generic inline, also vmalloc: the VM struct is kvzalloc'ed)
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y
CONFIG_SLUB_DEBUG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_DEBUG_VM=y
CONFIG_DEBUG_LIST=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- leaks (scanned on demand: echo scan > /sys/kernel/debug/kmemleak)
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=n
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=n

# --- undefined behaviour (report, never trap)
CONFIG_UBSAN=y
CONFIG_UBSAN_TRAP=n
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
CONFIG_UBSAN_BOOL=y
CONFIG_UBSAN_ENUM=y
CONFIG_UBSAN_SANITIZE_ALL=y

# --- locking and context; larger lockdep tables, because a whole Ubuntu system runs on it and
# an exhausted table turns lockdep off before hvx is loaded
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_IRQFLAGS=y
CONFIG_PROVE_RCU=y
CONFIG_LOCKDEP_BITS=16
CONFIG_LOCKDEP_CHAINS_BITS=18
CONFIG_LOCKDEP_STACK_TRACE_BITS=20
CONFIG_LOCKDEP_STACK_TRACE_HASH_BITS=16
CONFIG_LOCKDEP_CIRCULAR_QUEUE_BITS=12
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_WQ_WATCHDOG=y

# --- a panic's log survives the reboot that panic= makes (EFI variables, read on the normal
# kernel from /sys/fs/pstore or /var/lib/systemd/pstore)
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y

# --- symbols and debugfs
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_INFO=y

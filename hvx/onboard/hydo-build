def _compose_expand(m, path):
    """The test composer (hydo_composer.py, MANIFEST.md "The test composer"): the plan's test:
    section plus a hydo/ folder next to the manifest (workload/, checks/, regressions/), and the
    hydo_version: pin. Rewrites m before validate(); returns the plan meta or None (then m is
    untouched and the image is what it was before the composer existed)."""
    hc = _composer()
    if "hydo_version" in m:
        hc.check_version(m["hydo_version"], hc.engine_version(HERE), ManifestError,
                         lambda msg: print("hydo-build: warning: %s" % msg, file=sys.stderr))
    folder = hc.scan_folder(os.path.dirname(os.path.abspath(path)), ManifestError)
    meta = hc.expand(m, ManifestError, folder)
    if meta is not None:
        meta["_folder"] = folder
    return meta


def _compose_stage(m, R):
    meta = m.get("_compose")
    if meta:
        _composer().stage({k: v for k, v in meta.items() if k != "_folder"}, R, HERE, meta.get("_folder"))



#!/usr/bin/env python3
"""hydo-build -- compile a project manifest (hydo.yaml, see MANIFEST.md) into a hydo guest image.

    hydo-build <hydo.yaml> [--set KEY=VALUE ...] [--out NAME] [--build-dir DIR] [--arch x86_64|arm64]
               [--check] [--print-shell] [--print-init] [--print-world]

Produces, in --build-dir (default ./build):
    <NAME>-ext4.img   read-only ext4 root (p1): the project's files + closures, busybox, the
                      generic /sbin/init (hydo-init.sh), the compiled manifest in /etc/hydo/
    <NAME>-data.img   journaled ext4 data disk (p2), mounted on /data: the fault target
    <NAME>-disk.img   both behind a hand-made MBR -- the file the harnesses take
NAME defaults to explore-ob-<project name> (the "explore" prefix: hvx_explore serves it).
--arch arm64 builds <NAME>-arm64.cpio.gz instead, one initramfs for the Mac VMM
(hvx-mac/explore/hvmx; see hydo_build_arm64.py).

Byte-reproducible like the hand-written image scripts (build-stack.sh): pinned mke2fs run
under a pinned libfaketime, fixed UUIDs and hash seeds derived from the project name,
non-lazy init, every superblock and inode time zeroed afterwards, all source mtimes fixed, and
the frozen clock read in a fixed time zone (FAKE_TZ), so the machine's zone does not matter.

Host tools (same defaults as build-stack.sh; override with the environment variables):
    HYDO_BUSYBOX  static busybox          HYDO_SEEDRNG   prebuilt static hvx_seedrng
    HYDO_MKE2FS   e2fsprogs mke2fs        HYDO_FAKETIME  libfaketime's faketime
    HYDO_IPROUTE2 iproute2 store path     HYDO_MODROOT   guest kernel module tree
Stdlib only (the build box has no PyYAML): the YAML subset is parsed by parse_yaml() below.
"""
import hashlib, json, mmap, os, re, shutil, stat, struct, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
FIXED_MTIME = 1600000000
FAKE_TS = "2020-09-13 16:26:40"
# libfaketime reads FAKE_TS in the local time zone. Every recorded image was built on the Nix
# build box, whose zone is UTC+4 (all year since 2005), where FAKE_TS is exactly
# FIXED_MTIME. FAKE_TZ sets that zone explicitly for every faketime'd call (TZ=UTC-4 is POSIX
# notation for UTC+4), so a build in any other zone gets the same instant and the same bytes,
# and a build on the build box is unchanged.
FAKE_TZ = "UTC-4"


def faketime_env(**extra):
    """The environment of a command run under faketime FAKE_TS: the caller's, with TZ=FAKE_TZ."""
    return dict(os.environ, TZ=FAKE_TZ, **extra)
NETMODS = ["sch_prio", "sch_netem", "cls_u32"]
# the freeze-at-a-call fault (F=, hydo-init-freeze.sh): netfilter queue + iptables-legacy
FCMODS = ["x_tables", "ip_tables", "iptable_filter", "xt_tcpudp", "xt_NFQUEUE", "nfnetlink", "nfnetlink_queue"]

# ------------------------------------------------------------------ YAML subset parser
class YamlError(Exception):
    pass


def _strip_comment(line):
    out, q = [], None
    for i, c in enumerate(line):
        if q:
            if c == "\\" and q == '"':
                out.append(c); continue
            if c == q:
                q = None
        elif c in "'\"":
            q = c
        elif c == "#" and (i == 0 or line[i - 1] in " \t"):
            break
        out.append(c)
    return "".join(out).rstrip()


def _scalar(tok, where):
    t = tok.strip()
    if t == "":
        return None
    if t[0] == '"':
        if not t.endswith('"') or len(t) < 2:
            raise YamlError("%s: unterminated string %s" % (where, t))
        return json.loads(t)
    if t[0] == "'":
        if not t.endswith("'") or len(t) < 2:
            raise YamlError("%s: unterminated string %s" % (where, t))
        return t[1:-1].replace("''", "'")
    if t[0] in "[{":
        v, rest = _flow(t, 0, where)
        if t[rest:].strip():
            raise YamlError("%s: junk after %s" % (where, t))
        return v
    if t in ("true", "True", "yes"):
        return True
    if t in ("false", "False", "no"):
        return False
    if t in ("null", "~"):
        return None
    if re.fullmatch(r"-?\d+", t):
        return int(t)
    return t


def _flow(s, i, where):
    """[a, b] / {k: v} with nesting; returns (value, next index)."""
    open_c = s[i]
    close_c = "]" if open_c == "[" else "}"
    i += 1
    items, buf, depth, q = [], "", 0, None
    while i < len(s):
        c = s[i]
        if q:
            buf += c
            if c == "\\" and q == '"':
                buf += s[i + 1]; i += 2; continue
            if c == q:
                q = None
        elif c in "'\"":
            q = c; buf += c
        elif c in "[{":
            depth += 1; buf += c
        elif c in "]}" and depth:
            depth -= 1; buf += c
        elif c == close_c:
            if buf.strip():
                items.append(buf)
            break
        elif c == "," and not depth:
            items.append(buf); buf = ""
        else:
            buf += c
        i += 1
    else:
        raise YamlError("%s: unterminated %s" % (where, open_c))
    if open_c == "[":
        return [_scalar(x, where) for x in items], i + 1
    d = {}
    for x in items:
        k, sep, v = x.partition(":")
        if not sep:
            raise YamlError("%s: flow mapping entry without ':' (%s)" % (where, x.strip()))
        d[_scalar(k, where)] = _scalar(v, where)
    return d, i + 1


def parse_yaml(text, name="hydo.yaml"):
    """Block mappings, block sequences, `|` literal blocks, flow [..]/{..}, quoted and plain
    scalars, comments. No anchors, tags or multi-documents (MANIFEST.md lists the subset)."""
    raw = text.split("\n")
    lines = []          # (lineno, indent, content)
    i = 0
    while i < len(raw):
        ln = raw[i]
        if "\t" in ln[: len(ln) - len(ln.lstrip())]:
            raise YamlError("%s:%d: tab in indentation" % (name, i + 1))
        c = _strip_comment(ln)
        if c.strip():
            lines.append((i + 1, len(c) - len(c.lstrip()), c.strip(), i))
        i += 1

    pos = [0]

    def block_literal(start_raw, parent_indent):
        # literal block: raw lines after start_raw whose indent > parent_indent (or blank)
        body, j = [], start_raw + 1
        ind = None
        while j < len(raw):
            ln = raw[j]
            if ln.strip() == "":
                body.append(""); j += 1; continue
            k = len(ln) - len(ln.lstrip())
            if k <= parent_indent:
                break
            if ind is None:
                ind = k
            if k < ind:
                break
            body.append(ln[ind:]); j += 1
        while body and body[-1] == "":
            body.pop()
        # skip the parsed raw lines
        while pos[0] < len(lines) and lines[pos[0]][3] < j:
            pos[0] += 1
        return "\n".join(body) + "\n"

    def parse_value_after(rest, indent, lineno, raw_idx):
        if rest in ("|", "|-", "|+"):
            v = block_literal(raw_idx, indent)
            return v.rstrip("\n") if rest == "|-" else v
        if rest in (">", ">-"):       # folded: the lines joined by single spaces
            v = " ".join(x.strip() for x in block_literal(raw_idx, indent).split("\n") if x.strip())
            return v if rest == ">-" else v + "\n"
        if rest == "":
            if pos[0] < len(lines) and lines[pos[0]][1] > indent:
                return parse_node(lines[pos[0]][1])
            if pos[0] < len(lines) and lines[pos[0]][1] == indent and lines[pos[0]][2].startswith("- "):
                return parse_node(indent)       # "key:\n- a" (sequence at the same indent)
            return None
        return _scalar(rest, "%s:%d" % (name, lineno))

    def parse_node(indent):
        lineno, ind, content, ridx = lines[pos[0]]
        if content.startswith("- ") or content == "-":
            seq = []
            while pos[0] < len(lines) and lines[pos[0]][1] == indent and (lines[pos[0]][2].startswith("- ") or lines[pos[0]][2] == "-"):
                lineno, ind, content, ridx = lines[pos[0]]
                item = content[1:].strip()
                pos[0] += 1
                if item == "":
                    seq.append(parse_node(lines[pos[0]][1]) if pos[0] < len(lines) and lines[pos[0]][1] > indent else None)
                elif re.match(r"^[^'\"\[{][^:]*:( |$)", item) or re.match(r"^\"[^\"]*\":( |$)", item):
                    # "- key: value" starts a mapping whose other keys sit at indent+2
                    sub_indent = indent + 2
                    k, _, rest = item.partition(":")
                    m = {_scalar(k, name): parse_value_after(rest.strip(), sub_indent, lineno, ridx)}
                    while pos[0] < len(lines) and lines[pos[0]][1] == sub_indent and not lines[pos[0]][2].startswith("- "):
                        k2, v2 = parse_pair(sub_indent)
                        if k2 in m:
                            raise YamlError("%s:%d: duplicate key %s" % (name, lines[pos[0] - 1][0], k2))
                        m[k2] = v2
                    seq.append(m)
                else:
                    seq.append(_scalar(item, "%s:%d" % (name, lineno)))
            return seq
        m = {}
        while pos[0] < len(lines) and lines[pos[0]][1] == indent:
            if lines[pos[0]][2].startswith("- "):
                raise YamlError("%s:%d: a list item where a key was expected" % (name, lines[pos[0]][0]))
            k, v = parse_pair(indent)
            if k in m:
                raise YamlError("%s:%d: duplicate key %s" % (name, lines[pos[0] - 1][0], k))
            m[k] = v
        if pos[0] < len(lines) and lines[pos[0]][1] > indent:
            raise YamlError("%s:%d: unexpected indentation" % (name, lines[pos[0]][0]))
        return m

    def parse_pair(indent):
        lineno, ind, content, ridx = lines[pos[0]]
        mm = re.match(r'^("(?:[^"\\]|\\.)*"|\'[^\']*\'|[^:]+?):( (.*)|$)', content)
        if not mm:
            raise YamlError("%s:%d: expected 'key: value', got %r" % (name, lineno, content))
        key = _scalar(mm.group(1), "%s:%d" % (name, lineno))
        rest = (mm.group(3) or "").strip()
        pos[0] += 1
        return key, parse_value_after(rest, indent, lineno, ridx)

    if not lines:
        return {}
    v = parse_node(lines[0][1])
    if pos[0] != len(lines):
        raise YamlError("%s:%d: could not parse from here (indentation?)" % (name, lines[pos[0]][0]))
    return v


# ------------------------------------------------------------------ build parameters
PARAM_RE = re.compile(r"\{\{([A-Za-z_][A-Za-z0-9_]*)\}\}")


def apply_params(m, overrides):
    """params: {key: default} + --set key=value -> every {{key}} in every string value of the
    manifest (not in keys) is replaced. Lets one hydo.yaml build several versions of a
    project. A {{name}} with no such parameter, or a --set of an undeclared key, is an error.
    Returns the effective parameter values ({} when the manifest declares none)."""
    params = m.pop("params", None) or {}
    if not isinstance(params, dict):
        raise ManifestError("params: must be a mapping of name: default value")
    vals = {}
    for k, v in params.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", str(k)):
            raise ManifestError("params: name %r: letters, digits and '_' only" % k)
        vals[str(k)] = "" if v is None else str(v)
    for k, v in overrides:
        if k not in vals:
            raise ManifestError("--set %s: the manifest declares no parameter %r (params: %s)" %
                                (k, k, ", ".join(sorted(vals)) or "none"))
        vals[k] = v

    def sub(x, where):
        if isinstance(x, str):
            def one(mo):
                if mo.group(1) not in vals:
                    raise ManifestError("%s: {{%s}} is not a declared parameter" % (where, mo.group(1)))
                return vals[mo.group(1)]
            return PARAM_RE.sub(one, x)
        if isinstance(x, list):
            return [sub(y, "%s[%d]" % (where, i)) for i, y in enumerate(x)]
        if isinstance(x, dict):
            return {k: sub(y, "%s.%s" % (where, k)) for k, y in x.items()}
        return x
    for k in list(m):
        m[k] = sub(m[k], k)
    return vals


# ------------------------------------------------------------------ manifest validation
class ManifestError(Exception):
    pass


NAME_RE = re.compile(r"^[a-z][a-z0-9_]*$")
KNOWN_TOP = {"name", "description", "guest", "root", "data", "env", "shell", "services",
             "provision", "workload", "knobs", "invariants", "faults", "freeze_match", "image", "params",
             "fakes", "proxies",
             "buggify",
             "test", "format", "hydo_version"}      # the last three: the test composer (hydo_composer.py)
KNOWN_SVC = {"name", "cmd", "setup", "ready", "ready_timeout", "port", "depends_on",
             "recovery", "description", "addr",
             "image", "image_ref", "entrypoint", "workdir", "user", "env", "mounts"}   # the last seven: hydo_oci.py
KNOWN_INV = {"id", "type", "msg", "cmd", "every", "final", "description", "within", "after", "poll"}
LIVE_ANCHORS = ("heal", "start")
KNOWN_KNOB = {"token", "name", "default", "set", "values", "safe", "description"}
FAULT_KINDS = {"kill", "pause", "network", "oneway", "cut", "clock", "disk", "freeze", "protocol"}
# faults: omitted = these. `freeze` is opt-in (it stages iptables and a helper into the root),
# so a manifest that does not list it builds exactly as before. `protocol` (H=, fakes:/proxies:)
# stages nothing by itself.
DEFAULT_FAULT_KINDS = FAULT_KINDS - {"freeze", "protocol"}


def _need(d, k, where, typ=str):
    if k not in d or d[k] in (None, ""):
        raise ManifestError("%s: missing required field '%s'" % (where, k))
    if typ is str and isinstance(d[k], (int, bool)):
        return str(d[k])
    if not isinstance(d[k], typ):
        raise ManifestError("%s: field '%s' must be a %s" % (where, k, typ.__name__))
    return d[k]


def _unknown(d, known, where):
    bad = sorted(set(d) - known)
    if bad:
        raise ManifestError("%s: unknown field(s) %s (known: %s)" % (where, ", ".join(map(str, bad)), ", ".join(sorted(known))))


def validate(m):
    if not isinstance(m, dict):
        raise ManifestError("the manifest must be a mapping")
    _unknown(m, KNOWN_TOP, "top level")
    if "buggify" in m and not isinstance(m["buggify"], bool):
        raise ManifestError("buggify: must be true or false")
    if m.get("buggify") is True and any(str(k.get("token")) == "B" for k in (m.get("knobs") or []) if isinstance(k, dict)):
        raise ManifestError("buggify: true reserves the schedule token B (the BUGGIFY seed); rename the knob B")
    if "image" in m:
        raise ManifestError("top level: 'image:' belongs to a service (services[].image: a Docker/OCI "
                            "image file; MANIFEST.md)")
    name = _need(m, "name", "top level")
    if not re.fullmatch(r"[a-z][a-z0-9-]*", name):
        raise ManifestError("name: use lowercase letters, digits and '-' (got %r)" % name)
    svcs = m.get("services") or []
    if not isinstance(svcs, list):
        raise ManifestError("services: must be a list (it may be empty: a project that is only a workload)")
    m["services"] = svcs
    seen = {}
    for i, s in enumerate(svcs):
        where = "services[%d]" % i
        if not isinstance(s, dict):
            raise ManifestError("%s: must be a mapping" % where)
        _unknown(s, KNOWN_SVC, where)
        n = _need(s, "name", where)
        if not NAME_RE.match(n):
            raise ManifestError("%s: name %r must match [a-z][a-z0-9_]* (it becomes a shell identifier)" % (where, n))
        if n in seen:
            raise ManifestError("%s: duplicate service name %r" % (where, n))
        seen[n] = s
        if "image" not in s:          # an image service defaults to the image's Entrypoint + Cmd
            _need(s, "cmd", where)
        _need(s, "ready", where)
        if "port" in s and not isinstance(s["port"], int):
            raise ManifestError("%s: port must be a number" % where)
        validate_addr(s, svcs, where)
        for d in s.get("depends_on") or []:
            if d not in [x.get("name") for x in svcs]:
                raise ManifestError("%s: depends_on names unknown service %r" % (where, d))
    wl = m.get("workload")
    if not isinstance(wl, dict):
        raise ManifestError("workload: required (steps + run)")
    _unknown(wl, {"steps", "run", "retry", "process", "timeout", "description"}, "workload")
    st = _need(wl, "steps", "workload", int)
    if st < 1 or st > 1000:
        raise ManifestError("workload.steps: between 1 and 1000")
    _need(wl, "run", "workload")
    invs = m.get("invariants") or []
    if not invs:
        raise ManifestError("invariants: at least one invariant is required (otherwise nothing is checked)")
    ids = set()
    for i, v in enumerate(invs):
        where = "invariants[%d]" % i
        _unknown(v, KNOWN_INV, where)
        vid = _need(v, "id", where)
        if not re.fullmatch(r"[A-Za-z0-9_.\-]+", vid):
            raise ManifestError("%s: id %r: letters, digits, '.', '_' and '-' only" % (where, vid))
        if vid in ids:
            raise ManifestError("%s: duplicate id %r" % (where, vid))
        ids.add(vid)
        _need(v, "cmd", where)
        t = v.get("type", "always")
        if t not in ("always", "always_or_unreachable", "eventually"):
            raise ManifestError("%s: type must be always, always_or_unreachable or eventually" % where)
        if t == "eventually":
            # bounded liveness: polled from an anchor until it holds or `within` s pass
            for k in ("every", "final"):
                if k in v:
                    raise ManifestError("%s: an eventually invariant has no %s: (it is polled from "
                                        "its anchor until it holds or its deadline passes)" % (where, k))
            w = _need(v, "within", where, int)
            if isinstance(w, bool) or w < 1 or w > 3600:
                raise ManifestError("%s: within is a whole number of seconds of guest time, 1..3600" % where)
            if v.get("after", "heal") not in LIVE_ANCHORS:
                raise ManifestError("%s: after must be one of %s" % (where, ", ".join(LIVE_ANCHORS)))
            if "poll" in v and (not isinstance(v["poll"], int) or isinstance(v["poll"], bool) or v["poll"] < 1):
                raise ManifestError("%s: poll is a whole number of seconds >= 1" % where)
            continue
        for k in ("within", "after", "poll"):
            if k in v:
                raise ManifestError("%s: %s: is only for type: eventually" % (where, k))
        if "every" in v and (not isinstance(v["every"], int) or v["every"] < 1):
            raise ManifestError("%s: every is a whole number of seconds >= 1" % where)
        if not v.get("final", "every" not in v) and "every" not in v:
            raise ManifestError("%s: an invariant with final: false needs every:" % where)
    toks = set()
    for i, k in enumerate(m.get("knobs") or []):
        where = "knobs[%d]" % i
        _unknown(k, KNOWN_KNOB, where)
        t = _need(k, "token", where)
        if not re.fullmatch(r"[A-Z]", t) or t in "KNCPTOFH":
            raise ManifestError("%s: token must be one capital letter other than K N C P T O F H (fault tokens)" % where)
        if t in toks:
            raise ManifestError("%s: duplicate token %s" % (where, t))
        toks.add(t)
        _need(k, "default", where); _need(k, "set", where)
    for f in m.get("faults") or []:
        if f not in FAULT_KINDS:
            raise ManifestError("faults: unknown kind %r (known: %s)" % (f, ", ".join(sorted(FAULT_KINDS))))
    fm = m.get("freeze_match")
    if fm is not None:
        # a list (strings that may occur in either direction), or a mapping with the lists
        # replies: (packets the frozen service receives) and requests: (packets it sends)
        lists = [fm] if isinstance(fm, list) else (list(fm.values()) if isinstance(fm, dict) else None)
        if lists is None or (isinstance(fm, dict) and set(fm) - {"replies", "requests"}) or \
           any(not isinstance(l, list) or any(not isinstance(x, str) or not x or ":" in x or " " in x for x in l)
               for l in lists):
            raise ManifestError("freeze_match: a list of payload strings, or a mapping with lists replies: and "
                                "requests:; each string non-empty, without spaces or colons (%xx escapes a byte)")
        if any(lists) and "freeze" not in (m.get("faults") or []):
            raise ManifestError("freeze_match: only with `freeze` in faults:")
    data = m.get("data") or {}
    _unknown(data, {"size_mib", "mount", "dirs", "description"}, "data")
    root = m.get("root") or {}
    _unknown(root, {"size_mib", "nix", "files", "text", "dirs", "description"}, "root")
    guest = m.get("guest") or {}
    _unknown(guest, {"ram_mib", "clock_start", "clock_after_cut", "cpu", "description"}, "guest")
    if "clock_after_cut" in guest:
        c = guest["clock_after_cut"]
        if not isinstance(c, int) or isinstance(c, bool) or not 1 <= c <= 10 * 365 * 86400:
            raise ManifestError("guest.clock_after_cut: whole seconds in [1, 315360000] (got %r)" % (c,))
    if "cpu" in guest and guest["cpu"] not in ("v2", "v3"):
        raise ManifestError("guest.cpu: v2 (the default: x86-64-v2, no AVX) or v3 (adds AVX/AVX2, FMA, "
                            "BMI1/2, F16C, LZCNT, MOVBE, XSAVE; x86_64 only) (got %r)" % (guest["cpu"],))
    if "ram_mib" in guest:
        r = guest["ram_mib"]
        if not isinstance(r, int) or isinstance(r, bool) or not RAM_MIB_MIN <= r <= max(RAM_MIB_MAX.values()):
            raise ManifestError("guest.ram_mib: a whole number of MiB in [%d, %d] (got %r; x86_64 allows up "
                                "to %d)" % (RAM_MIB_MIN, max(RAM_MIB_MAX.values()), r, RAM_MIB_MAX["x86_64"]))
    validate_world(m)
    return m


# guest RAM the explorer engines accept (hvx_explore / hvmx check the same bounds): x86_64 stays
# below hvx's 4th-GiB MMIO hole (MAX_GPAGES, M28); the Mac VMM has been run at 4 GiB (M48).
RAM_MIB_MIN = 256
RAM_MIB_MAX = {"x86_64": 3072, "arm64": 4096}


def check_ram_arch(m, arch):
    r = (m.get("guest") or {}).get("ram_mib", 1024)
    if arch in RAM_MIB_MAX and r > RAM_MIB_MAX[arch]:
        raise ManifestError("guest.ram_mib: %d MiB is more than --arch %s runs (at most %d)" % (r, arch, RAM_MIB_MAX[arch]))
    if (m.get("guest") or {}).get("cpu") == "v3" and arch != "x86_64":
        raise ManifestError("guest.cpu: v3 (AVX/AVX2) is an x86_64 option; --arch %s cannot use it" % arch)


ADDR_RE = re.compile(r"^127\.(\d{1,3})\.(\d{1,3})\.(\d{1,3})$")
LINKS_INIT = "hydo-init-links.sh"      # spliced into /sbin/init only for manifests with addr:


def validate_addr(s, svcs, where):
    """addr: the service's own loopback address (link faults, MANIFEST.md). Optional."""
    if "addr" not in s:
        return
    a = str(s["addr"])
    mo = ADDR_RE.match(a)
    if not mo or any(int(x) > 255 for x in mo.groups()) or a == "127.0.0.1":
        raise ManifestError("%s: addr %r must be a loopback address 127.x.y.z other than 127.0.0.1 "
                            "(127.0.0.1 is the clients' and the init's own source address)" % (where, a))
    if [str(x.get("addr")) for x in svcs].count(a) > 1:
        raise ManifestError("%s: addr %s is used by two services" % (where, a))


def has_links(m):
    return any("addr" in s for s in m["services"])


def has_freeze(m):
    return "freeze" in (m.get("faults") or [])


# ------------------------------------------------------------------ fake outside services
# fakes: (fake HTTP/gRPC services that record what the outside world saw) and proxies: (fault
# proxies in front of a real service), both served by one in-guest program, hydo-world
# (hvx/onboard/world/), and faulted by H= tokens (hydo-init-fakes.sh). MANIFEST.md, "Fake outside
# services". A manifest without either key builds exactly as before.
WORLD_INIT = "hydo-init-fakes.sh"      # inserted into /sbin/init only for manifests with fakes:/proxies:
PF_WRAP = ("start_all", "set_knob", "step_range", "restart_dead", "failed_ids", "final_verdict")
KNOWN_FAKE = {"name", "port", "addr", "protocol", "idempotency", "ref", "routes", "description"}
KNOWN_PROXY = {"name", "port", "addr", "protocol", "idempotency", "ref", "routes", "to", "service", "description"}
KNOWN_ROUTE = {"name", "method", "path", "status", "code", "headers", "body", "message", "ref", "effect",
               "idempotent", "webhook", "description"}
KNOWN_HOOK = {"url", "method", "body", "headers", "delay_ms", "retries", "description"}
EXTRACT_RE = re.compile(r"^(header:[A-Za-z0-9-]+|json:[A-Za-z0-9_.]+|query:[A-Za-z0-9_-]+|form:[A-Za-z0-9_-]+|"
                        r"path:[A-Za-z0-9_]+|pb:[1-9][0-9]*|body)$")
HOOK_VARS = {"seq", "ref", "idem", "fake", "route"}


def has_world(m):
    return bool(m.get("fakes") or m.get("proxies"))


def _world_addr(x, where):
    a = str(x.get("addr", "127.0.0.1"))
    mo = ADDR_RE.match(a)
    if not mo or any(int(v) > 255 for v in mo.groups()):
        raise ManifestError("%s: addr %r must be a loopback address 127.x.y.z" % (where, a))
    return a


def validate_world(m):
    fakes, proxies = m.get("fakes") or [], m.get("proxies") or []
    if not isinstance(fakes, list) or not isinstance(proxies, list):
        raise ManifestError("fakes: and proxies: are lists")
    svcs = {s["name"]: s for s in m["services"]}
    used = {}          # (addr, port) -> who
    for s in m["services"]:
        if s.get("port"):
            used[(str(s.get("addr", "127.0.0.1")), int(s["port"]))] = "service " + s["name"]
    names = set()
    for kind, lst, known in (("fakes", fakes, KNOWN_FAKE), ("proxies", proxies, KNOWN_PROXY)):
        for i, e in enumerate(lst):
            where = "%s[%d]" % (kind, i)
            if not isinstance(e, dict):
                raise ManifestError("%s: must be a mapping" % where)
            _unknown(e, known, where)
            n = _need(e, "name", where)
            if not NAME_RE.match(n):
                raise ManifestError("%s: name %r must match [a-z][a-z0-9_]* (fault tokens name it: H=%s@...)" % (where, n, n))
            if n in names or n in svcs or n == "workload":
                raise ManifestError("%s: name %r is already a service, fake or proxy" % (where, n))
            names.add(n)
            port = e.get("port")
            if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
                raise ManifestError("%s: port: required, a TCP port number" % where)
            ap = (_world_addr(e, where), port)
            if ap in used:
                raise ManifestError("%s: %s:%d is already used by %s" % (where, ap[0], port, used[ap]))
            used[ap] = "%s %s" % (kind[:-1] if kind == "fakes" else "proxy", n)
            proto = e.get("protocol", "http")
            if proto not in (("http", "grpc") if kind == "fakes" else ("http", "grpc", "tcp")):
                raise ManifestError("%s: protocol must be %s" % (where, "http or grpc" if kind == "fakes" else "http, grpc or tcp"))
            for k in ("idempotency", "ref"):
                if k in e and not EXTRACT_RE.match(str(e[k])):
                    raise ManifestError("%s: %s %r: one of header:<Name>, json:<field>, query:<name>, form:<name>, "
                                        "path:<name|n>, pb:<field number>, body" % (where, k, e[k]))
            if kind == "proxies":
                if ("to" in e) == ("service" in e):
                    raise ManifestError("%s: give exactly one of to: <host:port> or service: <name>" % where)
                if "service" in e:
                    t = svcs.get(e["service"])
                    if not t or not t.get("port"):
                        raise ManifestError("%s: service %r is not a service with a port:" % (where, e["service"]))
                elif not re.fullmatch(r"127\.\d+\.\d+\.\d+:\d+", str(e["to"])):
                    raise ManifestError("%s: to %r must be <loopback address>:<port>" % (where, e["to"]))
                if proto == "tcp" and e.get("routes"):
                    raise ManifestError("%s: a tcp proxy has no routes (one connection = one request, route conn)" % where)
            routes = e.get("routes") or []
            if kind == "fakes" and not routes:
                raise ManifestError("%s: routes: at least one" % where)
            rn = set()
            for j, r in enumerate(routes):
                rw = "%s.routes[%d]" % (where, j)
                if not isinstance(r, dict):
                    raise ManifestError("%s: must be a mapping" % rw)
                _unknown(r, KNOWN_ROUTE if kind == "fakes" else {"name", "method", "path", "ref", "effect", "description"}, rw)
                x = _need(r, "name", rw)
                if not NAME_RE.match(x) or x in rn or x in ("any", "conn"):
                    raise ManifestError("%s: name %r: [a-z][a-z0-9_]*, unique, not 'any' or 'conn'" % (rw, x))
                rn.add(x)
                if "ref" in r and not EXTRACT_RE.match(str(r["ref"])):
                    raise ManifestError("%s: ref %r is not an extractor (see MANIFEST.md)" % (rw, r["ref"]))
                for k in ("status", "code"):
                    if k in r and (not isinstance(r[k], int) or isinstance(r[k], bool)):
                        raise ManifestError("%s: %s must be a number" % (rw, k))
                if "message" in r and not re.fullmatch(r"(?:[0-9a-fA-F]{2})*", str(r["message"])):
                    raise ManifestError("%s: message is the protobuf bytes in hex" % rw)
                for k in ("effect", "idempotent"):
                    if k in r and not isinstance(r[k], bool):
                        raise ManifestError("%s: %s is true or false" % (rw, k))
                if r.get("idempotent") and not e.get("idempotency"):
                    raise ManifestError("%s: idempotent: true needs the fake's idempotency: (where the key is)" % rw)
                wh = r.get("webhook")
                if wh is not None:
                    if not isinstance(wh, dict):
                        raise ManifestError("%s.webhook: must be a mapping" % rw)
                    _unknown(wh, KNOWN_HOOK, rw + ".webhook")
                    if not re.fullmatch(r"http://127\.\d+\.\d+\.\d+:\d+/\S*", str(_need(wh, "url", rw + ".webhook"))):
                        raise ManifestError("%s.webhook: url must be http://<loopback address>:<port>/<path>" % rw)
                    for t in [wh.get("body") or "", wh["url"]] + list((wh.get("headers") or {}).values()):
                        bad = set(re.findall(r"\{(seq|ref|idem|fake|route|json|header|query|path|form|pb)(?::[^{}\"]*)?\}", str(t))) - HOOK_VARS
                        if bad:
                            raise ManifestError("%s.webhook: {%s:...}: a webhook may use only {%s} (it can be re-sent "
                                                "after a power cut, without the request)" % (rw, sorted(bad)[0], "} {".join(sorted(HOOK_VARS))))
                    for k in ("delay_ms", "retries"):
                        if k in wh and (not isinstance(wh[k], int) or wh[k] < 0):
                            raise ManifestError("%s.webhook: %s is a whole number >= 0" % (rw, k))


def world_targets(m):
    """Every name an H= token may name: each fake/proxy, and each of its routes as <name>.<route>."""
    out = []
    for e in (m.get("fakes") or []) + (m.get("proxies") or []):
        out.append(e["name"])
        out += ["%s.%s" % (e["name"], r["name"]) for r in e.get("routes") or []]
    return out


def world_config(m):
    """/etc/hydo/world.json: what hydo-world serves (hvx/onboard/world/config.go)."""
    svcs = {s["name"]: s for s in m["services"]}
    cfg = {"log": "/tmp/hydo/world.log", "sock": "/tmp/hydo/world.sock", "fakes": [], "proxies": []}
    for kind in ("fakes", "proxies"):
        for e in m.get(kind) or []:
            c = {k: e[k] for k in ("name", "port", "protocol", "idempotency", "ref") if k in e}
            c["addr"] = str(e.get("addr", "127.0.0.1"))
            if kind == "proxies":
                if "service" in e:
                    t = svcs[e["service"]]
                    c["to"] = "%s:%d" % (t.get("addr", "127.0.0.1"), t["port"])
                else:
                    c["to"] = str(e["to"])
            c["routes"] = []
            for r in e.get("routes") or []:
                d = {k: r[k] for k in ("name", "method", "path", "status", "code", "headers", "body", "message",
                                       "ref", "effect", "idempotent") if k in r}
                if r.get("webhook") is not None:
                    d["webhook"] = {k: r["webhook"][k] for k in KNOWN_HOOK - {"description"} if k in r["webhook"]}
                c["routes"].append(d)
            cfg[kind].append(c)
    return json.dumps(cfg, indent=1, sort_keys=True) + "\n"
def has_buggify(m):
    """buggify: true -- the project's programs carry SDK fault points; the init turns the
    schedule token B= into /tmp/hydo-buggify (hydo-init-buggify.sh)."""
    return m.get("buggify") is True




def service_order(svcs):
    """Manifest order, moved only as much as depends_on requires (stable topological sort)."""
    names = [s["name"] for s in svcs]
    deps = {s["name"]: list(s.get("depends_on") or []) for s in svcs}
    out, temp = [], set()

    def visit(n):
        if n in out:
            return
        if n in temp:
            raise ManifestError("services: depends_on has a cycle through %r" % n)
        temp.add(n)
        for d in deps[n]:
            visit(d)
        temp.discard(n)
        out.append(n)
    for n in names:
        visit(n)
    return out


# ------------------------------------------------------------------ manifest -> shell
def shq(s):
    return "'" + str(s).replace("'", "'\\''") + "'"


def compile_shell(m, tc_path, fc=None):
    svcs = {s["name"]: s for s in m["services"]}
    order = service_order(m["services"])
    wl = m["workload"]
    L = ["# generated by hvx/onboard/hydo-build from hydo.yaml -- do not edit",
         "HYDO_NAME=%s" % shq(m["name"]),
         "HYDO_SERVICES=%s" % shq(" ".join(order)),
         "HYDO_STEPS=%d" % wl["steps"],
         "HYDO_WORKLOAD_RUN=%s" % shq(wl["run"]),
         "HYDO_WORKLOAD_RETRY=%s" % shq(wl.get("retry") or ""),
         "HYDO_WORKLOAD_PGREP=%s" % shq(wl.get("process") or os.path.basename(str(wl["run"]).split()[0])),
         "HYDO_WORKLOAD_TIMEOUT=%d" % int(wl.get("timeout", 300)),
         "HYDO_PROVISION=%s" % shq(m.get("provision") or ""),
         "HYDO_DATA_OPTS=%s" % shq((m.get("data") or {}).get("mount", "rw")),
         "HYDO_DATA_DIRS=%s" % shq(" ".join((m.get("data") or {}).get("dirs") or [])),
         "HYDO_CLOCK_START=%d" % int((m.get("guest") or {}).get("clock_start", 1767225600)),
         "HYDO_TC=%s" % shq(tc_path or "")]
    if "clock_after_cut" in (m.get("guest") or {}):     # only then: other manifests compile byte-identically
        L.append("HYDO_CLOCK_AFTER_CUT=%d" % int(m["guest"]["clock_after_cut"]))
    if fc:      # only then (faults: lists freeze): other manifests compile byte-identically
        L += ["HYDO_FC=%s" % shq(fc[0]), "HYDO_IPT=%s" % shq(fc[1])]
    if has_world(m):    # only then (fakes:/proxies:): other manifests compile byte-identically
        L += ["HYDO_WORLD=/bin/hydo-world", "HYDO_WORLD_TARGETS=%s" % shq(" ".join(world_targets(m)))]
    for n in order:
        s = svcs[n]
        L += ["HYDO_SVC_%s_cmd=%s" % (n, shq(s["cmd"])),
              "HYDO_SVC_%s_setup=%s" % (n, shq(s.get("setup") or "")),
              "HYDO_SVC_%s_ready=%s" % (n, shq(s["ready"])),
              "HYDO_SVC_%s_timeout=%d" % (n, int(s.get("ready_timeout", 120))),
              "HYDO_SVC_%s_port=%s" % (n, shq(s.get("port", ""))),
              "HYDO_SVC_%s_recovery=%d" % (n, 1 if s.get("recovery", True) else 0)]
        if "addr" in s:     # only then: manifests without addr: compile byte-identically
            L.append("HYDO_SVC_%s_addr=%s" % (n, shq(s["addr"])))
    inv_names = []
    for i, v in enumerate(m["invariants"]):
        k = "i%d" % i
        inv_names.append(k)
        every = v.get("every")
        final = v.get("final", every is None)
        L += ["HYDO_INV_%s_id=%s" % (k, shq(v["id"])),
              "HYDO_INV_%s_type=%s" % (k, shq(v.get("type", "always"))),
              "HYDO_INV_%s_msg=%s" % (k, shq(v.get("msg", v["id"]))),
              "HYDO_INV_%s_cmd=%s" % (k, shq(v["cmd"])),
              "HYDO_INV_%s_every=%s" % (k, shq(every or "")),
              "HYDO_INV_%s_final=%d" % (k, 1 if final else 0)]
        if v.get("type") == "eventually":      # only then: other manifests compile byte-identically
            L[-1] = "HYDO_INV_%s_final=0" % k
            L += ["HYDO_INV_%s_within=%d" % (k, v["within"]),
                  "HYDO_INV_%s_after=%s" % (k, shq(v.get("after", "heal"))),
                  "HYDO_INV_%s_poll=%d" % (k, v.get("poll", 1))]
    L.append("HYDO_INVARIANTS=%s" % shq(" ".join(inv_names)))
    for k in m.get("knobs") or []:
        t = k["token"]
        L += ["HYDO_KNOB_%s_default=%s" % (t, shq(k["default"])),
              "HYDO_KNOB_%s_set=%s" % (t, shq(k["set"])),
              "HYDO_KNOB_%s_name=%s" % (t, shq(k.get("name", t)))]
    if m.get("_compose"):   # the test composer (hydo_composer.py); only then: others compile unchanged
        L += _composer().shell_lines(m["_compose"])
    manifest_sh = "\n".join(L) + "\n"
    P = ["# generated by hvx/onboard/hydo-build: the project's env + shell helpers (hydo.yaml)",
         "export HOME=/tmp TZ=UTC LANG=C"]
    for k, v in (m.get("env") or {}).items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", str(k)):
            raise ManifestError("env: %r is not a valid variable name" % k)
        P.append("export %s=%s" % (k, shq(v)))
    if m.get("shell"):
        P.append(m["shell"].rstrip("\n"))
    prelude = "\n".join(P) + "\n"
    return manifest_sh, prelude


# ------------------------------------------------------------------ image building
LIVE_WRAP = ("step_range", "start_periodic", "start_all", "finish")
LIVE_MARK = "# ---------------------------------------------------------------- main\n"


FC_WRAP = ("set_knob", "step_range", "restart_dead", "stop_periodic")
FC_INIT = "hydo-init-freeze.sh"        # inserted into /sbin/init only for manifests whose faults: list freeze


def _fn_defs(text, fn):
    """Every definition of shell function fn in text: one-line `fn() { ...; }` or a block
    that ends with a `}` at the start of a line."""
    return [mo.group(0) for mo in re.finditer(r"^%s\(\) \{(?:[^\n]*\}\n|.*?^\}\n)" % fn, text, re.S | re.M)]


CLK_WRAP = ("failed_ids", "mount_data")
CLK_INIT = "hydo-init-clock.sh"         # inserted into /sbin/init only for manifests with guest.clock_after_cut
BG_WRAP = ("set_knob",)
BG_INIT = "hydo-init-buggify.sh"        # inserted only for manifests with buggify: true (schedule token B=)


def _splice(base, fns, prefix, ext, why):
    """Insert renamed copies <prefix><fn> of the definitions of fns now in force, then the
    extension file ext, just before the "main" marker."""
    i = base.find(LIVE_MARK)
    if i < 0:
        raise ManifestError("hydo-init.sh: the '# ---- main' section marker is missing (needed for %s)" % why)
    copies = []
    for fn in fns:
        defs = _fn_defs(base[:i], fn)
        if not defs:
            raise ManifestError("hydo-init.sh: function %s() not found (needed for %s)" % (fn, why))
        copies.append(prefix + defs[-1])
    txt = open(os.path.join(HERE, ext)).read()
    return base[:i] + "# copies of the init functions %s wraps\n" % ext + "".join(copies) + "\n" + txt + base[i:]


def init_text(m):
    """/sbin/init for manifest m: hydo-init.sh unchanged, or -- only when an invariant is of
    type eventually -- with hydo-liveness.sh and renamed copies of the functions it wraps
    inserted before the "main" section; likewise hydo-init-freeze.sh for faults: [.., freeze]."""
    base = open(os.path.join(HERE, "hydo-init.sh")).read()
    if has_links(m):    # services with addr: source the link-fault extension (hydo-init-links.sh)
        if base.count(LIVE_MARK) != 1:
            raise ManifestError("hydo-init.sh: the '# ---- main' section marker is missing (needed for addr:)")
        base = base.replace(LIVE_MARK, ". /etc/hydo/init-links.sh   # added by hydo-build: services with addr:\n" + LIVE_MARK)
    if any(v.get("type") == "eventually" for v in m["invariants"]):
        i = base.find(LIVE_MARK)
        if i < 0:
            raise ManifestError("hydo-init.sh: the '# ---- main' section marker is missing (needed for eventually invariants)")
        copies = []
        for fn in LIVE_WRAP:
            mo = re.search(r"^%s\(\) \{.*?^\}\n" % fn, base, re.S | re.M)
            if not mo:
                raise ManifestError("hydo-init.sh: function %s() not found (needed for eventually invariants)" % fn)
            copies.append("_live_orig_" + mo.group(0))
        live = open(os.path.join(HERE, "hydo-liveness.sh")).read()
        base = base[:i] + "# copies of the init functions hydo-liveness.sh wraps\n" + "".join(copies) + "\n" + live + base[i:]
    if "clock_after_cut" in (m.get("guest") or {}):
        base = _splice(base, CLK_WRAP, "_clk_orig_", CLK_INIT, "guest.clock_after_cut")
    if has_freeze(m):
        i = base.find(LIVE_MARK)
        if i < 0:
            raise ManifestError("hydo-init.sh: the '# ---- main' section marker is missing (needed for faults: freeze)")
        copies = []
        for fn in FC_WRAP:      # the definition in force at this point (liveness may wrap step_range)
            defs = _fn_defs(base[:i], fn)
            if not defs:
                raise ManifestError("hydo-init.sh: function %s() not found (needed for faults: freeze)" % fn)
            copies.append("_fc_orig_" + defs[-1])
        fz = open(os.path.join(HERE, FC_INIT)).read()
        base = base[:i] + "# copies of the init functions hydo-init-freeze.sh wraps\n" + "".join(copies) + "\n" + fz + base[i:]
    if has_buggify(m):
        base = _splice(base, BG_WRAP, "_bg_orig_", BG_INIT, "buggify: true")
    if has_world(m):    # fakes:/proxies: (hydo-init-fakes.sh), after every other extension
        base = _splice(base, PF_WRAP, "_pf_orig_", WORLD_INIT, "fakes:/proxies:")
    return base


def install_init(m, dst):
    if any(v.get("type") == "eventually" for v in m["invariants"]) or has_links(m) or has_freeze(m) or \
       "clock_after_cut" in (m.get("guest") or {}) or has_buggify(m) or has_world(m):
        with open(dst, "w") as f:
            f.write(init_text(m))
    else:
        shutil.copy(os.path.join(HERE, "hydo-init.sh"), dst)
    if has_links(m):
        shutil.copy(os.path.join(HERE, LINKS_INIT), os.path.join(os.path.dirname(os.path.dirname(dst)), "etc/hydo/init-links.sh"))
    os.chmod(dst, 0o755)


def tool(env, default, check):
    p = os.environ.get(env) or default
    if not check(p):
        raise SystemExit("hydo-build: %s not found at %s (set %s)" % (env, p, env))
    return p


def closure(path):
    out = subprocess.run(["nix-store", "-qR", path], check=True, stdout=subprocess.PIPE, text=True).stdout.split()
    return sorted(out)


def copy_into(src, dst):
    if os.path.isdir(src) and not os.path.islink(src):
        shutil.copytree(src, dst, symlinks=True, dirs_exist_ok=True)
    else:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if os.path.lexists(dst):
            os.chmod(dst, 0o755) if not os.path.islink(dst) else None
            os.unlink(dst)
        shutil.copy2(src, dst, follow_symlinks=False)


def uuid_from(name, salt):
    h = hashlib.sha256(("hydo-onboard:%s:%s" % (name, salt)).encode()).hexdigest()
    return "%s-%s-%s-%s-%s" % (h[0:8], h[8:12], h[12:16], h[16:20], h[20:32])


def zero_times(path, all_inode_times):
    """Zero every superblock time (primary + backups) and inode time mke2fs stamped (same
    fields as build-stack.sh's passes: the faked clock advances, so a build crossing a
    second boundary would otherwise differ)."""
    with open(path, "r+b") as f:
        mm = mmap.mmap(f.fileno(), 0)
        u16 = lambda o: struct.unpack_from("<H", mm, o)[0]
        u32 = lambda o: struct.unpack_from("<I", mm, o)[0]
        sb = 1024
        inodes = u32(sb + 0x00); bs = 1024 << u32(sb + 0x18)
        ipg = u32(sb + 0x28); isize = u16(sb + 0x58) or 128
        bpg = u32(sb + 0x20)
        gdtb = 2 if bs == 1024 else 1
        ng = (inodes + ipg - 1) // ipg
        for g in range(ng):
            o = sb if g == 0 else g * bpg * bs + (1024 if bs == 1024 else 0)
            if o + 0x3A <= len(mm) and u16(o + 0x38) == 0xEF53:
                for t in (0x2C, 0x30, 0x40, 0x108):
                    struct.pack_into("<I", mm, o + t, 0)
        for g in range(ng):
            itbl = u32(gdtb * bs + g * 32 + 0x08)
            for i in range(ipg):
                if g * ipg + i >= inodes:
                    break
                io = itbl * bs + i * isize
                # root: atime (mke2fs -d reading a source file can bump it under relatime),
                # ctime and dtime; mtime keeps the fixed source mtime. data disk: all four.
                fields = (0x08, 0x0C, 0x10, 0x14) if all_inode_times else (0x08, 0x0C, 0x14)
                for o in fields:
                    struct.pack_into("<I", mm, io + o, 0)
                if isize > 128:
                    for o in (0x84, 0x88, 0x8C, 0x90, 0x94):
                        struct.pack_into("<I", mm, io + o, 0)
        mm.flush(); mm.close()


def mkfs(T, out, mib, uuid, seed, src=None, journal=False):
    with open(out, "wb") as f:
        f.truncate(mib * 1024 * 1024)
    feats = "^metadata_csum,^64bit,^flex_bg,^resize_inode" + (",has_journal" if journal else "")
    cmd = [T["faketime"], FAKE_TS, T["mke2fs"], "-q", "-F", "-t", "ext4", "-b", "4096", "-O", feats]
    if journal:
        cmd += ["-J", "size=16"]
    cmd += ["-U", uuid, "-E", "hash_seed=%s,lazy_itable_init=0,lazy_journal_init=0" % seed]
    if src:
        cmd += ["-d", src]
    cmd.append(out)
    subprocess.run(cmd, check=True, env=faketime_env(SOURCE_DATE_EPOCH=str(FIXED_MTIME)))


def write_mbr(img, parts):
    mbr = bytearray(512)
    mbr[0x1B8:0x1BC] = b"\x0b\xd0\xea\x1d"
    for k, (lba, n) in enumerate(parts):
        off = 0x1BE + 16 * k
        mbr[off] = 0
        mbr[off + 1:off + 4] = b"\xfe\xff\xff"
        mbr[off + 4] = 0x83
        mbr[off + 5:off + 8] = b"\xfe\xff\xff"
        struct.pack_into("<I", mbr, off + 8, lba)
        struct.pack_into("<I", mbr, off + 12, n)
    mbr[0x1FE] = 0x55; mbr[0x1FF] = 0xAA
    with open(img, "r+b") as f:
        f.write(mbr)


def fix_mtimes(root):
    for dp, dns, fns in os.walk(root):
        for n in dns + fns:
            os.utime(os.path.join(dp, n), (FIXED_MTIME, FIXED_MTIME), follow_symlinks=False)
    os.utime(root, (FIXED_MTIME, FIXED_MTIME))


def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def build(m, manifest_path, out, bdir, params=None, oci=None):
    T = {
        "busybox": tool("HYDO_BUSYBOX", "/nix/store/ahw5fkq085k5ppdsylyd475xlxb18pz1-busybox-static-x86_64-unknown-linux-musl-1.37.0/bin/busybox", os.path.isfile),
        "seedrng": tool("HYDO_SEEDRNG", os.path.join(bdir, "hvx_seedrng"), os.path.isfile),
        "mke2fs": tool("HYDO_MKE2FS", "/nix/store/24s0phlx9kly7x7qb8gal3mmn51ndmlx-e2fsprogs-1.47.0-bin/bin/mke2fs", os.path.isfile),
        "faketime": tool("HYDO_FAKETIME", "/nix/store/fs0gp7zyfjnbvaq82yvwbcsvqh7876d1-libfaketime-0.9.10/bin/faketime", os.path.isfile),
    }
    faults = set(m.get("faults") or DEFAULT_FAULT_KINDS)
    want_tc = bool(faults & {"network", "oneway"})
    iproute2 = None
    if want_tc:
        iproute2 = tool("HYDO_IPROUTE2", "/nix/store/dx4fsbxs5v82l9lzmjkpkhx5ygqcwm69-iproute2-6.8.0", lambda p: os.path.isfile(p + "/bin/tc"))
        modroot = tool("HYDO_MODROOT", "/run/current-system/kernel-modules/lib/modules/6.6.35", os.path.isdir)
    iptables = None
    if "freeze" in faults:      # F= (hydo-init-freeze.sh): iptables-legacy + the static helper hydo_fc
        iptables = tool("HYDO_IPTABLES", "/nix/store/xnrrq638db6170pg7dvz84f8nr1q2wvi-iptables-1.8.10",
                        lambda p: os.path.isfile(p + "/bin/xtables-legacy-multi"))
        T["fc"] = tool("HYDO_FCBIN", os.path.join(bdir, "hydo_fc"), os.path.isfile)
        modroot = tool("HYDO_MODROOT", "/run/current-system/kernel-modules/lib/modules/6.6.35", os.path.isdir)
    if has_world(m):    # fakes:/proxies: -> the prebuilt static hydo-world (hvx/onboard/world/build.sh)
        T["world"] = tool("HYDO_WORLDBIN", os.path.join(bdir, "hydo-world"), os.path.isfile)
    mdir = os.path.dirname(os.path.abspath(manifest_path))
    root = m.get("root") or {}
    R = os.path.join(bdir, "%s-root" % out)
    # the store closures are big and immutable: stage once, reuse; everything else fresh
    store = sorted(set(p for n in (root.get("nix") or []) + ([iproute2] if iproute2 else []) + ([iptables] if iptables else [])
                       for p in closure(n)))
    stamp = os.path.join(bdir, "%s-root.closures" % out)
    if os.path.isdir(R) and os.path.exists(stamp) and open(stamp).read() == "\n".join(store):
        print("hydo-build: reusing the staged closures in %s" % R)
        for d in os.listdir(R):
            if d != "nix":
                p = os.path.join(R, d)
                subprocess.run(["chmod", "-R", "u+w", p], check=False)
                shutil.rmtree(p) if os.path.isdir(p) and not os.path.islink(p) else os.unlink(p)
    else:
        if os.path.isdir(R):
            subprocess.run(["chmod", "-R", "u+w", R], check=False)
            shutil.rmtree(R)
        os.makedirs(os.path.join(R, "nix/store"))
        for p in store:
            subprocess.run(["cp", "-a", p, os.path.join(R, "nix/store/")], check=True)
        with open(stamp, "w") as f:
            f.write("\n".join(store))
        print("hydo-build: staged %d store paths" % len(store))
    for d in ["bin", "sbin", "proc", "sys", "dev", "data", "tmp", "etc/hydo", "lib/modules"] + [d.lstrip("/") for d in root.get("dirs") or []]:
        os.makedirs(os.path.join(R, d), exist_ok=True)
    shutil.copy(T["busybox"], os.path.join(R, "bin/busybox"))
    shutil.copy(T["seedrng"], os.path.join(R, "bin/hvx_seedrng"))
    for b in ("bin/busybox", "bin/hvx_seedrng"):
        os.chmod(os.path.join(R, b), 0o755)
    # busybox applets the project's commands may call by name (sh, grep, ...)
    applets = subprocess.run([T["busybox"], "--list"], stdout=subprocess.PIPE, text=True, check=True).stdout.split()
    for a in applets:
        p = os.path.join(R, "bin", a)
        if not os.path.lexists(p):
            os.symlink("busybox", p)
    if iptables:
        shutil.copy(T["fc"], os.path.join(R, "bin/hydo_fc"))
        os.chmod(os.path.join(R, "bin/hydo_fc"), 0o755)
    if "world" in T:
        shutil.copy(T["world"], os.path.join(R, "bin/hydo-world"))
        os.chmod(os.path.join(R, "bin/hydo-world"), 0o755)
        with open(os.path.join(R, "etc/hydo/world.json"), "w") as f:
            f.write(world_config(m))
    for mod in (NETMODS if want_tc else []) + (FCMODS if iptables else []):
        src = subprocess.run(["find", modroot, "-name", mod + ".ko.xz"], stdout=subprocess.PIPE, text=True).stdout.split()
        if not src:
            raise SystemExit("hydo-build: kernel module %s.ko.xz not under %s" % (mod, modroot))
        with open(os.path.join(R, "lib/modules", mod + ".ko"), "wb") as f:
            subprocess.run(["xz", "-dc", sorted(src)[0]], stdout=f, check=True)
    for e in root.get("files") or []:
        if not isinstance(e, dict) or "src" not in e or "dst" not in e:
            raise ManifestError("root.files: each entry needs src and dst")
        src = os.path.expanduser(str(e["src"]))
        if not os.path.isabs(src):
            src = os.path.join(mdir, src)
        if not os.path.exists(src):
            raise ManifestError("root.files: %s does not exist" % src)
        dst = os.path.join(R, str(e["dst"]).lstrip("/"))
        copy_into(src, dst)
        if "mode" in e:
            os.chmod(dst, int(str(e["mode"]), 8))
    for dst, content in (root.get("text") or {}).items():
        p = os.path.join(R, str(dst).lstrip("/"))
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f:
            f.write(content)
    for name, content in (("etc/hosts", "127.0.0.1 localhost\n"), ("etc/passwd", "root:x:0:0:root:/tmp:/bin/sh\n"),
                          ("etc/group", "root:x:0:\n")):
        p = os.path.join(R, name)
        if not os.path.exists(p):
            with open(p, "w") as f:
                f.write(content)
    manifest_sh, prelude = compile_shell(m, (iproute2 + "/bin/tc") if iproute2 else "",
                                         ("/bin/hydo_fc", iptables + "/bin/iptables-legacy") if iptables else None)
    with open(os.path.join(R, "etc/hydo/manifest.sh"), "w") as f:
        f.write(manifest_sh)
    with open(os.path.join(R, "etc/hydo/prelude.sh"), "w") as f:
        f.write(prelude)
    shutil.copy(manifest_path, os.path.join(R, "etc/hydo/hydo.yaml"))
    if params:      # the parameter values this image was built with (only when declared)
        with open(os.path.join(R, "etc/hydo/params"), "w") as f:
            f.write("".join("%s=%s\n" % kv for kv in sorted(params.items())))
    install_init(m, os.path.join(R, "sbin/init"))
    _compose_stage(m, R)
    oci_meta = _oci_stage(oci, R, T["busybox"], bdir, out)
    fix_mtimes(R)

    ext4, data, disk = (os.path.join(bdir, "%s-%s.img" % (out, k)) for k in ("ext4", "data", "disk"))
    rmib = int(root.get("size_mib", 0)) or None
    if rmib is None:
        used = int(subprocess.run(["du", "-sm", R], stdout=subprocess.PIPE, text=True).stdout.split()[0])
        rmib = max(64, (used * 13 // 10 + 63) // 64 * 64)
    mkfs(T, ext4, rmib, uuid_from(m["name"], "root"), uuid_from(m["name"], "root-hash"), src=R)
    if oci_meta:
        import hydo_oci
        hydo_oci.fix_ext4(oci_meta, T, ext4, FAKE_TS, env=faketime_env())
    zero_times(ext4, all_inode_times=False)
    dmib = int((m.get("data") or {}).get("size_mib", 512))
    mkfs(T, data, dmib, uuid_from(m["name"], "data"), uuid_from(m["name"], "data-hash"), journal=True)
    zero_times(data, all_inode_times=True)
    p1, n1 = 2048, rmib * 2048
    p2, n2 = p1 + n1, dmib * 2048
    with open(disk, "wb") as f:
        f.truncate((p2 + n2) * 512)
    write_mbr(disk, [(p1, n1), (p2, n2)])
    with open(disk, "r+b") as fo:
        for img, lba in ((ext4, p1), (data, p2)):
            fo.seek(lba * 512)
            with open(img, "rb") as fi:
                shutil.copyfileobj(fi, fo, 1 << 20)
    print("hydo-build: %s (root %d MiB, data %d MiB)" % (disk, rmib, dmib))
    for p in (ext4, data, disk):
        print("  sha256(%s)=%s" % (os.path.basename(p), sha(p)))



# Build a second copy of the hvx module as hvxsmp.ko with the device /dev/hvxsmp, so the
# in-kernel vCPU scheduler (HVX_VM_SMP_SCHED) can be developed next to hvx.ko without
# disturbing runs on /dev/hvx. hvxsmp.c is a copy of ../hvx.c made by build-hvxsmp.sh.
obj-m := hvxsmp.o
ccflags-y := -DHVX_DEVNAME='"hvxsmp"'
OBJECT_FILES_NON_STANDARD_hvxsmp.o := y

KDIR ?= /lib/modules/$(shell uname -r)/build
PWD  := $(shell pwd)

all:
	$(MAKE) -C $(KDIR) M=$(PWD) modules

clean:
	$(MAKE) -C $(KDIR) M=$(PWD) clean

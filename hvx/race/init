#!/bin/busybox sh
# Calibration-race guest: run hydorace with W,OUT,SEATS from hydo_race= on the
# kernel command line, print its result line, then a stop marker for the host.
/bin/busybox --install -s /bin
mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
P=$(sed -n 's/.*hydo_race=\([0-9,]*\).*/\1/p' /proc/cmdline)
[ -n "$P" ] || P=10,50000,5000
set -- $(echo "$P" | tr , ' ')
/bin/hydorace "$1" "$2" "$3"
echo "hydo-race-done"
exec /bin/busybox sh

#!/bin/sh
# faketime "<YYYY-mm-dd HH:MM:SS>" <bundled program> [args...]
# Runs one of the release's bundled Nix-built host tools (tools/bin: mke2fs, debugfs) with the
# bundled glibc loader and libraries, and libfaketime preloaded with the clock FROZEN at the
# given time (FAKETIME without '@'). hydo-build calls it as its HYDO_FAKETIME, the way it calls
# the pinned faketime on the Nix build box; no /nix/store is needed on this machine.
T=$(cd "$(dirname "$0")/../tools" && pwd)
ts=$1; shift
prog=$1; shift
# MKE2FS_CONFIG names a file that does not exist, so mke2fs uses its built-in defaults (as on the
# Nix build box, which has no /etc/mke2fs.conf) instead of this machine's /etc/mke2fs.conf, whose
# feature list and size classes differ between distributions and would change the image bytes.
# TZ=UTC-4 (POSIX notation for UTC+4): libfaketime reads the given time in the local time zone.
# hydo-build's FAKE_TS "2020-09-13 16:26:40" is its FIXED_MTIME 1600000000 only in UTC+4, the
# zone of the Nix build box that made every recorded image; without this a machine in another
# zone stamps the root image's lost+found and root-directory mtimes hours apart.
exec env FAKETIME="$ts" TZ=UTC-4 MKE2FS_CONFIG="$T/no-mke2fs.conf" "$T/lib/ld-linux-x86-64.so.2" --library-path "$T/lib" \
     --preload "$T/lib/libfaketime.so.1" --argv0 "$(basename "$prog")" "$prog" "$@"

#!/usr/bin/env python3
"""hydo -- deterministic fault testing on an x86_64 Linux machine with VT-x (the hvx backend).

    hydo init    [--dir DIR] [--name NAME]         start a repository's hydo/ folder and its AGENTS.md section
    hydo guide   [TOPIC | --list]                  print the onboarding guide for any AI tool (the skill's SKILL.md)
    hydo skill   install --agent claude|codex|cursor|copilot|gemini|all [--user] | --to DIR
                                                   copy the onboarding skill where an AI tool reads skills
    hydo doctor                                    check this machine and the installation
    hydo module build|load|unload|status [--name NAME] [--dry-run]
                                                   build and (un)load the hvx kernel module
    hydo module udev install|remove|status [--name NAME] [--group GROUP] [--dry-run]
                                                   optional: give /dev/hvx to a group, so runs need no sudo
    hydo compose <docker-compose.yaml> [--out hydo.yaml] [hydo-compose options]
                                                   start a hydo.yaml from a Compose file (MANIFEST.md)
    hydo build   <hydo.yaml> [--out DIR] [--set KEY=VALUE ...]
                                                   compile the manifest into a guest disk image
    hydo run     [IMG] "<schedule>" [--image IMG]  run one schedule from a fresh boot
    hydo repro   <run dir | explore dir | "<schedule>"> [--image IMG]
                                                   run again and compare the fingerprints
    hydo repro   --regressions [IMG]               replay the plan's saved regressions (hydo/regressions/)
    hydo save    <explore dir> [--to hydo/regressions]
                                                   save the minimal schedules of an exploration as regressions
    hydo explore [IMG] [--seeds 1-20] [--strategy random|swarm|process|...] [--workers N]
                 [--out DIR] [any other explore.py option]
                                                   generate, run, re-run and shrink schedules
    hydo report  [DIR]                             print the report of the last (or a given) exploration
    hydo errors  list [DIR] | accept SIG... --reason TEXT [--with F] [--during F] | check
                                                   error logs as findings: list new error kinds, accept
                                                   expected ones into hydo/known-errors.yaml (MANIFEST.md)

IMG defaults to the one *-disk.img in ./hydo-out, or in ./.hydo for a project whose manifest is
hydo/hydo.yaml (the agreed repository layout; `hydo build` with no manifest uses ./hydo/hydo.yaml).
Runs open /dev/hvx ($HVX_DEV) while holding the shared module lock; `hydo module load/unload` take it
exclusively, so a reload never pulls the module from under a running VM. The lock file is
$HYDO_LOCK (default ~/.hvx-module.lock). A run uses sudo only when you cannot open the device
yourself (see `hydo module udev`; HYDO_SUDO=1 forces sudo). Plain Python 3.9+, no packages.
"""
import getpass, glob, grp, hashlib, importlib.machinery, importlib.util, json, os, platform, pwd, re, shutil, \
    subprocess, sys, tempfile, time, types

R = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))     # the release root
HVX = os.path.join(R, "hvx")
ONBOARD = os.path.join(HVX, "onboard")
EXPLORE = os.path.join(HVX, "explore")
ENGINE = os.path.join(HVX, "hvx_explore")
GUEST = os.path.join(R, "guest")
TOOLS = os.path.join(R, "tools")
LIBEXEC = os.path.join(R, "libexec")
MODSRC = os.path.join(R, "module")
BZIMAGE = os.path.join(GUEST, "bzImage")
INITRD = os.path.join(GUEST, "initramfs-kafka.cpio.gz")
STORE = os.path.join(GUEST, "store")               # nix/store/<path>: the guest-side closures (tc, iptables),
CLOSURES = os.path.join(GUEST, "store-closures.txt")  # unpacked from guest/store.tar by install.sh
OUT = "hydo-out"
PROJECT_OUT = ".hydo"                               # the build cache of a project in the hydo/ folder layout
BASE_LOCK = os.environ.get("HYDO_LOCK") or os.path.expanduser("~/.hvx-module.lock")
DEV = os.environ.get("HVX_DEV") or "/dev/hvx"     # the device runs open (another name: a side module)
DEVNAME = os.path.basename(DEV)
UDEV_DIR = "/etc/udev/rules.d"


def module_lock(name):
    """The main module shares the run lock; a side module (--name) gets its own lock file."""
    return BASE_LOCK if name == "hvx" else "%s.%s" % (BASE_LOCK, name)


LOCK = module_lock(DEVNAME)                       # the lock a run on DEV holds (shared)


def dev_usable(dev=DEV):
    """True when this user can read and write the device without sudo (what libexec/hvx-run
    tests before it drops sudo), False when not, None when the device does not exist."""
    if not os.path.exists(dev):
        return None
    return os.access(dev, os.R_OK | os.W_OK)


def uses_sudo():
    return os.environ.get("HYDO_SUDO") == "1" or not dev_usable()


def snap_dir():
    """Where runs keep their snapshots. A run without sudo cannot write into a /var/tmp/hvx-snap
    that earlier sudo runs created (root, mode 0700); it then uses /var/tmp/hvx-snap-<uid>.
    The directory does not affect any result."""
    d = os.environ.get("HYDO_SNAP_DIR")
    if d:
        return d
    d = "/var/tmp/hvx-snap"
    if not uses_sudo() and os.path.isdir(d) and not os.access(d, os.W_OK | os.X_OK):
        d = "/var/tmp/hvx-snap-%d" % os.getuid()
    return d


SNAP_DIR = snap_dir()


def die(msg, rc=1):
    print("hydo: " + msg, file=sys.stderr)
    sys.exit(rc)


def take(args, flag, default=None):
    """Remove `flag VALUE` from args and return VALUE (or default)."""
    if flag in args:
        i = args.index(flag)
        if i + 1 >= len(args):
            die("%s needs a value" % flag)
        v = args[i + 1]
        del args[i:i + 2]
        return v
    return default


def tool_env():
    """The environment every hydo subprocess gets: the bundled debugfs first on PATH (explore.py
    and manifest_space.py read the manifest out of an image with it), and the release paths for
    explore.py (HYDO_BUILD: kernel + initramfs; HYDO_HVX_RUN: the shared-lock wrapper)."""
    env = dict(os.environ)
    env["PATH"] = os.path.join(LIBEXEC, "bin") + os.pathsep + env.get("PATH", "")
    env["HYDO_BUILD"] = GUEST
    env["HYDO_HVX_RUN"] = os.path.join(LIBEXEC, "hvx-run")
    env["HYDO_LOCK"] = LOCK
    env["HYDO_SNAP_DIR"] = SNAP_DIR
    if DEV != "/dev/hvx":
        env["HVX_DEV"] = DEV           # hvx_explore opens $HVX_DEV; hvx-run passes it through sudo
    env["HYDO_CLI"] = "1"
    return env


# ---------------------------------------------------------------- build
def load_hydo_build():
    loader = importlib.machinery.SourceFileLoader("hydo_build", os.path.join(ONBOARD, "hydo-build"))
    spec = importlib.util.spec_from_loader("hydo_build", loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


def use_bundled_store(hb):
    """hydo-build copies the guest-side Nix closures (tc from iproute2, iptables-legacy for the
    freeze fault) from the host's /nix/store with `nix-store -qR`. The release ships exactly those
    closures under guest/store/nix/store/ (guest/store-closures.txt lists them). Point
    hydo-build's own view of os.path (only for /nix/store paths the host does not have) and its
    closure() at that tree: the image gets the same paths, bytes and modes as a build on the Nix
    build box. A path that is not bundled (a manifest's root.nix:) still needs nix-store here."""
    closures = {}
    for line in open(CLOSURES):
        if line.strip():
            root, member = line.split()
            closures.setdefault(root, []).append(member)
    here = lambda p: os.path.join(STORE, p.lstrip("/"))
    bundled = lambda p: str(p).startswith("/nix/store/") and not os.path.lexists(p) and os.path.lexists(here(p))
    path = types.ModuleType("os.path")
    path.__dict__.update(os.path.__dict__)
    for fn in ("isfile", "isdir", "exists", "lexists"):
        real = getattr(os.path, fn)
        setattr(path, fn, (lambda real: lambda p: real(here(p)) if bundled(p) else real(p))(real))
    shim = types.ModuleType("os")
    shim.__dict__.update(os.__dict__)
    shim.path = path
    hb.os = shim                                    # only hydo-build's own view of os
    real_closure = hb.closure

    def closure(p):
        if p in closures and not os.path.exists(p):
            return sorted(here(x) for x in closures[p])     # `cp -a <bundle>/nix/store/X R/nix/store/`
        if shutil.which("nix-store"):
            return real_closure(p)
        raise hb.ManifestError("%s: not in the release's bundled closures, and this machine has no "
                               "nix-store (root.nix: needs Nix; list the files under root.files: instead)" % p)
    hb.closure = closure


def own_by_root(hb):
    """mke2fs -d records each source file's owner, i.e. the uid/gid of whoever ran the build, so
    two people building one manifest would get different images (and different fingerprints).
    After hydo-build's mkfs of the root, set every inode's owner to 0:0 with the bundled debugfs,
    under the same frozen clock (the hydo_oci.fix_ext4 pattern). HYDO_KEEP_OWNERS=1 skips it
    (then the image matches a plain hydo-build run by the same user on the Nix build box)."""
    orig = hb.mkfs

    def mkfs(T, out, mib, uuid, seed, src=None, journal=False):
        orig(T, out, mib, uuid, seed, src=src, journal=journal)
        if not src or os.environ.get("HYDO_KEEP_OWNERS"):
            return
        paths = [src]
        for d, dirs, files in os.walk(src):
            dirs.sort()
            paths += [os.path.join(d, n) for n in sorted(dirs + files)]
        lines = []
        for p in paths:
            st = os.lstat(p)
            if st.st_uid == 0 and st.st_gid == 0:
                continue
            g = "/" + os.path.relpath(p, src) if p != src else "/"
            if '"' in g or "\n" in g:
                raise hb.ManifestError("root: a file name with a quote or newline (%r) cannot be re-owned" % g)
            lines += ['sif "%s" uid 0' % g, 'sif "%s" gid 0' % g]
        if not lines:
            return
        dbg = os.path.join(os.path.dirname(T["mke2fs"]), "debugfs")
        cmdf = out + ".owners"
        with open(cmdf, "w") as f:
            f.write("\n".join(lines) + "\n")
        r = subprocess.run([T["faketime"], hb.FAKE_TS, dbg, "-w", "-f", cmdf, out], env=hb.faketime_env(),
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        errs = [x for x in r.stderr.splitlines() if x.strip() and not x.startswith("debugfs ")]
        os.unlink(cmdf)
        if r.returncode != 0 or errs:
            die("setting the root image's owners to root failed:\n  " + "\n  ".join(errs[:10]))
    hb.mkfs = mkfs


def project_out(manifest):
    """Where `hydo build` writes: ./.hydo for a manifest in a hydo/ folder (the repository
    layout: hydo/ holds the plan, .hydo/ the git-ignored build cache), else ./hydo-out."""
    return PROJECT_OUT if os.path.basename(os.path.dirname(os.path.abspath(manifest))) == "hydo" else OUT


def cmd_compose(argv):
    """hydo compose: hvx/onboard/hydo_compose.py (the Compose importer), unchanged."""
    if not argv or argv[0] in ("-h", "--help"):
        die("usage: hydo compose <docker-compose.yaml> [--out hydo.yaml] [--images-dir DIR] [--env-file F] "
            "[--profile P] [--use-env] [--no-resolve] [--lock FILE]")
    sys.path.insert(0, ONBOARD)
    import hydo_compose
    return hydo_compose.main(list(argv))


def cmd_build(argv):
    if (not argv or argv[0].startswith("-")) and os.path.isfile(os.path.join("hydo", "hydo.yaml")):
        argv = [os.path.join("hydo", "hydo.yaml")] + list(argv)
    if not argv or argv[0].startswith("-"):
        die("usage: hydo build <hydo.yaml> [--out DIR] [--set KEY=VALUE ...]   (no manifest: ./hydo/hydo.yaml)")
    manifest, rest = argv[0], list(argv[1:])
    out = take(rest, "--out", project_out(manifest))
    if "--arch" in rest:
        die("this is the x86_64 Linux release; arm64 images are built with the Mac release")
    T = {   # the bundled host tools (hydo-build's own defaults are /nix/store paths)
        "HYDO_BUSYBOX": os.path.join(GUEST, "busybox"),
        "HYDO_SEEDRNG": os.path.join(GUEST, "hvx_seedrng"),
        "HYDO_FCBIN": os.path.join(GUEST, "hydo_fc"),
        "HYDO_MKE2FS": os.path.join(TOOLS, "bin", "mke2fs"),     # run by libexec/faketime with the bundled loader
        "HYDO_FAKETIME": os.path.join(LIBEXEC, "faketime"),
        "HYDO_MODROOT": os.path.join(GUEST, "modules"),
    }
    for k, v in T.items():
        os.environ.setdefault(k, v)
    os.umask(0o022)     # the staged root's new directories and text files get the same modes for everyone
    os.environ["PATH"] = tool_env()["PATH"]
    sys.path.insert(0, ONBOARD)
    hb = load_hydo_build()
    use_bundled_store(hb)
    own_by_root(hb)
    sys.argv = ["hydo-build", manifest, "--build-dir", out] + rest
    rc = hb.main()
    if rc == 0 and not any(f in rest for f in ("--check", "--print-shell", "--print-init")):
        print("hydo: next:  hydo run \"disk=none | run\"     or     hydo explore --seeds 1-20")
    return rc


# ---------------------------------------------------------------- run / repro
def find_image(args):
    """--image IMG, or a leading positional *.img, or the one *-disk.img in ./hydo-out."""
    img = take(args, "--image")
    if img is None and args and args[0].endswith(".img"):
        img = args.pop(0)
    if img is None:
        imgs = sorted(glob.glob(os.path.join(OUT, "*-disk.img")))
        if not imgs:
            imgs = sorted(glob.glob(os.path.join(PROJECT_OUT, "*-disk.img")))
        if len(imgs) != 1:
            die("no image given and %d *-disk.img in ./%s or ./%s (run `hydo build hydo.yaml` here, or pass --image)" % (
                len(imgs), OUT, PROJECT_OUT))
        img = imgs[0]
    if not os.path.isfile(img):
        die("no such image: %s" % img)
    return os.path.abspath(img)


def engine_args_for(image, ram=None, cpu=None, vcpus=None):
    """The engine options explore.py would pass for this image: guest RAM and CPU level from the
    manifest embedded in the image (only when not the defaults), so a hand run matches."""
    if ram is None or cpu is None:
        sys.path.insert(0, EXPLORE)
        os.environ["PATH"] = tool_env()["PATH"]
        import manifest_space
        try:
            g = manifest_space.load(image_path=image).m.get("guest") or {}
        except SystemExit:
            g = {}
        ram = g.get("ram_mib", 1024) if ram is None else ram
        cpu = g.get("cpu", "v2") if cpu is None else cpu
    a = [] if int(ram) == 1024 else ["--ram-mib", str(ram)]
    if vcpus and int(vcpus) > 1:
        a += ["--vcpus", str(vcpus)]
    if cpu == "v3":
        a += ["--cpu", "v3"]
    return a


RESULT_RE = re.compile(r"RESULT (\S+) fp=(\S+) wfp=(\S+) secs=(\S+)((?: \S+?=\S+)*?) verdict=(.*)")


def run_one(image, sched, outdir, eargs, quiet=False):
    """One schedule from a fresh boot (hvx_explore one). Returns the parsed RESULT dict."""
    os.makedirs(outdir, exist_ok=True)
    if not os.access(ENGINE, os.X_OK):
        die("%s is not built (run install.sh again)" % ENGINE)
    # libexec/hvx-run drops the "sudo" when this user can open the device (hydo module udev)
    cmd = [os.path.join(LIBEXEC, "hvx-run"), "sudo", "env", "HVX_SNAP_DIR=" + SNAP_DIR, ENGINE] + eargs + \
          ["one", BZIMAGE, INITRD, image, os.path.abspath(outdir), sched]
    p = subprocess.run(cmd, env=tool_env(), stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    text = p.stdout.decode(errors="replace")
    with open(os.path.join(outdir, "engine.log"), "w") as f:
        f.write(text)
    for line in text.splitlines():
        m = RESULT_RE.match(line.strip())
        if m:
            if not quiet:
                print(line.strip())
            return {"fp": m.group(2), "wfp": m.group(3), "secs": float(m.group(4)), "verdict": m.group(6),
                    "line": line.strip()}
    sys.stderr.write(text[-3000:])
    die("the run produced no RESULT line (output above; full log in %s)" % os.path.join(outdir, "engine.log"))


def host_checks_one(outdir, res):
    """hvx/HISTORIES.md: a run whose console declares history checks (HYDO-CHECK lines) is
    checked here on the host: one.log (+ one.recovery.log) -> one.checks.log (HYDO-ASSERT
    records), one.checks.txt (explanations), and the combined verdict in res["verdict"]."""
    srcs = []
    for suffix in ("", ".recovery"):
        p = os.path.join(outdir, "one%s.log" % suffix)
        if os.path.exists(p):
            srcs.append(("one" + suffix, open(p, errors="replace").read()))
    if not any("HYDO-CHECK " in t for _, t in srcs):
        return res
    sys.path.insert(0, os.path.join(HVX, "history"))
    import hydohist
    r = hydohist.run_checks(srcs, res.get("verdict"))
    with open(os.path.join(outdir, "one.checks.log"), "w") as f:
        f.write("".join(x + "\n" for x in r["records"]))
    with open(os.path.join(outdir, "one.checks.txt"), "w") as f:
        f.write(r["report"] + "\n" + r["verdict"] + "\n")
    res["guest_verdict"], res["verdict"] = res.get("verdict"), r["verdict"]
    print("hydo: history checks: %s   (explanations in %s)" % (r["verdict"], os.path.join(outdir, "one.checks.txt")))
    return res


def errors_one(outdir, sched, res, known=None):
    """Error logs as findings (an image whose manifest has errors:): the run's error kinds against
    the known list (--known-errors FILE, else hydo/known-errors.yaml); one.errors.json."""
    sys.path.insert(0, ONBOARD)
    import hydo_errors
    return hydo_errors.for_run_dir(outdir, sched, res, known)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def new_run_dir():
    d = os.path.join(OUT, "runs", "run-%s-%d" % (time.strftime("%Y%m%d-%H%M%S"), os.getpid()))
    os.makedirs(d, exist_ok=True)
    return d


def cmd_run(argv):
    args = list(argv)
    outdir = take(args, "--out")
    known = take(args, "--known-errors")
    image = find_image(args)
    if len(args) != 1:
        die("usage: hydo run [IMG] \"<schedule>\" [--image IMG] [--out DIR]   e.g. hydo run \"disk=cut | run C=12 R=everysec\"")
    sched = args[0]
    outdir = outdir or new_run_dir()
    eargs = engine_args_for(image)
    res = errors_one(outdir, sched, host_checks_one(outdir, run_one(image, sched, outdir, eargs)), known)
    rec = {"image": image, "image_sha256": sha256(image), "schedule": sched, "engine_args": eargs, **res}
    with open(os.path.join(outdir, "run.json"), "w") as f:
        json.dump(rec, f, indent=1)
    print("hydo: run directory %s   (hydo repro %s  runs it again and compares fp=)" % (outdir, outdir))
    return 0


def repro_list(d):
    """[(label, image, schedule, recorded fp, engine args)] from a run dir or an explore dir."""
    if os.path.isfile(os.path.join(d, "run.json")):
        r = json.load(open(os.path.join(d, "run.json")))
        if r.get("image_sha256") and os.path.isfile(r["image"]) and sha256(r["image"]) != r["image_sha256"]:
            print("hydo: warning: %s changed since the run (sha256 differs); fingerprints will differ" % r["image"])
        return [("run", r["image"], r["schedule"], r["fp"], r["engine_args"])]
    rep = os.path.join(d, "report.json")
    if not os.path.isfile(rep):
        die("%s has neither run.json (hydo run) nor report.json (hydo explore)" % d)
    j = json.load(open(rep))
    s = j["summary"]
    image = s["image"]
    if not os.path.isabs(image):
        image = os.path.join(GUEST, image)
    eargs = engine_args_for(image, ram=s.get("ram_mib", 1024), cpu=s.get("cpu", "v2"), vcpus=s.get("vcpus", 1))
    out = [("seed %s" % f["seed"], image, f["schedule"], f["fp"], eargs) for f in j["failures"]]
    out += [("minimal %s" % x["signature"][:40], image, x["minimal"], x["fp_a"], eargs) for x in j.get("shrunk", [])]
    return out


def cmd_repro(argv):
    args = list(argv)
    if "--regressions" in args:
        args.remove("--regressions")
        return cmd_regressions(args)
    if args and os.path.isdir(args[0]):
        d = args.pop(0)
        items = repro_list(d)
        if not items:
            print("hydo: %s recorded no failures; nothing to reproduce" % d)
            return 0
        base = os.path.join(d, "repro-%s" % time.strftime("%Y%m%d-%H%M%S"))
        same = 0
        for k, (label, image, sched, fp, eargs) in enumerate(items):
            res = host_checks_one(os.path.join(base, "%03d" % k),
                                  run_one(image, sched, os.path.join(base, "%03d" % k), eargs, quiet=True))
            res = errors_one(os.path.join(base, "%03d" % k), sched, res)
            ok = res["fp"] == fp
            same += ok
            print("%-12s %s  fp=%s (recorded %s)  %s\n             %s" % (
                "REPRODUCED" if ok else "DIFFERENT", label, res["fp"], fp, sched, res["verdict"][:160]))
        print("hydo: %d of %d reproduced with the recorded fingerprint (consoles under %s)" % (same, len(items), base))
        return 0 if same == len(items) else 1
    return cmd_run(argv)


# ---------------------------------------------------------------- regressions (the test composer's plan)
def plan_regressions(image):
    """The regressions the image was built with: test.regressions of its plan plus
    hydo/regressions/*.schedule (both end up in /etc/hydo/compose.json, hydo_composer.py)."""
    sys.path.insert(0, EXPLORE)
    os.environ["PATH"] = tool_env()["PATH"]
    import manifest_space
    return manifest_space.embedded_compose(image) or {}


def regression_ok(expect, res):
    v = res["verdict"]           # explore.py's verdict_kind: an OK verdict, else a VIOLATION, else an error
    if expect == "ok":
        return "HYDO-ORACLE: OK" in v
    if expect == "violation":
        return "HYDO-ORACLE: OK" not in v and "VIOLATION" in v
    return expect == "fp=" + res["fp"]


def cmd_regressions(args):
    """Replay every saved regression from a fresh boot and check its expectation: `ok` (the
    fixed bug stays fixed: the run passes), `violation` (a known open bug still fails), or
    `fp=<hex>` (bit for bit the recorded run)."""
    image = find_image(args)
    meta = plan_regressions(image)
    regs = meta.get("regressions") or []
    sys.path.insert(0, ONBOARD)
    import hydo_composer
    if not regs:
        print("hydo: %s carries no regressions (hydo/regressions/*.schedule or test.regressions in the plan)" % image)
        return 0
    base = os.path.join(os.path.dirname(image), "regressions-%s" % time.strftime("%Y%m%d-%H%M%S"))
    eargs = engine_args_for(image)
    bad = 0
    for k, r in enumerate(regs):
        w = hydo_composer.regression_warning(r, meta)
        if w:
            print("hydo: warning: " + w)
        res = run_one(image, r["schedule"], os.path.join(base, "%03d-%s" % (k, r["name"])), eargs, quiet=True)
        ok = regression_ok(r["expect"], res)
        bad += not ok
        print("%-5s %s  expect %s  fp=%s  %s\n      %s" % ("PASS" if ok else "FAIL", r["name"], r["expect"], res["fp"],
                                                          r["schedule"], res["verdict"][:160]))
    print("hydo: %d of %d regressions as expected (consoles under %s)" % (len(regs) - bad, len(regs), base))
    return 1 if bad else 0


def cmd_save(argv):
    """Write each minimal schedule of an exploration as hydo/regressions/<name>.schedule with
    `expect: violation` (edit it to `ok` once the bug is fixed)."""
    args = list(argv)
    to = take(args, "--to", os.path.join("hydo", "regressions"))
    if len(args) != 1 or not os.path.isfile(os.path.join(args[0], "report.json")):
        die("usage: hydo save <explore dir> [--to hydo/regressions]")
    j = json.load(open(os.path.join(args[0], "report.json")))
    os.makedirs(to, exist_ok=True)
    n = 0
    for x in j.get("shrunk", []):
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", "%s-%s" % (x["class"], x["signature"]))[:60].strip("-")
        p = os.path.join(to, name + ".schedule")
        if os.path.exists(p):
            print("hydo: %s exists, kept" % p)
            continue
        with open(p, "w") as f:
            f.write("# found by `hydo explore` (seed %s): %s\n# verdict: %s\n" % (x["from_seed"], x["class"], x["min_verdict"][:200]))
            if x.get("composition"):
                f.write("# composition: %s\n" % x["composition"][:400])
            if x.get("commands") is not None:      # what W= refers to (hydo_composer.regression_warning)
                f.write("# commands: %s\n" % " ".join(x["commands"]))
            f.write("# expect: violation      (change to ok when the bug is fixed)\n%s\n" % x["minimal"])
        n += 1
        print("hydo: wrote %s" % p)
    print("hydo: %d regressions saved; `hydo build` stages them, `hydo repro --regressions` replays them" % n)
    return 0



# ---------------------------------------------------------------- module
def sh(cmd, check=False):
    return subprocess.run(cmd, shell=isinstance(cmd, str), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)


def loaded_modules():
    try:
        return {l.split()[0] for l in open("/proc/modules")}
    except OSError:
        return set()


def module_ko(name):
    return os.path.join(MODSRC, "build", name, name + ".ko")


def srcversion_loaded(name):
    try:
        return open("/sys/module/%s/srcversion" % name).read().strip()
    except OSError:
        return None


def srcversion_file(ko):
    if not os.path.isfile(ko):
        return None
    r = sh(["modinfo", "-F", "srcversion", ko])
    return r.stdout.strip() or None


def lock_holders(path):
    """How many processes hold a flock on the lock file (from /proc/locks; takes no lock)."""
    try:
        st = os.stat(path)
    except OSError:
        return 0
    n = 0
    for l in open("/proc/locks"):
        m = re.search(r"\bFLOCK\b.*?\s([0-9a-f]+):([0-9a-f]+):(\d+)\s", l)
        if m and (int(m.group(1), 16), int(m.group(2), 16), int(m.group(3))) == \
                (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino):
            n += 1
    return n


def module_build(name):
    if not re.fullmatch(r"[a-z][a-z0-9_]*", name):
        die("--name: lowercase letters, digits and '_' (it becomes the module and device name)")
    kdir = os.environ.get("KDIR") or "/lib/modules/%s/build" % platform.release()
    if not os.path.isdir(kdir):
        die("no kernel headers at %s (install them, e.g. `sudo apt install linux-headers-$(uname -r)`)" % kdir)
    bd = os.path.dirname(module_ko(name))
    os.makedirs(bd, exist_ok=True)
    shutil.copy(os.path.join(MODSRC, "hvx.c"), os.path.join(bd, name + ".c"))
    shutil.copy(os.path.join(MODSRC, "hvx_abi.h"), os.path.join(bd, "hvx_abi.h"))
    with open(os.path.join(bd, "Makefile"), "w") as f:
        f.write("# generated by hydo module build (from hvx/Makefile)\nobj-m := %s.o\n" % name +
                ("ccflags-y := -DHVX_DEVNAME='\"%s\"'\n" % name if name != "hvx" else "") +
                "OBJECT_FILES_NON_STANDARD_%s.o := y\n" % name)
    r = subprocess.run(["make", "-C", kdir, "M=" + bd, "modules"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if r.returncode != 0 or not os.path.isfile(module_ko(name)):
        sys.stderr.write(r.stdout[-4000:])
        die("building %s.ko failed (output above)" % name)
    print("hydo: built %s (srcversion %s)" % (module_ko(name), srcversion_file(module_ko(name))))
    return 0


def module_load(name, dry, params):
    ko = module_ko(name)
    if not os.path.isfile(ko) and not dry:
        module_build(name)
    mods = loaded_modules()
    steps = []
    if name == "hvx":
        if "hvx" in mods:
            steps.append("sudo rmmod hvx")
        if "kvm_intel" in mods:      # VMX can have one owner: KVM must go (its VMs must be stopped first)
            steps.append("sudo rmmod kvm_intel")
        if "kvm" in mods:
            steps.append("sudo rmmod kvm")
    else:
        if "kvm_intel" in mods:
            die("kvm_intel is loaded; a side module cannot run VMs while KVM owns VT-x (load the main module first)")
        if name in mods:
            steps.append("sudo rmmod %s" % name)
    steps.append("sudo insmod %s%s" % (ko, "".join(" " + p for p in params)))
    steps.append("test -c /dev/%s" % name)
    if os.path.exists(udev_rule_path(name)):    # let udev give the new node its group before runs start
        steps.append("sudo udevadm settle")
    lk = module_lock(name)
    script = " && ".join(steps)
    print("hydo: %s lock %s exclusively (waits for running VMs), then: %s" % ("would take" if dry else "taking", lk, script))
    if dry:
        return 0
    r = subprocess.run(["flock", "-x", lk, "sh", "-c", script])
    if r.returncode != 0:
        die("loading %s failed (rc %d)" % (name, r.returncode))
    print("hydo: %s loaded, /dev/%s ready (srcversion %s)" % (name, name, srcversion_loaded(name)))
    return 0


def module_unload(name, dry):
    lk = module_lock(name)
    if name not in loaded_modules():
        print("hydo: %s is not loaded" % name)
        return 0
    script = "sudo rmmod %s" % name
    print("hydo: %s lock %s exclusively (waits for running VMs), then: %s" % ("would take" if dry else "taking", lk, script))
    if dry:
        return 0
    r = subprocess.run(["flock", "-x", lk, "sh", "-c", script])
    if r.returncode != 0:
        die("unloading %s failed" % name)
    if name == "hvx":
        print("hydo: hvx unloaded (`sudo modprobe kvm_intel` gives VT-x back to KVM)")
    return 0


def module_status(name):
    mods = loaded_modules()
    ko = module_ko(name)
    built, live = srcversion_file(ko), srcversion_loaded(name)
    print("module %s: %s" % (name, "loaded (srcversion %s)" % live if name in mods else "not loaded"))
    print("  release build: %s" % ("%s (srcversion %s)" % (ko, built) if built else "not built (hydo module build)"))
    if built and live:
        print("  %s" % ("same source as this release" if built == live else
                        "DIFFERENT source from this release (the engine and the module may disagree on the ioctl ABI)"))
    dev = "/dev/%s" % name
    if os.path.exists(dev):
        print("  %s" % dev_line(dev))
    print("  kvm_intel: %s" % ("LOADED (must be unloaded for hvx; `hydo module load` does it)" if "kvm_intel" in mods else "not loaded"))
    lk = module_lock(name)
    print("  lock %s: %d holder(s) now" % (lk, lock_holders(lk)))
    return 0


def group_name(gid):
    try:
        return grp.getgrgid(gid).gr_name
    except KeyError:
        return str(gid)


def in_group(gid):
    return gid == os.getgid() or gid in os.getgroups()


def dev_line(dev):
    """One line about who can open the device: mode, group, and whether runs need sudo."""
    st = os.stat(dev)
    g = group_name(st.st_gid)
    who = ("you can open it: runs need no sudo" if dev_usable(dev) else
           "you are not in group %s: log out and in again (or `newgrp %s`) after being added" % (g, g)
           if st.st_mode & 0o060 == 0o060 and not in_group(st.st_gid) else
           "only root can open it: runs use sudo (`hydo module udev install` changes that)")
    return "%s: mode %o, owner %s, group %s; %s" % (dev, st.st_mode & 0o777, pwd.getpwuid(st.st_uid).pw_name
                                                    if st.st_uid == 0 else st.st_uid, g, who)


def udev_rule_path(name):
    return os.path.join(UDEV_DIR, "70-hydo-%s.rules" % name)


def udev_rule_text(name, group, mode):
    return ("# Installed by `hydo module udev install`; `hydo module udev remove` deletes it.\n"
            "# /dev/%s (the hvx kernel module) belongs to group %s with mode %s, so members of the group\n"
            "# run hydo guests without sudo. Anyone in the group can run guests through the module: it\n"
            "# runs in the kernel, takes a CPU and up to 3 GiB of memory per guest, and is a test tool that\n"
            "# was not hardened against hostile users. Give the group only to people you would give sudo.\n"
            'KERNEL=="%s", SUBSYSTEM=="misc", GROUP="%s", MODE="%s"\n' % (name, group, mode, name, group, mode))


def invoking_user():
    return os.environ.get("SUDO_USER") or getpass.getuser()


def module_udev(verb, name, group, mode, dry, adduser):
    """Install or remove the optional udev rule that gives /dev/<name> to a group."""
    if not re.fullmatch(r"[a-z][a-z0-9_]*", name):
        die("--name: lowercase letters, digits and '_'")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]*", group):
        die("--group: a group name (lowercase letters, digits, '_' and '-')")
    if not re.fullmatch(r"0?6[0-7]0", mode):
        die("--mode: 0660 (group read/write) or similar; the owner stays root")
    mode = mode if mode.startswith("0") else "0" + mode
    rule, dev = udev_rule_path(name), "/dev/%s" % name
    if verb == "status":
        if os.path.exists(rule):
            line = [l for l in open(rule) if l.startswith("KERNEL==")]
            print("udev rule %s: %s" % (rule, line[0].strip() if line else "present"))
        else:
            print("udev rule %s: not installed (runs on %s use sudo unless you can open it)" % (rule, dev))
        print("  %s" % (dev_line(dev) if os.path.exists(dev) else "%s: not present (module %s not loaded)" % (dev, name)))
        return 0
    steps = []                      # (description, argv)
    if verb == "install":
        try:
            g = grp.getgrnam(group)
        except KeyError:
            g = None
            steps.append(("create the group", ["sudo", "groupadd", "--system", group]))
        tmp = tempfile.NamedTemporaryFile("w", prefix="hydo-udev-", suffix=".rules", delete=False)
        tmp.write(udev_rule_text(name, group, mode))
        tmp.close()
        os.chmod(tmp.name, 0o644)
        steps.append(("install the rule", ["sudo", "install", "-m", "0644", "-o", "root", "-g", "root", tmp.name, rule]))
        steps.append(("reload the udev rules", ["sudo", "udevadm", "control", "--reload-rules"]))
        if os.path.exists(dev):     # already loaded: apply now (a later load applies it by itself)
            steps.append(("apply it to %s" % dev, ["sudo", "udevadm", "trigger", "--action=change",
                                                   "--subsystem-match=misc", "--sysname-match=%s" % name]))
            steps.append(("wait for udev", ["sudo", "udevadm", "settle"]))
        user = invoking_user()
        member = g is not None and (user in g.gr_mem or pwd.getpwnam(user).pw_gid == g.gr_gid)
        if adduser and not member:
            steps.append(("add %s to the group" % user, ["sudo", "usermod", "-aG", group, user]))
    else:
        if not os.path.exists(rule):
            print("hydo: no udev rule %s; nothing to remove" % rule)
            return 0
        steps.append(("remove the rule", ["sudo", "rm", "-f", rule]))
        steps.append(("reload the udev rules", ["sudo", "udevadm", "control", "--reload-rules"]))
        if os.path.exists(dev):     # back to the module's own default (root, 0600)
            steps.append(("give %s back to root" % dev, ["sudo", "chown", "root:root", dev]))
            steps.append(("mode 0600", ["sudo", "chmod", "0600", dev]))
    for what, argv in steps:
        print("hydo: %s%s: %s" % ("would " if dry else "", what, " ".join(argv)))
        if not dry and subprocess.run(argv).returncode != 0:
            die("%s failed" % what)
    if verb == "install":
        os.unlink(tmp.name)
        if dry:
            return 0
        if os.path.exists(dev):
            print("hydo: %s" % dev_line(dev))
        else:
            print("hydo: %s will belong to group %s (mode %s) from the next `hydo module load%s`." % (
                dev, group, mode, "" if name == "hvx" else " --name %s" % name))
        print("hydo: anyone in group %s can run guests through the hvx module without sudo. The module runs\n"
              "      in the kernel and is a test tool not hardened against hostile users: give the group only\n"
              "      to people you would give sudo. Loading and unloading the module still need sudo." % group)
        if adduser and not member:
            print("hydo: %s was added to group %s; log out and in again (or run `newgrp %s`) before runs "
                  "can use it." % (user, group, group))
        elif not adduser and not member:
            print("hydo: %s is not in group %s (sudo usermod -aG %s %s)" % (user, group, group, user))
    elif not dry:
        print("hydo: rule removed; %s is root's again (mode 0600). Group %s and its members were not changed%s." % (
            dev, group, " (`sudo groupdel hydo` removes the group that `install` created, if nothing else uses it)"
            if group == "hydo" else ""))
    return 0


def cmd_module(argv):
    args = list(argv)
    if not args or args[0] not in ("build", "load", "unload", "status", "udev"):
        die("usage: hydo module build|load|unload|status [--name NAME] [--dry-run] [--param KEY=VALUE ...]\n"
            "       hydo module udev install|remove|status [--name NAME] [--group GROUP] [--mode 0660] "
            "[--no-adduser] [--dry-run]")
    verb = args.pop(0)
    if verb == "udev":
        if not args or args[0] not in ("install", "remove", "status"):
            die("usage: hydo module udev install|remove|status [--name NAME] [--group GROUP] [--mode 0660] "
                "[--no-adduser] [--dry-run]")
        uverb = args.pop(0)
        name = take(args, "--name", "hvx")
        group = take(args, "--group", "hydo")
        mode = take(args, "--mode", "0660")
        dry = "--dry-run" in args
        adduser = "--no-adduser" not in args
        args = [a for a in args if a not in ("--dry-run", "--no-adduser")]
        if args:
            die("unexpected arguments: %s" % " ".join(args))
        return module_udev(uverb, name, group, mode, dry, adduser)
    name = take(args, "--name", "hvx")
    dry = "--dry-run" in args
    params = []
    while "--param" in args:
        params.append(take(args, "--param"))
    args = [a for a in args if a != "--dry-run"]
    if args:
        die("unexpected arguments: %s" % " ".join(args))
    if verb == "build":
        return module_build(name)
    if verb == "load":
        return module_load(name, dry, params)
    if verb == "unload":
        return module_unload(name, dry)
    return module_status(name)


# ---------------------------------------------------------------- doctor
def cmd_doctor(argv):
    fails, warns = [], []

    def check(cond, what, fix="", warn=False):
        tag = "ok  " if cond else ("WARN" if warn else "FAIL")
        print("%s %s%s" % (tag, what, "" if cond else "  -> " + fix))
        if not cond:
            (warns if warn else fails).append(what)

    check(platform.system() == "Linux" and platform.machine() == "x86_64", "x86_64 Linux (found %s %s)" % (
        platform.system(), platform.machine()), "hydo's Linux backend needs x86_64 Linux (Apple Silicon: the Mac release)")
    cpu = open("/proc/cpuinfo").read() if os.path.exists("/proc/cpuinfo") else ""
    flags = set()
    for l in cpu.splitlines():
        if l.startswith("flags"):
            flags = set(l.split(":", 1)[1].split())
            break
    model = next((l.split(":", 1)[1].strip() for l in cpu.splitlines() if l.startswith("model name")), "?")
    print("     CPU: %s" % model)
    check("GenuineIntel" in cpu, "an Intel CPU (hvx is a VT-x hypervisor)", "AMD (SVM) is not supported")
    check("vmx" in flags, "VT-x present and enabled in firmware (vmx in /proc/cpuinfo)",
          "enable Intel VT-x in the BIOS/UEFI settings (the kernel hides vmx when firmware disables it)")
    check("hypervisor" not in flags, "bare metal (not inside a VM)",
          "inside a VM hvx needs nested VT-x, runs much slower and has no PMU: the exit-count clock is used", warn=True)
    hybrid = os.path.isdir("/sys/devices/cpu_atom") or "hybrid_cpu" in flags
    pmu = "arch_perfmon" in flags and not hybrid and "hypervisor" not in flags
    check(pmu, "a usable PMU (non-hybrid CPU with arch_perfmon): the PMU branch clock is used",
          "%s: hvx falls back to the exit-count clock -- runs stay deterministic, but fingerprints differ "
          "from ones recorded with the PMU clock and a guest that computes without exits can stall" %
          ("hybrid P-core/E-core CPU" if hybrid else "no architectural PMU"), warn=True)
    check(sys.version_info >= (3, 9), "Python 3.9+ (found %s)" % platform.python_version(), "install python3 >= 3.9")
    for t, why in (("cc", "builds the run engine and the report tool"), ("make", "builds the kernel module"),
                   ("flock", "the module lock, util-linux"), ("xz", "unpacks guest kernel modules for network faults"),
                   ("sudo", "loads the module; runs use it only if you cannot open the device"), ("modinfo", "module checks, kmod")):
        check(shutil.which(t) is not None, "%s (%s)" % (t, why), "install %s" % t)
    sudo_ok = shutil.which("sudo") and subprocess.run(["sudo", "-n", "true"], stdout=subprocess.DEVNULL,
                                                      stderr=subprocess.DEVNULL).returncode == 0
    usable = dev_usable() and os.environ.get("HYDO_SUDO") != "1"
    if usable is not None and os.path.exists(DEV):
        print("     %s" % dev_line(DEV))
    if usable:
        check(True, "%s can be opened by you: runs do not use sudo" % DEV)
        check(bool(sudo_ok), "sudo without a password prompt (only module load/unload need it)",
              "`hydo module load/unload` will ask for a password", warn=True)
    else:
        check(bool(sudo_ok), "runs use sudo (you cannot open %s yourself), and sudo asks no password" % DEV,
              "a password prompt can block the explorer's workers: `hydo module udev install` (once, with "
              "sudo) gives %s to a group, after which runs need no sudo -- see README" % DEV, warn=True)
    if not uses_sudo():
        sd = SNAP_DIR if os.path.isdir(SNAP_DIR) else os.path.dirname(SNAP_DIR.rstrip("/")) or "/"
        check(os.access(sd, os.W_OK | os.X_OK), "snapshot directory %s writable by you" % SNAP_DIR,
              "set HYDO_SNAP_DIR to a directory you can write (on a real disk, not tmpfs)")
    kdir = "/lib/modules/%s/build" % platform.release()
    check(os.path.isdir(kdir), "kernel headers for %s" % platform.release(),
          "install them (Debian/Ubuntu: sudo apt install linux-headers-$(uname -r))")
    lockdown = ""
    try:
        lockdown = open("/sys/kernel/security/lockdown").read()
    except OSError:
        pass
    check(not lockdown or "[none]" in lockdown, "kernel lockdown off (an unsigned module can be loaded)",
          "Secure Boot lockdown (%s): sign hvx.ko with an enrolled key or disable Secure Boot" % lockdown.strip(), warn=True)
    mods = loaded_modules()
    built, live = srcversion_file(module_ko("hvx")), srcversion_loaded("hvx")
    check(built is not None, "hvx.ko built by this release", "hydo module build", warn=True)
    check("hvx" in mods and os.path.exists("/dev/hvx"), "hvx module loaded, /dev/hvx present", "hydo module load")
    if DEV != "/dev/hvx":
        check(os.path.exists(DEV), "%s present (HVX_DEV: runs use this side module)" % DEV,
              "hydo module load --name %s" % DEVNAME)
    if built and live:
        check(built == live, "the loaded hvx is this release's source (srcversion %s)" % live,
              "the loaded module (srcversion %s) is not this release's (%s): run `hydo module load` "
              "when no one else is using it" % (live, built))
    check("kvm_intel" not in mods, "kvm_intel not loaded (KVM and hvx cannot both own VT-x)",
          "`hydo module load` unloads kvm and kvm_intel (stop KVM virtual machines first)")
    print("     module lock: %s (%d holder(s) now)" % (LOCK, lock_holders(LOCK)))
    for p in (BZIMAGE, INITRD, os.path.join(GUEST, "busybox"), os.path.join(GUEST, "hvx_seedrng"),
              os.path.join(TOOLS, "bin", "mke2fs"), CLOSURES, os.path.join(STORE, "nix", "store")):
        check(os.path.exists(p), "present: " + os.path.relpath(p, R), "reinstall")
    check(os.access(ENGINE, os.X_OK), "run engine built (hvx/hvx_explore)", "run install.sh again")
    r = subprocess.run([os.path.join(LIBEXEC, "faketime"), "2020-09-13 16:26:40", os.path.join(TOOLS, "bin", "mke2fs"), "-V"],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    check("1.47.0" in r.stdout, "bundled mke2fs runs (under the frozen clock)", "output: %s" % r.stdout.strip()[:200])
    for d, need in ((os.getcwd(), 2), (os.path.dirname(SNAP_DIR.rstrip("/")) or "/", 4)):
        try:
            free = shutil.disk_usage(d).free / 2 ** 30
        except OSError:
            continue
        check(free >= need, "%.0f GiB free in %s (%d GiB wanted: %s)" % (free, d, need,
              "images" if d == os.getcwd() else "run snapshots, $HYDO_SNAP_DIR"), "free some space", warn=True)
    print("doctor: %s" % ("all checks passed" if not fails and not warns else
                          "%d failed, %d warnings" % (len(fails), len(warns))))
    return 1 if fails else 0


def main():
    cmds = {"compose": cmd_compose, "build": cmd_build, "run": cmd_run, "repro": cmd_repro, "explore": cmd_explore,
            "report": cmd_report, "doctor": cmd_doctor, "module": cmd_module, "save": cmd_save, "errors": cmd_errors}
    if len(sys.argv) >= 2 and sys.argv[1] in ("guide", "skill", "init"):
        sys.path.insert(0, ONBOARD)
        import hydo_agents      # shared by both releases: hvx/onboard/hydo_agents.py
        return hydo_agents.run(sys.argv[1], sys.argv[2:], R)
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__)
        return 0 if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help", "help") else 2
    return cmds[sys.argv[1]](sys.argv[2:]) or 0


if __name__ == "__main__":
    sys.exit(main())

# Added on top of ../linux/hvm.config for real services (Redis, PostgreSQL, miniflux).
# allnoconfig turns these EXPERT-gated syscalls off; the services need them:
CONFIG_SYSVIPC=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_SYSCTL=y
CONFIG_KCMP=y
CONFIG_TMPFS_XATTR=y
CONFIG_NET_CORE=y

#!/bin/sh
# /init for the Redis service guest under hvm: the hvx/onboard/examples/redis workload and
# invariant (20 SETs over 127.0.0.1, every acknowledged SET must read back), data on tmpfs.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mount -t tmpfs tmp /tmp
mkdir -p /data/redis /tmp/hydo
ip link set lo up
echo "hydo-svc: crng $(cat /proc/sys/kernel/random/entropy_avail 2>/dev/null) uptime $(cat /proc/uptime)"
R=@REDIS@
$R/bin/redis-server /etc/redis.conf > /tmp/hydo/redis.log 2>&1 &
n=0
until $R/bin/redis-cli ping 2>/dev/null | grep -q PONG; do
  n=$((n + 1)); [ $n -gt 600 ] && { echo "HYDO-ORACLE: VIOLATION redis never became ready"; cat /tmp/hydo/redis.log; echo "hydo-svc-marker: done"; exec sh; }
  sleep 0.1
done
echo "hydo-svc: redis ready after $n polls, uptime $(cat /proc/uptime)"
ACKED=/tmp/hydo/acked; : > $ACKED
i=0
while [ $i -lt 20 ]; do
  r=$(timeout 2 $R/bin/redis-cli SET k:$i v$i 2>/dev/null)
  [ "$r" = OK ] && echo $i >> $ACKED
  i=$((i + 1))
done
lost=0
for i in $(cat $ACKED); do
  [ "$($R/bin/redis-cli GET k:$i)" = "v$i" ] || { echo "HYDO-ORACLE: VIOLATION key k:$i lost"; lost=1; break; }
done
[ $lost = 0 ] && echo "HYDO-ORACLE: OK acked=$(wc -l < $ACKED) all present"
echo "hydo-svc: info $($R/bin/redis-cli INFO server | grep -E 'redis_version|process_id' | tr -d '\r' | tr '\n' ' ')"
echo "hydo-svc: uptime $(cat /proc/uptime)"
echo "hydo-svc-marker: done"
exec sh

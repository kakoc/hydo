# Additions to ../linux/hvm.config for manifest-built (hvx/onboard) guests on the Mac VMM:
# a block layer, the loop driver and ext4, so hydo-init.sh's data disk (/dev/vda2, ext4)
# can be a loop device over an image inside the initramfs until virtio-blk exists.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=4
CONFIG_EXT4_FS=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSCTL=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y

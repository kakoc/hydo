# A small image: busybox's httpd serves one file on port 8080.
FROM busybox:1.36.1 AS base
ARG GREETING=unset
RUN mkdir -p /www && echo "$GREETING" > /www/index.html

FROM base AS run
EXPOSE 8080
HEALTHCHECK CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
CMD ["httpd", "-f", "-p", "8080", "-h", "/www"]

id}'\\'''\nHYDO_INV_i1_every=''\nHYDO_INV_i1_final=1\nHYDO_INV_i2_id='payments.no_charge_after_cancel'\nHYDO_INV_i2_type='always'\nHYDO_INV_i2_msg='no charge for an order after its cancellation was acknowledged'\nHYDO_INV_i2_cmd='hydo-world check none-after payments.charge --after event:cancelled'\nHYDO_INV_i2_every=''\nHYDO_INV_i2_final=1\nHYDO_INV_i3_id='email.receipt_at_most_once'\nHYDO_INV_i3_type='always'\nHYDO_INV_i3_msg='every order gets at most one receipt email'\nHYDO_INV_i3_cmd='hydo-world check at-most-once email.send'\nHYDO_INV_i3_every=''\nHYDO_INV_i3_final=1\nHYDO_INV_i4_id='email.no_receipt_after_cancel'\nHYDO_INV_i4_type='always'\nHYDO_INV_i4_msg='no receipt email for an order after its cancellation was acknowledged'\nHYDO_INV_i4_cmd='hydo-world check none-after email.send --after event:cancelled'\nHYDO_INV_i4_every=''\nHYDO_INV_i4_final=1\nHYDO_INV_i5_id='email.receipt_eventually'\nHYDO_INV_i5_type='eventually'\nHYDO_INV_i5_msg='every acknowledged order that was not cancelled gets its receipt email within 30 s after the faults end'\nHYDO_INV_i5_cmd='hydo-world check effect-for-acked email.send --ref '\\''o{id}'\\'' --unless event:cancel-requested'\nHYDO_INV_i5_every=''\nHYDO_INV_i5_final=0\nHYDO_INV_i5_within=30\nHYDO_INV_i5_after='heal'\nHYDO_INV_i5_poll=2\nHYDO_INVARIANTS='i0 i1 i2 i3 i4 i5'\n\n# ---- prelude.sh\n# generated by hvx/onboard/hydo-build: the project's env + shell helpers (hydo.yaml)\nexport HOME=/tmp TZ=UTC LANG=C\n\n","stderr":"","files":{"home/":""}}}

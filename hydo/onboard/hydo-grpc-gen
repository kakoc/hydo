#!/usr/bin/env bash
# hydo-grpc-gen <proto dir> [--hints hints.yaml] --out <dir>
#   (or --descriptor-set set.pb / --reflect host:port instead of <proto dir>)
# Generates gRPC drivers for a hydo project (MANIFEST.md "gRPC services"). The generator and the
# guest client are Rust (hydo/crates/hydo-grpc-gen, hydo/crates/hydo-grpc); this wrapper builds
# the generator for the host and the static clients of the architectures in --arch
# ($HYDO_GRPC_ARCH, default amd64) with hydo/grpcgen/build-client.sh, then runs the generator with
# --client pointing at them. $HYDO_GRPC_CLIENT names a directory of prebuilt clients instead (a
# release ships them); --no-build skips the clients. $CARGO is the cargo to use.
set -euo pipefail
TOP="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CARGO="${CARGO:-cargo}"
( cd "$TOP" && "$CARGO" build --release --locked -q -p hydo-grpc-gen )
arch="${HYDO_GRPC_ARCH:-amd64}"; prev=""; nobuild=0
for a in "$@"; do
  case "$prev" in --arch|-arch) arch="$a";; esac
  case "$a" in --arch=*|-arch=*) arch="${a#*=}";; --no-build|-no-build|--no-build=true|-no-build=true) nobuild=1;; esac
  prev="$a"
done
if [ -z "${HYDO_GRPC_CLIENT:-}" ] && [ "$nobuild" = 0 ]; then
  HYDO_GRPC_CLIENT="$TOP/target/grpc-client/out"
  "$TOP/hydo/grpcgen/build-client.sh" --out "$HYDO_GRPC_CLIENT" ${arch//,/ } >&2
fi
HYDO_GRPC_CLIENT="${HYDO_GRPC_CLIENT:-}" exec "$TOP/target/release/hydo-grpc-gen" "$@"

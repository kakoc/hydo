#!/usr/bin/env bash
# hydo-grpc-gen <proto dir> [--hints hints.yaml] --out <dir>
#   (or --descriptor-set set.pb / --reflect host:port instead of <proto dir>)
# Generates gRPC drivers for a hydo project (MANIFEST.md "gRPC services"). The generator and
# the guest client are Go (hvx/grpcgen); this wrapper builds the generator for the host and
# lets it build the static guest client with the same toolchain: $HYDO_GO, else the pinned
# go-1.26.5 store path of build-stack.sh if it exists, else `go` on PATH.
set -euo pipefail
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../grpcgen" && pwd)"
if [ -z "${HYDO_GO:-}" ]; then
  for g in /nix/store/pwj3x44pp735yb038fnmqckyyra9k29x-go-1.26.5/bin/go /nix/store/xrgn6m0c5vbz06467q06zdwnk6qqdl7z-go-1.26.5/bin/go; do
    [ -x "$g" ] && { HYDO_GO=$g; break; }
  done
fi
HYDO_GO=${HYDO_GO:-go}
BIN="${HYDO_GRPC_GEN_CACHE:-$SRC/.bin}"
mkdir -p "$BIN"
( cd "$SRC" && GOTOOLCHAIN=local GOFLAGS=-mod=readonly CGO_ENABLED=0 "$HYDO_GO" build -trimpath -buildvcs=false -o "$BIN/hydo-grpc-gen" ./cmd/hydo-grpc-gen )
HYDO_GO="$HYDO_GO" HYDO_GRPC_SRC="$SRC" exec "$BIN/hydo-grpc-gen" "$@"

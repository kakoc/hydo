+// failSyncQueuedAtomicBatch fails a synchronous atomic bulk request in queue mode
+// whose items could not all be queued. It marks the batch failed, so the worker
+// rejects the items already queued, and takes the batch lock that the worker
+// holds while it applies an item. Both live in Redis, which may be what failed,
+// so it also records the items still waiting as REJECTED in PostgreSQL: the
+// worker then finds their outcome reference used and drops their tasks. Then it
+// rolls back what was applied.
+func (l *Blnk) failSyncQueuedAtomicBatch(ctx context.Context, batchID string, isInflight bool) (int, error) {
+	if err := l.markQueuedAtomicBatchFailed(ctx, batchID); err != nil {
+		logrus.WithError(err).WithField("batch_id", batchID).Error("failed to mark atomic batch as failed")
+	}
+	locker := redlock.NewLocker(l.redis, atomicBatchLockKey(batchID), model.GenerateUUIDWithSuffix("loc"))
+	lockCfg := l.Config().Transaction
+	if err := locker.WaitLock(ctx, lockCfg.LockDuration, lockCfg.LockWaitTimeout); err != nil {
+		logrus.WithError(err).WithField("batch_id", batchID).Error("failed to acquire lock for atomic batch")
+	} else {
+		defer l.releaseSingleLock(ctx, locker)
+	}
+	if err := l.rejectWaitingBatchItems(ctx, batchID); err != nil {
+		return 0, err
+	}
+	_, count, err := l.rollbackBatchTransactions(ctx, batchID, isInflight)
+	return count, err
+}
+
+// rejectWaitingBatchItems records a REJECTED outcome for every item of the batch
+// that is still QUEUED. An item whose outcome the worker has already written is
+// left to the rollback.
+func (l *Blnk) rejectWaitingBatchItems(ctx context.Context, batchID string) error {
+	items, err := l.datasource.GetTransactionsByParent(ctx, batchID, 1000, 0)
+	if err != nil {
+		return err
+	}
+	for _, item := range items {
+		if item.Status != StatusQueued {
+			continue
+		}
+		rejected := createQueueCopy(item, item.Reference)
+		rejected.Status = StatusRejected
+		md := make(map[string]interface{}, len(item.MetaData)+1)
+		for k, v := range item.MetaData {
+			md[k] = v
+		}
+		md["blnk_rejection_reason"] = ErrAtomicBatchFailed.Error()
+		rejected.MetaData = md
+		model.ApplyPrecision(rejected)
+		if _, err := l.datasource.RecordTransaction(ctx, rejected); err != nil && !IsDuplicateReferenceError(err) {
+			return err
+		}
+	}
+	return nil
+}

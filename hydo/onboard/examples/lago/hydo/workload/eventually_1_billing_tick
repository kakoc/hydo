#!/bin/sh
# hydo: timeout=30
# The billing tick, without waiting for it. Lago's clock service starts the biller at minute 10
# of every hour, and November is billed on the first such tick of December 1. A run lasts less
# than a minute of guest time, so after the faults this command moves the guest's clock forward
# to 2 s before that tick: to 2026-12-01 00:09:58 when the clock is earlier (also after a clock
# fault stepped it back), or to the next minute 10 when it is later. That is the step that
# waiting would make; Lago does the rest. The checks eventually_november_billed and
# eventually_transfers_charged count from the end of this command (after=commands).
first=1796083798              # 2026-12-01 00:09:58 UTC
now=$(date -u +%s)
m=$(date -u -d "@$now" +%M); s=$(date -u -d "@$now" +%S)
m=${m#0}; s=${s#0}
into=$((m * 60 + s))          # seconds into the hour
if [ $into -lt 598 ]; then t=$((now - into + 598)); else t=$((now - into + 3600 + 598)); fi
[ $now -lt $first ] && t=$first
date -u -s "$(date -u -d "@$t" '+%Y-%m-%d %H:%M:%S')" > /dev/null || exit 1
echo "clock: $(date -u -d "@$now" '+%F %T') -> $(date -u '+%F %T')"

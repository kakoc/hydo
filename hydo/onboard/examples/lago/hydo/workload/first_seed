#!/bin/sh
# hydo: timeout=600
# The catalogue (two billable metrics and a monthly plan) and four customers, each with a
# subscription that started on 2026-11-01, through Lago's API, inside the snapshot. Then two
# usage events of November per subscription, so that every subscription has November usage
# before the run starts (sub4 gets no other events: serial_driver_terminate ends it).
. /hydo/workload/helper_lib.sh
i=0
until C wait; do
  i=$((i + 1)); [ $i -lt 120 ] || { echo "the API never answered"; exit 1; }
  sleep 1
done
C seed || exit 1
# the seed's acknowledged events are the client's records too: test.first_records keeps them in
# the run's $HYDO_ACKED and $HYDO_OUTCOMES
for n in 1 2 3 4; do
  C event "s${n}a" "sub$n" api_calls 5 > /dev/null && record ack "s${n}a,units:sub$n:api_calls,5" || exit 1
  C event "s${n}b" "sub$n" api_calls 7 > /dev/null && record ack "s${n}b,units:sub$n:api_calls,7" || exit 1
done

#!/bin/sh
# hydo-msg: faults do not change the business result: every total Lago bills equals what the client saw acknowledged
# The rule knows only the client's outcome lines ("<op>,<key>,<amount> ack|failed|unknown") and
# what Lago reports per key (helper_client.rb report): acknowledged amounts must be there once,
# amounts without an answer at most once, refused ones not at all (workload/helper_ledger.awk).
. /hydo/workload/helper_lib.sh
C report > /tmp/lago-report.txt || exit 2
outcomes > /tmp/lago-outcomes.txt
awk -f /hydo/workload/helper_ledger.awk /tmp/lago-outcomes.txt /tmp/lago-report.txt > /tmp/lago-ledger.txt
rc=$?
# what Lago reported, then the totals that differ, and the summary as the last line; hydo keeps
# the lines before the last one of a failing check in result.json (details.output)
[ $rc = 0 ] || sed 's/^/reported: /' /tmp/lago-report.txt
cat /tmp/lago-ledger.txt
exit $rc

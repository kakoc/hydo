#!/bin/sh
# hydo-msg: after the longest timeout no account keeps pending debits or credits, every hold has the timeout its client sent, and a hold is posted or voided at most once and never at or after its expiry
# The business rule of holds (helper_tb.sh): a hold reserves its amount until it is posted,
# voided, or expires. Once the longest timeout (3 s) has passed, every hold is in one of those
# states, so the pending balances the acknowledged operations imply are zero on every account;
# final_ledger checks the posted side and that every acknowledged hold, post and void is there.
# The console gets each hold's timestamp and timeout ("tb-hold <timestamp> <timeout>"): its expiry
# instant is timestamp + timeout seconds (RESULTS.md, "Holds and expiry").
. ${HYDO_WORKLOAD:-/hydo/workload}/helper_tb.sh
W=/tmp/hydo/check-holds; rm -rf $W; mkdir -p $W
tb 10 "lookup_accounts id=1" | grep -q '"id": "1"' || { echo "the cluster did not answer"; exit 2; }
sleep 4

stmt="lookup_accounts"; sep=" "; i=1
while [ $i -le $TB_ACCOUNTS ]; do stmt="$stmt$sep id=$i"; sep=","; i=$((i + 1)); done
tb 30 "$stmt" > $W/accounts.json || { echo "the cluster did not answer lookup_accounts"; exit 2; }
tb 30 "query_transfers ledger=700 limit=8189" > $W/transfers.json
case $? in 0|1) ;; *) echo "the cluster did not answer query_transfers"; exit 2 ;; esac
flat $W/accounts.json a > $W/accounts
flat $W/transfers.json t > $W/found
[ "$(wc -l < $W/accounts)" = "$TB_ACCOUNTS" ] || { echo "lookup_accounts returned $(wc -l < $W/accounts) of $TB_ACCOUNTS accounts"; exit 1; }
awk '$5 == "[pending]" { print "tb-hold", $7, $8 }' $W/found > /dev/console 2>/dev/null

awk -v H=$TB_HOLD -v acc=$W/accounts -v fnd=$W/found '
  # a 19-digit timestamp as seconds and nanoseconds (awk numbers are exact to 2^53 only)
  function sec(t) { return substr(t, 1, length(t) - 9) + 0 }
  function nsec(t) { return substr(t, length(t) - 8) + 0 }
  BEGIN {
    while ((getline l < fnd) > 0) {
      split(l, a, " ")
      if (a[5] == "[pending]") {
        nholds++; ts[a[1]] = a[7]; to[a[1]] = a[8]
        if (a[8] != int((a[1] - H) / 100000) % 10) { badto++; if (badto <= 5) badtol = badtol " " a[1] }
      } else if (a[5] == "[post_pending_transfer]" || a[5] == "[void_pending_transfer]") {
        nset++; p = a[6]; n[p]++; sts[a[1]] = a[7]; of[a[1]] = p
        if (p != a[1] - (a[5] == "[void_pending_transfer]" ? 2 : 1) * H) { badp++; if (badp <= 5) badpl = badpl " " a[1] }
      }
    }
    for (p in n) if (n[p] > 1) { twice++; if (twice <= 5) twicel = twicel " " p }
    for (s in of) {
      p = of[s]; if (!(p in ts)) { orphan++; if (orphan <= 5) orphanl = orphanl " " s; continue }
      es = sec(ts[p]) + to[p]; en = nsec(ts[p]); ss = sec(sts[s]); sn = nsec(sts[s])
      if (ss > es || (ss == es && sn >= en)) { late++; if (late <= 5) latel = latel " " s " (hold " p ")" }
    }
    while ((getline l < acc) > 0) {
      split(l, a, " ")
      if (a[4] != 0 || a[5] != 0) { left++; leftl = leftl " account " a[1] ": debits_pending " a[4] " credits_pending " a[5] }
    }
    if (left) print "pending balances after every timeout:" leftl
    if (twice) print "holds settled more than once:" twicel
    if (late) print "settled at or after the expiry:" latel
    if (orphan) print "settlements of no hold in the ledger:" orphanl
    if (badto) print "holds with another timeout than sent:" badtol
    if (badp) print "settlements of another hold than sent:" badpl
    if (left) { printf "%d accounts keep pending balances after every hold expired\n", left; exit 1 }
    if (twice || late || orphan) { printf "%d holds settled twice, %d settled late, %d settlements without a hold\n", twice, late, orphan; exit 1 }
    if (badto || badp) { printf "%d holds and %d settlements differ from what was sent\n", badto, badp; exit 1 }
    printf "holds ok: %d holds, %d posted or voided, no pending balance left\n", nholds, nset
  }' > $W/verdict
rc=$?
cat $W/verdict
exit $rc

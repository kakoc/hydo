#!/bin/sh
# hydo: within=120 after=heal poll=2
# hydo-msg: after the faults heal, the replica holds exactly the primary's rows
# A differential check: both tables, read on each node, compared as sets of lines (hydo-check's
# jsonl source needs one field to compare; a whole row is a line of the file source). The rows
# that differ and the replica's last log lines go on earlier lines; the last line keeps to counts
# (the explorer groups failures by it). The deadline: after a lossy link between the nodes the
# replica took 47 s of guest time to catch up (RESULTS.md), so 30 s was too short.
/bin/sqlgen dump primary > /tmp/conv.primary.jsonl || exit 2
/bin/sqlgen dump replica > /tmp/conv.replica.jsonl || exit 2
out=$(hydo-check equal --show 0 --left 'primary=file /tmp/conv.primary.jsonl' --right 'replica=file /tmp/conv.replica.jsonl')
rc=$?
if [ $rc != 0 ]; then
  echo "only on the primary: $(awk 'FILENAME == ARGV[1] { r[$0] = 1; next } !($0 in r)' /tmp/conv.replica.jsonl /tmp/conv.primary.jsonl | head -3 | tr '\n' ' ')"
  echo "replica log: $(tail -n 2 /tmp/hydo/replica.log 2>/dev/null | cut -c1-200 | tr '\n' ' ')"
fi
echo "$out"
exit $rc

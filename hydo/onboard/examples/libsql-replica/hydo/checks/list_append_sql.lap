#!/bin/sh
# hydo: history=lap consistency=strict-serializable
# hydo-msg: on the primary, the SQL transactions are strict-serializable: no acknowledged append is lost, also across a power cut
# History lap: the transactions a primary ran, and only the appends of those a replica served
# (a write executes on the primary within the request; a replica's reads may be stale).
exec hydo-sql list-append read-all primary 9998

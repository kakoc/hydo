#!/bin/sh
# hydo: every=2
# hydo-msg: the bank's total never changes and no balance is negative, on the primary and on the replica
# Exit 2 (cannot judge now) when a node does not answer: a killed or paused node is not a violation.
rc=0
for n in primary replica; do
  /bin/sqlgen total $n; r=$?
  [ $r = 1 ] && exit 1
  [ $r = 2 ] && rc=2
done
exit $rc

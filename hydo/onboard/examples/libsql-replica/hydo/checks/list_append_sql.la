#!/bin/sh
# hydo: history=la consistency=serializable
# hydo-msg: the SQL list-append transactions are serializable (no lost, aborted or duplicated append, no dependency cycle)
# History la holds every transaction, also those a replica served, whose reads may be stale,
# so it claims no real-time order (list_append_sql.lap does, for what ran on a primary).
# The final read-back: every list, in one transaction on primary.
exec hydo-sql list-append read-all primary 9999

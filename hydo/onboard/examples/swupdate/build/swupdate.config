#
# SWUpdate 2026.05.1 for the hydo device example: a local installer (swupdate -i) with the raw
# handler, sha256 checks, the libconfig parser and U-Boot's environment through libubootenv.
# No network, no web server, no Lua, no signing (signing changes nothing on the device's storage).
#
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
CONFIG_HASH_VERIFY=y
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_UBOOT=y
CONFIG_UBOOT_FWENV="/etc/fw_env.config"
CONFIG_UBOOT_DEFAULTENV="/etc/u-boot-initial-env"
CONFIG_BOOTLOADER_DEFAULT_UBOOT=y
CONFIG_RAW=y
CONFIG_BOOTLOADERHANDLER=y
# CONFIG_LUASCRIPTHANDLER is not set
CONFIG_EXTRA_LDFLAGS="-static"
CONFIG_EXTRA_LDLIBS="yaml z"
# CONFIG_LUA is not set
# CONFIG_DOWNLOAD is not set
# CONFIG_WEBSERVER is not set
# CONFIG_SURICATTA is not set
# CONFIG_MTD is not set
# CONFIG_ARCHIVE is not set
# CONFIG_SYSTEMD is not set
# CONFIG_HW_COMPATIBILITY is not set
# CONFIG_SIGNED_IMAGES is not set
# CONFIG_ENCRYPTED_IMAGES is not set
# CONFIG_GUNZIP is not set
# CONFIG_ZSTD is not set
# CONFIG_DISKPART is not set
# CONFIG_DISKFORMAT is not set
# CONFIG_BOOTLOADER_EBG is not set
# CONFIG_BOOTLOADER_GRUB is not set
# CONFIG_BOOTLOADER_CBOOT is not set

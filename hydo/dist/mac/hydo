#!/usr/bin/env python3
# Not shipped since Milestone 101: the releases ship the Rust hydo (hydo/crates/hydo-cli). This file stays as
# the reference that hydo/crates/hydo-cli/tests/equivalence.rs compares the Rust CLI with, until every port is done.
"""hydo -- deterministic fault testing on an Apple Silicon Mac (the hvm backend).

    hydo init    [--dir DIR] [--name NAME]        start a repository's hydo/ folder and its AGENTS.md section
    hydo guide   [TOPIC | --list]                 print the onboarding guide for any AI tool (the skill's SKILL.md)
    hydo skill   install --agent claude|codex|cursor|copilot|gemini|all [--user] | --to DIR
                                                  copy the onboarding skill where an AI tool reads skills
    hydo compose <docker-compose.yaml> [--out hydo.yaml]
                                                  start a hydo.yaml from a Compose file (MANIFEST.md)
    hydo build   <hydo.yaml> [--out DIR]          compile the manifest into an arm64 guest image
    hydo run     "<schedule>" [--image IMG]       run one schedule from a fresh boot
    hydo repro   "<schedule>" [--image IMG]       the same as run (reproduce a reported failure)
    hydo repro   --regressions [--image IMG]      replay the plan's saved regressions (hydo/regressions/)
    hydo save    <explore dir> [--to hydo/regressions]   save an exploration's minimal schedules as regressions
    hydo explore [--seeds 1-50] [--image IMG] [--workers N] [--strategy swarm] [--out DIR]
                                                  generate, run, re-run and shrink schedules
    hydo report  [DIR]                            print the report of the last (or a given) exploration
    hydo errors  list [DIR] | accept SIG... --reason TEXT [--with F] [--during F] | check
                                                  error logs as findings: list new error kinds, accept
                                                  expected ones into hydo/known-errors.yaml (MANIFEST.md)
    hydo doctor                                   check this Mac and the installation

IMG defaults to the one image in ./hydo-out (what `hydo build` wrote there). Everything runs on
this Mac: `hydo build` formats the data disk inside a small helper VM (mke2fs in the guest),
so no Linux machine is needed. Plain Python 3.9+ (macOS's /usr/bin/python3 works).
"""
import glob, importlib.machinery, importlib.util, os, platform, shutil, subprocess, sys, tempfile

R = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))     # the release root
ONBOARD = os.path.join(R, "hydo", "onboard")
EXPLORE = os.path.join(R, "hydo", "explore")
HVMX = os.path.join(R, "hv", "hvm", "explore", "hvmx")
HVM = os.path.join(R, "hv", "hvm", "hvm")
KERNEL = os.path.join(R, "hv", "hvm", "explore", "out", "Image-explore")
# the second kernel (Milestone 99), for images built from a manifest with network: bridge, addr:
# or faults: [freeze]; such an image names it in /etc/hydo/kernel (hvm_backend.kernel_for)
NETNS_KERNEL = os.path.join(R, "hv", "hvm", "explore", "out", "Image-explore-netns")
GUEST = os.path.join(R, "guest")
HISTORY = os.path.join(R, "hydo", "history")       # the host's history checkers (hydohist.py)
OUT = "hydo-out"


def die(msg):
    print("hydo: " + msg, file=sys.stderr)
    sys.exit(1)


def load_hydo_build():
    loader = importlib.machinery.SourceFileLoader("hydo_build", os.path.join(ONBOARD, "hydo-build"))
    spec = importlib.util.spec_from_loader("hydo_build", loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


def mac_mkfs(hb):
    """A replacement for hydo-build's mkfs(): the same mke2fs options, run by a static arm64
    mke2fs inside a helper VM (hvm) on a raw disk file, instead of the host's mke2fs under
    libfaketime. The guest clock is deterministic, and hydo-build zeroes every time field
    afterwards anyway, so the image is a pure function of the options."""
    import hydo_build_arm64 as a64

    def mkfs(T, out, mib, uuid, seed, src=None, journal=False):
        if src:
            die("internal: populating a filesystem (mke2fs -d) is not supported on the Mac path")
        with open(out, "wb") as f:
            f.truncate(mib * 1024 * 1024)
        feats = "^metadata_csum,^64bit,^flex_bg,^resize_inode" + (",has_journal" if journal else "")
        args = ["/bin/mke2fs", "-q", "-F", "-t", "ext4", "-b", "4096", "-O", feats]
        if journal:
            args += ["-J", "size=16"]
        args += ["-U", uuid, "-E", "hash_seed=%s,lazy_itable_init=0,lazy_journal_init=0" % seed, "/dev/vda"]
        tmp = tempfile.mkdtemp(prefix="hydo-mkfs-")
        try:
            root = os.path.join(tmp, "root")
            for d in ("bin", "dev", "proc", "sys", "etc"):
                os.makedirs(os.path.join(root, d))
            shutil.copy(os.path.join(GUEST, "busybox"), os.path.join(root, "bin", "busybox"))
            shutil.copy(os.path.join(GUEST, "mke2fs"), os.path.join(root, "bin", "mke2fs"))
            os.symlink("busybox", os.path.join(root, "bin", "sh"))
            with open(os.path.join(root, "init"), "w") as f:
                f.write("#!/bin/busybox sh\n"
                        "/bin/busybox mount -t devtmpfs none /dev\n"
                        "/bin/busybox mount -t proc none /proc\n"
                        "n=0; while [ ! -b /dev/vda ] && [ $n -lt 300 ]; do /bin/busybox usleep 10000; n=$((n+1)); done\n"
                        "if %s; then /bin/busybox sync; echo HYDO-MKFS-OK; else echo HYDO-MKFS-FAIL; fi\n"
                        "echo HYDO-MKFS-DONE\n"
                        "while :; do /bin/busybox sleep 3600; done\n" % " ".join("'%s'" % x for x in args))
            for p in ("init", "bin/busybox", "bin/mke2fs"):
                os.chmod(os.path.join(root, p), 0o755)
            initrd = os.path.join(tmp, "mkfs.cpio.gz")
            a64._cpio(root, initrd, hb.FIXED_MTIME)
            env = dict(os.environ, HVM_DISK=os.path.abspath(out), HVM_DISK_OUT=os.path.abspath(out))
            p = subprocess.run([HVM, "run", KERNEL, initrd, "HYDO-MKFS-DONE"], env=env,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            con = p.stdout.decode(errors="replace")
            if "HYDO-MKFS-OK" not in con:
                sys.stderr.write(con[-3000:])
                die("formatting the data disk in the helper VM failed (output above)")
            # mke2fs records whether `char` is signed on the machine that ran it (superblock
            # s_flags: 1 = signed directory hash, x86; 2 = unsigned, arm64). Record the x86
            # value, as a Linux build of the same manifest does, so both give the same bytes.
            # The filesystem is still empty (no hashed directories), so this changes nothing else.
            with open(out, "r+b") as f:
                f.seek(1024 + 0x160)
                fl = int.from_bytes(f.read(4), "little")
                f.seek(1024 + 0x160)
                f.write(((fl & ~0x3) | 0x1).to_bytes(4, "little"))
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    return mkfs


def use_bundled_tc():
    """hydo_build_arm64 puts the pinned aarch64 tc (TC_ARM64, a /nix/store path) and the files
    its loader opens into the root, reading them from the host's /nix/store. The release ships
    exactly those files under guest/tc/<the same absolute paths> (guest/tc-closure.txt). Point
    the module's existence check and its copy at that tree; the image gets the same paths, the
    same bytes and the same modes as a Linux build. Nothing else in the module is affected."""
    import types
    import hydo_build_arm64 as a64
    top = os.path.join(GUEST, "tc")
    listing = [l.strip() for l in open(os.path.join(GUEST, "tc-closure.txt")) if l.strip()]
    here = lambda p: os.path.join(top, p.lstrip("/"))

    real_isfile = os.path.isfile
    path = types.ModuleType("os.path")
    path.__dict__.update(os.path.__dict__)
    path.isfile = lambda p: (real_isfile(here(p)) if str(p).startswith("/nix/store/") and os.path.lexists(here(p))
                             else real_isfile(p))
    shim = types.ModuleType("os")
    shim.__dict__.update(os.__dict__)
    shim.path = path
    a64.os = shim                                   # only hydo_build_arm64's own view of os

    def copy_closure(binary, R):                    # the same rules as a64._copy_elf_closure
        for p in sorted(set(listing + [binary])):
            dst = os.path.join(R, p.lstrip("/"))
            if os.path.lexists(dst):
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            src = here(p)
            if os.path.islink(src):
                os.symlink(os.readlink(src), dst)
            else:
                shutil.copy(src, dst)
                os.chmod(dst, 0o755 if os.access(src, os.X_OK) else 0o644)
    a64._copy_elf_closure = copy_closure


def cmd_compose(argv):
    """hydo compose: hydo/onboard/hydo_compose.py (the Compose importer), unchanged."""
    if not argv or argv[0] in ("-h", "--help"):
        die("usage: hydo compose <docker-compose.yaml> [--out hydo.yaml] [--images-dir DIR] [--env-file F] "
            "[--profile P] [--use-env] [--no-resolve] [--lock FILE]")
    sys.path.insert(0, ONBOARD)
    import hydo_compose
    # every service gets its own network namespace (network: bridge), as on Linux: the arm64
    # build supports it with the second guest kernel (Milestone 99)
    return hydo_compose.main(list(argv))


def cmd_build(argv):
    if not argv or argv[0].startswith("-"):
        die("usage: hydo build <hydo.yaml> [--out DIR] [--set KEY=VALUE ...]")
    manifest, rest = argv[0], argv[1:]
    out = OUT
    if "--out" in rest:
        i = rest.index("--out"); out = rest[i + 1]; del rest[i:i + 2]
    os.environ.setdefault("HYDO_BUSYBOX_ARM64", os.path.join(GUEST, "busybox"))
    os.environ.setdefault("HYDO_BUSYBOX", os.path.join(GUEST, "busybox-applets"))   # prints the applet list
    os.environ.setdefault("HYDO_MKE2FS", os.path.join(GUEST, "mke2fs"))             # passed to the helper VM
    os.environ.setdefault("HYDO_FAKETIME", os.path.join(GUEST, "mke2fs"))           # unused on the Mac path
    # the static arm64 helpers, staged only for the manifests that use them (fakes:/proxies:,
    # commands that call hydo-read or hydo-check)
    os.environ.setdefault("HYDO_WORLDBIN_ARM64", os.path.join(GUEST, "hydo-world"))
    os.environ.setdefault("HYDO_READ_BIN_ARM64", os.path.join(GUEST, "hydo-read"))
    # network: bridge, addr:, faults: [freeze] (Milestone 99): ip and iptables-legacy come from
    # the same aarch64 store tree as tc, the freeze helper is guest/hydo_fc
    os.environ.setdefault("HYDO_ARM64_STORE", os.path.join(GUEST, "tc"))
    os.environ.setdefault("HYDO_FCBIN_ARM64", os.path.join(GUEST, "hydo_fc"))
    sys.path.insert(0, ONBOARD)
    hb = load_hydo_build()
    hb.mkfs = mac_mkfs(hb)
    use_bundled_tc()
    sys.argv = ["hydo-build", manifest, "--arch", "arm64", "--build-dir", out] + rest
    rc = hb.main()
    if rc == 0 and not any(f in rest for f in ("--check", "--print-shell", "--print-init")):
        print("hydo: next:  hydo run \"disk=none | run\"     or     hydo explore --seeds 1-20")
    return rc


def default_image(args):
    if "--image" in args:
        i = args.index("--image"); img = args[i + 1]; del args[i:i + 2]
        return os.path.abspath(img)
    imgs = sorted(glob.glob(os.path.join(OUT, "*-arm64.cpio.gz")))
    if len(imgs) != 1:
        die("no image given and %d images in ./%s (run `hydo build hydo.yaml` here, or pass --image)" % (len(imgs), OUT))
    return os.path.abspath(imgs[0])


def disk_env(image):
    d = image[:-len(".cpio.gz")] + "-disk.img"
    return dict(os.environ, HVM_DISK=d) if os.path.exists(d) else dict(os.environ)


def kernel_for(image, quiet=True):
    """The guest kernel the image was built for: KERNEL, or the second kernel an image with
    service networks records (checked by sha256; hvm_backend.kernel_for)."""
    sys.path.insert(0, EXPLORE)
    import hvm_backend
    k = hvm_backend.kernel_for(image, None, KERNEL)
    if not quiet and k != KERNEL:
        print("hydo: guest kernel %s (recorded in the image)" % os.path.relpath(k, R))
    return k


def run_once(image, sched, outdir, quiet=False):
    os.makedirs(outdir, exist_ok=True)
    sys.path.insert(0, EXPLORE)
    import hvm_backend          # the image's guest.ram_mib, as explore.py passes it
    p = subprocess.run([HVMX] + hvm_backend.image_ram_args(image) + ["one", kernel_for(image, quiet), image, outdir, sched], env=disk_env(image),
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    text = p.stdout.decode(errors="replace")
    for line in text.splitlines():
        if not quiet and (line.startswith("RESULT") or line.startswith("hvmx: one")):   # the verdict, and any rewind escalation
            print(line)
    return text


def host_checks_one(outdir, text, quiet=False):
    """hydo/HISTORIES.md: a run whose console declares history checks (HYDO-CHECK lines, from a
    manifest's checks: or a plan's test.checks) is checked here on the host, as `hydo run` does on
    Linux: one.log (+ one.recovery.log) -> one.checks.log (HYDO-ASSERT records), one.checks.txt
    (explanations). Returns the combined verdict, or None for a run without history checks."""
    import re
    m = [re.match(r"RESULT \S+ fp=\S+ .*?verdict=(.*)", l) for l in text.splitlines()]
    m = [x for x in m if x]
    srcs = []
    for suffix in ("", ".recovery"):
        p = os.path.join(outdir, "one%s.log" % suffix)
        if os.path.exists(p):
            srcs.append(("one" + suffix, open(p, errors="replace").read()))
    if not m or not any("HYDO-CHECK " in t for _, t in srcs):
        return None
    sys.path.insert(0, HISTORY)
    import hydohist
    r = hydohist.run_checks(srcs, m[0].group(1))
    with open(os.path.join(outdir, "one.checks.log"), "w") as f:
        f.write("".join(x + "\n" for x in r["records"]))
    with open(os.path.join(outdir, "one.checks.txt"), "w") as f:
        f.write(r["report"] + "\n" + r["verdict"] + "\n")
    if not quiet:
        print("hydo: history checks: %s   (explanations in %s)" % (r["verdict"], os.path.join(outdir, "one.checks.txt")))
    return r["verdict"]


def cmd_regressions(args):
    """Replay the regressions the image was built with (/etc/hydo/compose.json: hydo/regressions/
    and test.regressions, hydo/onboard/hydo_composer.py) and check each expectation (ok,
    violation, fp=<hex>); exit 1 if one is not as expected."""
    import json, re, time
    image = default_image(args)
    sys.path.insert(0, EXPLORE)
    import hvm_backend
    try:
        meta = json.loads(hvm_backend.embedded_file(image, "etc/hydo/compose.json"))
    except Exception:
        meta = {}
    regs = meta.get("regressions") or []
    sys.path.insert(0, ONBOARD)
    import hydo_composer
    if not regs:
        print("hydo: %s carries no regressions (hydo/regressions/*.schedule or test.regressions in the plan)" % image)
        return 0
    base = os.path.join(OUT, "regressions-%s" % time.strftime("%Y%m%d-%H%M%S"))
    bad = 0
    for k, r in enumerate(regs):
        # M98: a saved composition names its commands by id; one the plan lost cannot replay, a
        # changed one warns (images from before M98 keep the old check: their guest knows one form)
        if meta.get("stable_compose"):
            st = hydo_composer.regression_status(r, meta)
            for w in st["warnings"]:
                print("hydo: warning: %s: %s" % (r["name"], w))
            if st["error"]:
                bad += 1
                print("FAIL  %s  expect %s  not run: %s\n      %s" % (r["name"], r["expect"], st["error"], r["schedule"]))
                continue
        else:
            w = hydo_composer.regression_warning(r, meta)
            if w:
                print("hydo: warning: " + w)
        text = run_once(image, r["schedule"], os.path.join(base, "%03d-%s" % (k, r["name"])), quiet=True)
        m = [re.match(r"RESULT \S+ fp=(\S+) .*?verdict=(.*)", l) for l in text.splitlines()]
        m = [x for x in m if x]
        fp, v = (m[0].group(1), m[0].group(2)) if m else ("-", "ERROR no RESULT line")
        v = host_checks_one(os.path.join(base, "%03d-%s" % (k, r["name"])), text, quiet=True) or v
        ex = r["expect"]
        kind = "ok" if "HYDO-ORACLE: OK" in v else "violation" if "VIOLATION" in v else "error"   # explore.py's verdict_kind
        ok = kind == ex if ex in ("ok", "violation") else ex == "fp=" + fp
        bad += not ok
        print("%-5s %s  expect %s  fp=%s  %s\n      %s" % ("PASS" if ok else "FAIL", r["name"], ex, fp, r["schedule"], v[:160]))
    print("hydo: %d of %d regressions as expected (consoles under %s)" % (len(regs) - bad, len(regs), base))
    return 1 if bad else 0


def cmd_repro(argv):
    args = list(argv)
    if "--regressions" in args:
        args.remove("--regressions")
        return cmd_regressions(args)
    return cmd_run(args)


def cmd_save(argv):
    """Write each minimal schedule of an exploration as hydo/regressions/<name>.schedule with
    `expect: violation` (edit it to `ok` once the bug is fixed)."""
    args = list(argv)
    import json, re
    to = os.path.join("hydo", "regressions")
    if "--to" in args:
        k = args.index("--to"); to = args[k + 1]; del args[k:k + 2]
    if len(args) != 1 or not os.path.isfile(os.path.join(args[0], "report.json")):
        die("usage: hydo save <explore dir> [--to hydo/regressions]")
    j = json.load(open(os.path.join(args[0], "report.json")))
    os.makedirs(to, exist_ok=True)
    sys.path.insert(0, ONBOARD)
    import hydo_composer
    n = 0
    for x in j.get("shrunk", []):
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", "%s-%s" % (x["class"], x["signature"]))[:60].strip("-")
        p = os.path.join(to, name + ".schedule")
        if os.path.exists(p):
            print("hydo: %s exists, kept" % p)
            continue
        with open(p, "w") as f:     # a composition in its stable form: commands by id (hydo_composer, M98)
            f.write(hydo_composer.saved_regression_text(x))
        n += 1
        print("hydo: wrote %s" % p)
        if x.get("stable_note"):
            print("hydo: note: %s" % x["stable_note"])
    print("hydo: %d regressions saved; `hydo build` stages them, `hydo repro --regressions` replays them" % n)
    return 0


def cmd_run(argv):
    args = list(argv)
    image = default_image(args)
    if len(args) != 1:
        die("usage: hydo run \"<schedule>\" [--image IMG]   e.g. hydo run \"disk=cut | run C=12\"")
    sched = args[0]
    outdir = os.path.join(OUT, "runs", "run-%d" % os.getpid())
    text = run_once(image, sched, outdir)
    host_checks_one(outdir, text)
    cons = sorted(glob.glob(os.path.join(outdir, "*")))
    if cons:
        print("hydo: console(s): " + " ".join(cons))
    if not any(l.startswith("RESULT") for l in text.splitlines()):
        sys.stderr.write(text[-3000:])
        die("the run produced no RESULT line (output above)")
    import re
    m = [re.match(r"RESULT \S+ fp=(\S+) .*?verdict=(.*)", l) for l in text.splitlines()]
    m = [x for x in m if x]
    sys.path.insert(0, ONBOARD)
    import hydo_errors          # error logs as findings (an image whose manifest has errors:)
    hydo_errors.for_run_dir(outdir, sched, {"fp": m[0].group(1), "verdict": m[0].group(2)} if m else {"verdict": ""})
    return 0


def cmd_explore(argv):
    args = list(argv)
    image = default_image(args)
    if "--out" not in args:
        args += ["--out", os.path.join(OUT, "explore")]
    if "--seeds" not in args and "--schedule" not in args and "--sweep" not in args:
        args += ["--seeds", "1-20"]
    if "--workers" not in args:
        args += ["--workers", "4"]
    if "--known-errors" not in args:        # error logs as findings: the project's reviewed list
        sys.path.insert(0, ONBOARD)
        import hydo_errors
        if hydo_errors.default_file():
            args += ["--known-errors", os.path.abspath(hydo_errors.default_file())]
    cmd = [sys.executable, os.path.join(EXPLORE, "explore.py"), "--backend", "hvm",
           "--hvm-kernel", kernel_for(image), "--image", image] + args
    rc = subprocess.call(cmd)
    out = args[args.index("--out") + 1]
    if rc == 0:
        print("hydo: report: %s   (hydo report %s)" % (os.path.join(out, "report.md"), out))
    return rc


def cmd_errors(argv):
    """hydo errors list|accept|check (hydo/onboard/hydo_errors.py, shared with the Linux release)."""
    sys.path.insert(0, ONBOARD)
    import hydo_errors
    return hydo_errors.cli(argv, os.path.join(OUT, "explore"))


def cmd_report(argv):
    d = argv[0] if argv else os.path.join(OUT, "explore")
    p = os.path.join(d, "report.md")
    if not os.path.exists(p):
        die("no report at %s" % p)
    sys.stdout.write(open(p).read())
    return 0


def cmd_doctor(argv):
    ok = True
    def check(cond, what, fix=""):
        nonlocal ok
        print("%s %s%s" % ("ok  " if cond else "FAIL", what, "" if cond else "  -> " + fix))
        ok = ok and cond
    check(platform.system() == "Darwin" and platform.machine() == "arm64", "Apple Silicon Mac", "hydo needs an M1 or later Mac")
    v = tuple(int(x) for x in platform.mac_ver()[0].split(".")[:2] if x.isdigit()) if platform.mac_ver()[0] else (0,)
    check(v >= (13, 0), "macOS 13 or later (found %s)" % platform.mac_ver()[0], "update macOS")
    check(sys.version_info >= (3, 9), "Python 3.9+ (found %s)" % platform.python_version(), "use /usr/bin/python3 or newer")
    cc = subprocess.run(["xcrun", "--find", "cc"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).returncode == 0
    check(cc, "a C compiler (the explorer compiles its property-table tool)", "xcode-select --install")
    for p in (HVMX, HVM, KERNEL, os.path.join(GUEST, "busybox"), os.path.join(GUEST, "mke2fs"),
              os.path.join(GUEST, "tc-closure.txt")):
        check(os.path.exists(p), "present: " + os.path.relpath(p, R), "reinstall")
    # for manifests with network: bridge, addr: or faults: [freeze] only (Milestone 99)
    for p in (NETNS_KERNEL, os.path.join(GUEST, "hydo_fc")):
        check(os.path.exists(p), "present: %s (service networks and the freeze)" % os.path.relpath(p, R), "reinstall")
    hv = subprocess.run(["sysctl", "-n", "kern.hv_support"], stdout=subprocess.PIPE, text=True).stdout.strip()
    check(hv == "1", "Hypervisor.framework available (kern.hv_support=%s)" % hv, "not supported on this machine")
    sig = subprocess.run(["codesign", "-d", "--entitlements", "-", HVMX], stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT, text=True).stdout
    check("com.apple.security.hypervisor" in sig, "hvmx signed with the hypervisor entitlement", "run install.sh again")
    return 0 if ok else 1


def main():
    cmds = {"compose": cmd_compose, "build": cmd_build, "run": cmd_run, "repro": cmd_repro, "explore": cmd_explore,
            "save": cmd_save, "errors": cmd_errors,
            "report": cmd_report, "doctor": cmd_doctor}

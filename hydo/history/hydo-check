#!/usr/bin/env python3
"""hydo-check -- run the host-side history checks of one run (hydo/HISTORIES.md).

    hydo-check <console> [<recovery console>]         saved consoles, in run order
    hydo-check <run dir>                              a `hydo run` / `hvx_explore one` output dir:
                                                      one.log (+ one.recovery.log)
    hydo-check --tag T <consoles dir>                 explore.py's consoles/<T>.log (+ .recovery.log)
  options:
    --check '<json>'      a check spec, instead of the HYDO-CHECK lines in the console (repeatable),
                          e.g. '{"id":"kv","type":"linearizable","model":"register","history":"kv"}'
    --verdict '<line>'    the guest's verdict (default: the last HYDO-ORACLE line of the consoles)
    --report <file>       also write the full report (explanations) there
    --budget <n>          linearizability search steps per key (default 2000000)

Prints the HYDO-ASSERT records, the report, and the combined verdict as the last line.
Exit status: 0 OK, 1 VIOLATION, 2 ERROR (undecided check, bad history, guest error), 3 no checks.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import hydohist   # noqa: E402


def sources_for(args, tag):
    if len(args) == 1 and os.path.isdir(args[0]):
        d = args[0]
        t = tag or "one"
        out = []
        for suffix in ("", ".recovery"):
            p = os.path.join(d, "%s%s.log" % (t, suffix))
            if os.path.exists(p):
                out.append(("%s%s" % (t, suffix), open(p, errors="replace").read()))
        if not out:
            raise SystemExit("hydo-check: no %s.log in %s" % (t, d))
        return out
    return [(os.path.basename(p)[:-4] if p.endswith(".log") else os.path.basename(p), open(p, errors="replace").read())
            for p in args]


def guest_verdict(srcs):
    v = None
    for _, text in srcs:
        for line in text.splitlines():
            k = line.find("HYDO-ORACLE:")
            if k >= 0:
                v = line[k:].strip()
    return v


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    specs, verdict, report, tag, budget, files = [], None, None, None, hydohist.DEFAULT_BUDGET, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--check":
            specs.append(json.loads(argv[i + 1])); i += 2
        elif a == "--verdict":
            verdict = argv[i + 1]; i += 2
        elif a == "--report":
            report = argv[i + 1]; i += 2
        elif a == "--tag":
            tag = argv[i + 1]; i += 2
        elif a == "--budget":
            budget = int(argv[i + 1]); i += 2
        else:
            files.append(a); i += 1
    srcs = sources_for(files, tag)
    if verdict is None:
        verdict = guest_verdict(srcs)
    r = hydohist.run_checks(srcs, verdict, budget=budget, specs=specs or None)
    if r["verdict"] is None:
        print("hydo-check: no HYDO-CHECK declarations in the console (and no --check)")
        return 3
    for rec in r["records"]:
        print(rec)
    print(r["report"])
    for w in r["warnings"][:20]:
        print("warning: " + w)
    if report:
        with open(report, "w") as f:
            f.write(r["report"] + "\n" + r["verdict"] + "\n")
    print(r["verdict"])
    v = r["verdict"]
    return 0 if "HYDO-ORACLE: OK" in v else (1 if "VIOLATION" in v else 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hydo results, version 1",
  "description": "Any version-1 record or document (the schema's root).",
  "anyOf": [
    {
      "$ref": "#/$defs/Run"
    },
    {
      "$ref": "#/$defs/Exploration"
    },
    {
      "$ref": "#/$defs/Start"
    },
    {
      "$ref": "#/$defs/Shrink"
    },
    {
      "$ref": "#/$defs/End"
    }
  ],
  "$defs": {
    "Run": {
      "description": "One run of one schedule: `result.json` of `hydo run`, and every run of an exploration in\n`events.jsonl`.",
      "type": "object",
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "$ref": "#/$defs/RunType"
        },
        "hydo_version": {
          "description": "The hydo that wrote the document (documents only).",
          "type": [
            "string",
            "null"
          ]
        },
        "epoch": {
          "description": "The fingerprint epoch of that hydo (documents only; added in M155): fingerprints of one\nepoch are comparable, across epochs only verdicts are. Absent: before M155, epoch 1.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tag": {
          "description": "The explorer's name for the run (`seed-3`, `repro-3`, `shrink-1-0`, `min-a`, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "seed": {
          "description": "The exploration seed (or sweep point number) the run belongs to.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "role": {
          "description": "Why the explorer made the run ([`role`]).",
          "type": [
            "string",
            "null"
          ]
        },
        "schedule": {
          "description": "The schedule, in the schedule language (`disk=cut | run C=12`).",
          "type": "string"
        },
        "class": {
          "description": "The explorer's finding class of the schedule (`durable-defaults`, `unsafe-knob`, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "point": {
          "description": "A sweep point's label.",
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "description": "Documents only: in a stream, the [`Start`] record names the image.",
          "anyOf": [
            {
              "$ref": "#/$defs/Image"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine": {
          "description": "Documents only: in a stream, the [`Start`] record names the engine.",
          "anyOf": [
            {
              "$ref": "#/$defs/Engine"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "fingerprints": {
          "$ref": "#/$defs/Fingerprints"
        },
        "findings": {
          "description": "What the run checked: failed invariants and assertions, every history check, every\nerror kind.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "default": []
        },
        "properties": {
          "description": "Documents only: the run's property table.",
          "anyOf": [
            {
              "$ref": "#/$defs/PropertyTable"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_logs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorLogs"
            },
            {
              "type": "null"
            }
          ]
        },
        "secs": {
          "description": "The run's wall time in seconds (engine side).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "counters": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counters"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker": {
          "description": "The explorer worker that ran it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cached": {
          "description": "Answered from `$HYDO_EXPLORE_CACHE` instead of run.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "branch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Branch"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trace"
            },
            {
              "type": "null"
            }
          ]
        },
        "shrink": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShrinkStep"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_line": {
          "description": "The engine's RESULT line.",
          "type": [
            "string",
            "null"
          ]
        },
        "artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/Artifacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "control": {
          "description": "Runs on agent images: the control transcript of each conversation (added in M120).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Control"
          }
        }
      },
      "required": [
        "v",
        "type",
        "schedule",
        "verdict",
        "fingerprints"
      ]
    },
    "RunType": {
      "description": "The `type` of this record: always `\"run\"`.",
      "type": "string",
      "enum": [
        "run"
      ]
    },
    "Image": {
      "description": "The image a run booted.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The image as it was given (a path, or an explorer image name).",
          "type": "string"
        },
        "resolved": {
          "description": "The path the engine opened, when it differs from `path`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "description": "SHA-256 of the image file.",
          "type": [
            "string",
            "null"
          ]
        },
        "epoch": {
          "description": "The fingerprint epoch of the hydo that built the image (its `/etc/hydo/image.json`, added\nin M155; absent for an image built before).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "kernel": {
          "description": "The guest kernel the image names (its record), as `<file> (Linux <version>, sha256 <hex>)`\n(added in M155).",
          "type": [
            "string",
            "null"
          ]
        },
        "built_by": {
          "description": "The hydo that built the image, from the build record next to it (`<image>.json`, M155).",
          "anyOf": [
            {
              "$ref": "#/$defs/BuiltBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256": {
          "description": "SHA-256 of the manifest the image was built from (the build record, M155).",
          "type": [
            "string",
            "null"
          ]
        },
        "services": {
          "description": "The Docker/OCI images of its services with their digests (the build record, M155).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceImage"
          }
        }
      },
      "required": [
        "path"
      ]
    },
    "BuiltBy": {
      "description": "The hydo that built an image (added in M155).",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version"
      ]
    },
    "ServiceImage": {
      "description": "A service built from a Docker/OCI image (added in M155).",
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "image": {
          "description": "The image as the manifest gives it.",
          "type": "string"
        },
        "digest": {
          "description": "The image manifest's digest (`sha256:...`).",
          "type": [
            "string",
            "null"
          ]
        },
        "config_digest": {
          "description": "The image configuration's digest.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "service",
        "image"
      ]
    },
    "Engine": {
      "description": "The engine and the machine it gave the guest.",
      "type": "object",
      "properties": {
        "backend": {
          "description": "`hvx` (the Linux kernel module), `hvm` (Hypervisor.framework on the Mac) or `kvm` (stock Linux KVM).",
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "description": "The options passed to the engine (`--ram-mib`, `--vcpus`, `--cpu`).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "ram_mib": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "vcpus": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cpu": {
          "description": "The guest CPU level (`v2`, `v3`).",
          "type": [
            "string",
            "null"
          ]
        },
        "guest_kernel": {
          "description": "hvm: the guest kernel and the first 16 hex digits of its SHA-256.",
          "type": [
            "string",
            "null"
          ]
        },
        "module_srcversion": {
          "description": "hvx: the loaded module's srcversion.",
          "type": [
            "string",
            "null"
          ]
        },
        "workers": {
          "description": "An exploration's worker count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "Verdict": {
      "description": "A run's verdict.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "`ok`, `violation` or `error` (of `text`).",
          "type": "string"
        },
        "text": {
          "description": "The verdict line (the guest's `HYDO-ORACLE: ...`, or what the host made of it).",
          "type": "string"
        },
        "guest": {
          "description": "The guest's own verdict, when the host's history checks replaced it.",
          "type": [
            "string",
            "null"
          ]
        },
        "before_error_logs": {
          "description": "The verdict before the error logs failed the run (`unknown: fail`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "text"
      ]
    },
    "Fingerprints": {
      "description": "A run's fingerprints: equal fingerprints mean bit-identical runs.",
      "type": "object",
      "properties": {
        "fp": {
          "description": "The whole run (console, snapshot, guest RAM, disk).",
          "type": "string"
        },
        "wfp": {
          "description": "The workload's part.",
          "type": [
            "string",
            "null"
          ]
        },
        "ctl": {
          "description": "An agent image's run: the hash of its control transcripts (`ctl=` on the RESULT line,\nM126): equal hashes mean the host typed the same commands at the same stops.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fp"
      ]
    },
    "Finding": {
      "description": "What a run checked, in one shape for every source.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The source: `invariant`, `assertion`, `history-check`, `error-log` ([`kind`]).",
          "type": "string"
        },
        "id": {
          "description": "The property id, the check id, the invariant's id (or the verdict's signature), or the\nerror kind's signature.",
          "type": "string"
        },
        "status": {
          "description": "The outcome ([`status`]).",
          "type": "string"
        },
        "message": {
          "description": "One line for people.",
          "type": "string",
          "default": ""
        },
        "details": {
          "description": "What the source says beyond that (the examples show each source's fields).",
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "kind",
        "id",
        "status"
      ]
    },
    "PropertyTable": {
      "description": "The property table: every assertion property over a set of runs (hydo/ASSERTIONS.md).",
      "type": "object",
      "properties": {
        "runs": {
          "description": "Runs whose consoles carried records.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "setup_complete_runs": {
          "description": "Of those, runs that printed HYDO-SETUP-COMPLETE.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "violations": {
          "description": "Properties whose verdict is a FAIL.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Property"
          },
          "default": []
        }
      },
      "required": [
        "runs"
      ]
    },
    "Property": {
      "description": "One property over the runs of a table.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "assertion": {
          "description": "`always`, `always_or_unreachable`, `sometimes`, `reachable`, `unreachable`, `eventually`.",
          "type": "string"
        },
        "message": {
          "type": "string",
          "default": ""
        },
        "declared": {
          "description": "Declared in a HYDO-ASSERT-DECL record (the catalog).",
          "type": "boolean",
          "default": false
        },
        "passes": {
          "description": "Evaluations that held, and that did not.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "fails": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "runs_passed": {
          "description": "Runs with at least one such evaluation.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "runs_failed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "verdict": {
          "description": "The table's verdict (`PASS`, `FAIL`, `FAIL (never evaluated)`, `FAIL (reached)`,\n`FAIL (deadline missed)`, `NOT EXERCISED`, `NOT EVALUATED`).",
          "type": "string"
        },
        "status": {
          "description": "The verdict as a [`status`]: `ok`, `violation`, `not-exercised`, `not-evaluated`.",
          "type": "string"
        },
        "first_failure": {
          "description": "The details of the first failing evaluation, as the record wrote them.",
          "type": [
            "string",
            "null"
          ]
        },
        "slowest_ok_s": {
          "description": "Eventually properties: the slowest episode that held, in seconds.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "id",
        "assertion",
        "verdict",
        "status"
      ]
    },
    "ErrorLogs": {
      "description": "A run's error-log analysis (`errors:` in the manifest).",
      "type": "object",
      "properties": {
        "known_file": {
          "description": "The known list used (absent: none).",
          "type": [
            "string",
            "null"
          ]
        },
        "known_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "unknown": {
          "description": "`report` or `fail`: what a new kind does to the run.",
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "description": "The workload's steps (the labels of where a line was written refer to them).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "boots": {
          "description": "The guest's HYDO-ERRLOG-SUM record of every boot.",
          "type": "array",
          "items": true,
          "default": []
        },
        "truncated": {
          "description": "A boot printed only its first kinds (`errors.max`).",
          "type": "boolean",
          "default": false
        }
      }
    },
    "Counters": {
      "description": "Engine counters a run reported.",
      "type": "object",
      "properties": {
        "tjk": {
          "description": "Tick jitter: the first and last delayed tick.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "tjn": {
          "description": "Tick jitter: delayed ticks.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pctf": {
          "description": "PCT points that fired, and the window.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pctw": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "xtn": {
          "description": "Inserted ticks.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "qn": {
          "description": "vCPU turns.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "Branch": {
      "description": "A branch run's branch point.",
      "type": "object",
      "properties": {
        "tjlo": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "held": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "Trace": {
      "description": "A freeze sweep's trace run.",
      "type": "object",
      "properties": {
        "pair": {
          "description": "`<service>><peer>`.",
          "type": "string"
        },
        "dir": {
          "description": "`<` or `>`.",
          "type": "string"
        },
        "match": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": "integer",
          "format": "int64"
        },
        "count": {
          "description": "Packets of the stream in that step (absent: the freeze never fired).",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "reused": {
          "description": "Taken from an earlier sweep (`--fc-traces`), not run.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "pair",
        "dir",
        "step"
      ]
    },
    "ShrinkStep": {
      "description": "A shrink candidate's place in its shrink.",
      "type": "object",
      "properties": {
        "of": {
          "description": "The signature being shrunk (a failure's, or an error kind's).",
          "type": "string"
        },
        "round": {
          "description": "The round (1, 2, ...).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kept": {
          "description": "The candidate kept the failure and became the next round's schedule.",
          "type": "boolean"
        }
      },
      "required": [
        "of",
        "round",
        "kept"
      ]
    },
    "Artifacts": {
      "description": "Files of a run, relative to the document's directory.",
      "type": "object",
      "properties": {
        "consoles": {
          "description": "The guest consoles: the run's, then the recovery boot's after a power cut.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "engine_log": {
          "description": "Everything the engine printed (`hydo run`).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Control": {
      "description": "The control transcript of one conversation of a run on an agent image (added in M120,\ndocs/design/guest-control.md \"The control transcript\"): which controller decided, the\nengine's stop cadence, the transcript's hash and where the transcript file is. A run has one\nper conversation (the run; after a power cut also the recovery boot).",
      "type": "object",
      "properties": {
        "conversation": {
          "description": "The conversation: `run`, `recovery`, `boot` or `solo`.",
          "type": "string"
        },
        "controller": {
          "description": "The controller that decided (`schedule`), or `replay` for a transcript typed again.",
          "type": "string"
        },
        "cadence": {
          "description": "The engine's stop cadence (`rb=<n>`, or `default`).",
          "type": "string"
        },
        "hash": {
          "description": "The transcript's hash, 16 hex digits (`ctl=` on the RESULT line).",
          "type": "string"
        },
        "sends": {
          "description": "Agent commands typed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stops": {
          "description": "Stops at which the host acted.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "transcript": {
          "description": "The transcript file (`control.jsonl`, `control.recovery.jsonl`), relative to the\ndocument's directory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "conversation",
        "controller",
        "cadence",
        "hash",
        "sends",
        "stops"
      ]
    },
    "Exploration": {
      "description": "`exploration.json`: an exploration's result.",
      "type": "object",
      "properties": {
        "v": {
          "type": "integer",
          "const": 1
        },
        "type": {
          "$ref": "#/$defs/ExplorationType"
        },
        "hydo_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "epoch": {
          "description": "The fingerprint epoch of that hydo (added in M155; absent: before M155, epoch 1).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mode": {
          "description": "`seeds`, `sweep`, `branch` or `schedule`.",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/Config"
        },
        "image": {
          "$ref": "#/$defs/Image"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "freeze_sweep": {
          "description": "`--sweep freeze`: the trace and adaptive stages (their counts, centres, windows, rounds).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "failures": {
          "description": "Every failing first run, in seed order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Failure"
          },
          "default": []
        },
        "shrinks": {
          "description": "One minimal schedule per class and signature.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Shrink"

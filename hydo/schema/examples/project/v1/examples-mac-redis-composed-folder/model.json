  "data": {
    "size_mib": 64,
    "dirs": [
      "redis"
    ]
  },
  "env": {
    "TRANSFER": "atomic",
    "ACCOUNTS": "5",
    "TOTAL": "500"
  },
  "services": [
    {
      "name": "redis",
      "cmd": "/bin/redis-server /etc/redis.conf",
      "ready": "/bin/redis-cli ping | grep -q PONG",
      "port": 6379
    }
  ],
  "workload": {
    "steps": 20,
    "timeout": 120
  },
  "knobs": [
    {
      "token": "R",
      "name": "Redis appendfsync",
      "default": "always",
      "set": "/bin/redis-cli CONFIG SET appendfsync $HYDO_VALUE",
      "values": [
        "always",
        "everysec",
        "no"
      ]
    }
  ],
  "faults": [
    "kill",
    "pause",
    "cut",
    "clock",
    "disk"
  ],
  "test": {
    "parallel": 4,
    "per_round": 2,
    "round_ms": 100,
    "command_timeout": 20,
    "drain_timeout": 30,
    "commands": [

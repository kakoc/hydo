    "text": {
      "/etc/redis-primary.conf": "port 6379\nbind 0.0.0.0\nprotected-mode no\ndir /data/primary\nsave \"\"\nappendonly yes\nappendfsync always\nrepl-diskless-sync-delay 0\nhz 1\ndynamic-hz no\n",
      "/etc/redis-replica.conf": "port 6379\nbind 0.0.0.0\nprotected-mode no\ndir /data/replica\nsave \"\"\nreplicaof primary 6379\nrepl-diskless-sync-delay 0\nhz 1\ndynamic-hz no\n"
    }
  },
  "data": {
    "size_mib": 64,
    "dirs": [
      "primary",
      "replica"
    ]
  },
  "shell": "lag() {   # the primary's replication offset minus the replica's acknowledged one\n  /bin/redis-cli -h primary INFO replication 2>/dev/null | tr -d '\\r' | awk -F'[:=,]' '\n    $1 == \"master_repl_offset\" { m = $2 } $1 == \"slave0\" { for (i = 2; i < NF; i += 2) if ($i == \"offset\") o = $(i + 1) }\n    END { if (o == \"\") print \"none\"; else print m - o }'\n}\n",
  "services": [
    {
      "name": "primary",
      "cmd": "/bin/redis-server /etc/redis-primary.conf",
      "ready": "/bin/redis-cli ping | grep -q PONG",
      "port": 6379,
      "addr": "10.89.0.11"
    },
    {
      "name": "replica",
      "cmd": "/bin/redis-server /etc/redis-replica.conf",
      "ready": "/bin/redis-cli INFO replication | grep -q master_link_status:up",
      "port": 6379,
      "addr": "10.89.0.12",
      "depends_on": [
        "primary"
      ]
    }
  ],
  "workload": {
    "steps": 16,
    "run": "i=$HYDO_FROM\nwhile [ $i -lt $HYDO_TO ]; do\n  r=$(timeout 2 /bin/redis-cli -h redisp -p 6380 SET k:$i v$i 2>/dev/null)\n  if [ \"$r\" = OK ]; then echo $i >> $HYDO_ACKED; echo \"$i ack\" >> $HYDO_OUTCOMES\n  else echo \"$i unknown\" >> $HYDO_OUTCOMES; fi\n  sleep 0.5\n  echo \"redis-bridge: step $i ${r:-no answer}, replica lag $(lag)\" > /dev/console\n  i=$((i + 1))\ndone\n"
  },
  "invariants": [
    {
      "id": "primary.acked_writes_survive",
      "msg": "every SET the client saw acknowledged reads back from the primary",
      "cmd": "for i in $(cat $HYDO_ACKED); do\n  [ \"$(/bin/redis-cli -h primary GET k:$i)\" = \"v$i\" ] || { echo \"key k:$i lost on the primary\"; exit 1; }\ndone\necho \"acked=$(wc -l < $HYDO_ACKED) all on the primary\"\n"
    },
    {
      "id": "replica.catches_up",
      "type": "eventually",
      "msg": "every acknowledged SET reaches the replica within 30 s after the faults end",
      "cmd": "for i in $(cat $HYDO_ACKED); do\n  [ \"$(/bin/redis-cli -h replica GET k:$i)\" = \"v$i\" ] || { echo \"k:$i not on the replica yet (lag $(lag))\"; exit 1; }\ndone\necho \"acked=$(wc -l < $HYDO_ACKED) all on the replica\"\n",
      "within": 30
    }
  ],
  "faults": [
    "kill",
    "pause",
    "network",
    "oneway",
    "cut",
    "clock",
    "freeze",
    "protocol"
  ],
  "proxies": [
    {
      "name": "redisp",
      "port": 6380,
      "protocol": "tcp",
      "service": "primary"
    }
  ]
}

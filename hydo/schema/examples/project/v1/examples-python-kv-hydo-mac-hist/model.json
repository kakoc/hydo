{
  "format": 1,
  "name": "python-kv-hist",
  "description": "pykv (Python, hydo-assert SDK); every acknowledged PUT must survive kills and power cuts.",
  "root": {
    "files": [
      {
        "src": "files/nix",
        "dst": "/nix"
      },
      {
        "src": "files/opt/pykv/hydo_assert",
        "dst": "/opt/pykv/hydo_assert"
      },
      {
        "src": "pykv.py",
        "dst": "/opt/pykv/pykv.py"
      },
      {
        "src": "pykv_hist.py",
        "dst": "/opt/pykv/pykv_hist.py"
      }
    ]
  },
  "data": {
    "size_mib": 64,
    "dirs": [
      "pykv"
    ]
  },
  "env": {
    "PY": "/nix/store/ic0l2ykss28lr7r4by14inb3pqw87yza-python3-3.11.9/bin/python3.11",
    "PYTHONPATH": "/opt/pykv",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONHASHSEED": "0"
  },
  "services": [
    {
      "name": "pykv",
      "cmd": "$PY /opt/pykv/pykv.py serve /data/pykv 7070",
      "ready": "$PY /opt/pykv/pykv.py ping 7070",
      "port": 7070
    }
  ],
  "workload": {
    "steps": 20,
    "run": "i=$HYDO_FROM\nwhile [ $i -lt $HYDO_TO ]; do\n  if $PY /opt/pykv/pykv_hist.py put 7070 0 k:$i v$i; then echo $i >> $HYDO_ACKED; echo \"$i ack\" >> $HYDO_OUTCOMES\n  else echo \"$i unknown\" >> $HYDO_OUTCOMES; fi\n  i=$((i + 1))\ndone\n"
  },
  "knobs": [
    {
      "token": "S",
      "name": "pykv fsync before acknowledging",
      "default": "always",
      "set": "echo $HYDO_VALUE > /tmp/pykv-fsync",
      "values": [
        "always",
        "never"
      ]
    }
  ],
  "checks": [
    {
      "id": "kv.linearizable",
      "type": "linearizable",
      "history": "kv",
      "model": "register",
      "msg": "every PUT and GET is linearizable per key (an acknowledged PUT is never lost)",
      "final": "$PY /opt/pykv/pykv_hist.py readall 7070 9 $HYDO_STEPS"
    }
  ],
  "faults": [
    "kill",
    "pause",
    "cut",
    "clock",
    "disk"
  ],
  "buggify": true
}

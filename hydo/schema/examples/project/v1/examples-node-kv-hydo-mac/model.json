  "data": {
    "size_mib": 64,
    "dirs": [
      "nkv"
    ]
  },
  "services": [
    {
      "name": "nkv",
      "cmd": "/bin/node /app/nkv-server.mjs /data/nkv 7070",
      "ready": "/bin/node /app/nkv.cjs ping 7070",
      "port": 7070
    }
  ],
  "workload": {
    "steps": 20,
    "run": "i=$HYDO_FROM\nwhile [ $i -lt $HYDO_TO ]; do\n  if /bin/node /app/nkv.cjs put 7070 k:$i v$i > /dev/null; then echo $i >> $HYDO_ACKED; echo \"$i ack\" >> $HYDO_OUTCOMES\n  else echo \"$i unknown\" >> $HYDO_OUTCOMES; fi\n  i=$((i + 1))\ndone\n"
  },
  "knobs": [
    {
      "token": "S",
      "name": "nkv fdatasync before acknowledging",
      "default": "always",
      "set": "echo $HYDO_VALUE > /tmp/nkv-fsync",
      "values": [
        "always",
        "never"
      ]
    }
  ],
  "invariants": [
    {
      "id": "nkv.oracle",
      "msg": "every PUT the client saw acknowledged reads back with its value (nkv.cjs check)",
      "cmd": "/bin/node /app/nkv.cjs check 7070 $HYDO_ACKED"
    }
  ],
  "faults": [
    "kill",
    "pause",
    "cut",
    "clock",
    "disk"
  ],
  "buggify": true
}

package hydoassert

// Distinct-details mode (richcov explorer images only; added by hydo/richcov/patch-src.py).
// The stock SDK emits each (assertion, outcome) once per process, so only the first
// occurrence's details reach the console. Here an outcome is emitted again when its
// BUCKETED detail tuple differs from every tuple this process already emitted for it:
// low-cardinality keys only (store, what, attempt, count, kafka_count), numbers in
// power-of-two buckets, order ids and free-form strings excluded. At most 16 tuples per
// (assertion, outcome). Called with mu held. Deterministic like the rest of the SDK.

import (
	"fmt"
	"sort"
)

var richKeys = map[string]bool{"store": true, "what": true, "attempt": true, "count": true, "kafka_count": true}
var richSeen = map[*Assertion]map[string]bool{}

func richBucket(v interface{}) string {
	var n int64
	switch x := v.(type) {
	case int:
		n = int64(x)
	case int64:
		n = x
	case string:
		return x
	default:
		return fmt.Sprint(v)
	}
	b := int64(1)
	for b < n {
		b <<= 1
	}
	return fmt.Sprintf("<=%d", b)
}

func richNew(a *Assertion, i int, d D) bool {
	ks := []string{}
	for k := range d {
		if richKeys[k] {
			ks = append(ks, k)
		}
	}
	sort.Strings(ks)
	key := fmt.Sprint(i)
	for _, k := range ks {
		key += " " + k + "=" + richBucket(d[k])
	}
	m := richSeen[a]
	if m == nil {
		m = map[string]bool{}
		richSeen[a] = m
	}
	if !a.seen[i] {
		m[key] = true
		return true
	}
	if m[key] || len(ks) == 0 || len(m) >= 16 {
		return false
	}
	m[key] = true
	return true
}

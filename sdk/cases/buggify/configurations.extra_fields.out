HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.a","msg":"fault point fired: point b.a"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.b","msg":"fault point fired: point b.b"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.c","msg":"fault point fired: point b.c"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.d","msg":"fault point fired: point b.d"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.e","msg":"fault point fired: point b.e"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.f","msg":"fault point fired: point b.f"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.g","msg":"fault point fired: point b.g"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.h","msg":"fault point fired: point b.h"}
HYDO-ASSERT-DECL {"t":"sometimes","id":"buggify.b.é","msg":"fault point fired: point b.é"}
HYDO-ASSERT-DECL {"t":"always","id":"b.other","msg":"an ordinary assertion next to the points"}
HYDO-ASSERT {"t":"always","id":"b.other","ok":true,"msg":"an ordinary assertion next to the points"}
HYDO-BUGGIFY {"seed":"ab","enable_pm":600,"fire_pm":600,"enabled":["b.c","b.d","b.h","b.é"]}
HYDO-ASSERT {"t":"sometimes","id":"buggify.b.c","ok":true,"msg":"fault point fired: point b.c","details":{"hit":1}}
HYDO-ASSERT {"t":"sometimes","id":"buggify.b.h","ok":true,"msg":"fault point fired: point b.h","details":{"hit":1}}
HYDO-ASSERT {"t":"sometimes","id":"buggify.b.é","ok":true,"msg":"fault point fired: point b.é","details":{"hit":1}}
HYDO-ASSERT {"t":"sometimes","id":"buggify.b.d","ok":true,"msg":"fault point fired: point b.d","details":{"hit":5}}

{
  "name": "hydo-assert",
  "version": "0.1.0",
  "description": "Assertion SDK for Node.js programs tested under hydo, a deterministic hypervisor: always/sometimes/reachable/unreachable/eventually properties, BUGGIFY fault points and operation histories",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakoc/hydo.git",
    "directory": "sdk/js"
  },
  "homepage": "https://github.com/kakoc/hydo/tree/main/sdk/js#readme",
  "bugs": {
    "url": "https://github.com/kakoc/hydo/issues"
  },
  "keywords": [
    "testing",
    "assertions",
    "deterministic",
    "fault-injection",
    "simulation",
    "hydo"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./history": {
      "import": {
        "types": "./history.d.mts",
        "default": "./history.mjs"
      },
      "require": {
        "types": "./history.d.ts",
        "default": "./history.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "history.js",
    "history.mjs",
    "history.d.ts",
    "history.d.mts",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "test": "node --test test/unit.test.js test/history.test.js"
  }
}

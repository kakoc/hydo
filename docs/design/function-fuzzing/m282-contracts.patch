diff -ruN -x Cargo.lock a/semver-1.0.28/src/hydo_props.rs b/semver-1.0.28/src/hydo_props.rs
--- a/semver-1.0.28/src/hydo_props.rs	1970-01-01 01:00:00
+++ b/semver-1.0.28/src/hydo_props.rs	2026-11-17 10:57:48
@@ -0,0 +1,90 @@
+//! Properties for `hydo fuzz`, from semver's documentation.
+
+use crate::{Comparator, Prerelease, Version, VersionReq};
+use alloc::format;
+use alloc::string::ToString;
+
+/// A version that parses prints as text that parses to it again.
+// hydo: ensures result
+pub fn version_display_roundtrip(text: &str) -> bool {
+    match Version::parse(text) {
+        Ok(v) => Version::parse(&v.to_string()).ok() == Some(v),
+        Err(_) => true,
+    }
+}
+
+/// A version built from its parts parses to those parts.
+// hydo: ensures result
+pub fn version_parts_roundtrip(major: u64, minor: u64, patch: u64, pre: &str, build: &str) -> bool {
+    let mut text = format!("{major}.{minor}.{patch}");
+    if !pre.is_empty() {
+        text.push('-');
+        text.push_str(pre);
+    }
+    if !build.is_empty() {
+        text.push('+');
+        text.push_str(build);
+    }
+    match Version::parse(&text) {
+        Ok(v) => {
+            v.major == major
+                && v.minor == minor
+                && v.patch == patch
+                && v.pre.as_str() == pre
+                && v.build.as_str() == build
+        }
+        Err(_) => true,
+    }
+}
+
+/// `=M.m.p` matches `M.m.p`.
+// hydo: ensures result
+pub fn req_exact_matches(major: u64, minor: u64, patch: u64) -> bool {
+    let req = VersionReq::parse(&format!("={major}.{minor}.{patch}")).unwrap();
+    req.matches(&Version::new(major, minor, patch))
+}
+
+/// `^M.m.p` matches the next patch release unless major and minor are 0.
+// hydo: requires patch < 18446744073709551615
+// hydo: ensures result
+pub fn caret_next_patch(major: u64, minor: u64, patch: u64) -> bool {
+    let req = VersionReq::parse(&format!("^{major}.{minor}.{patch}")).unwrap();
+    let next = Version::new(major, minor, patch + 1);
+    req.matches(&next) == (major > 0 || minor > 0)
+}
+
+/// A requirement that parses prints as text that parses to it again.
+// hydo: ensures result
+pub fn req_display_roundtrip(text: &str) -> bool {
+    match VersionReq::parse(text) {
+        Ok(r) => VersionReq::parse(&r.to_string()).ok() == Some(r),
+        Err(_) => true,
+    }
+}
+
+/// A comparator that parses prints as text that parses to it again.
+// hydo: ensures result
+pub fn comparator_display_roundtrip(text: &str) -> bool {
+    match Comparator::parse(text) {
+        Ok(c) => Comparator::parse(&c.to_string()).ok() == Some(c),
+        Err(_) => true,
+    }
+}
+
+/// A pre-release that parses keeps its text.
+// hydo: ensures result
+pub fn prerelease_keeps_text(text: &str) -> bool {
+    match Prerelease::new(text) {
+        Ok(p) => p.as_str() == text,
+        Err(_) => true,
+    }
+}
+
+/// The order of two versions is antisymmetric and agrees with equality.
+// hydo: ensures result
+pub fn order_consistent(a: &str, b: &str) -> bool {
+    match (Version::parse(a), Version::parse(b)) {
+        (Ok(x), Ok(y)) => (x < y) == (y > x) && ((x == y) == (x.cmp(&y).is_eq())),
+        _ => true,
+    }
+}

+//! Properties for `hydo fuzz`, from byteorder's documentation, over `Cursor` and writers.
+
+use crate::{BigEndian, ByteOrder, LittleEndian, ReadBytesExt, WriteBytesExt};
+use std::io::{self, Cursor, Write};
+
+/// Writing a u64 and reading it back gives it, in both orders.
+// hydo: ensures result
+pub fn prop_u64_roundtrip(x: u64) -> bool {
+    let mut w = Vec::new();
+    w.write_u64::<BigEndian>(x).unwrap();
+    w.write_u64::<LittleEndian>(x).unwrap();
+    let mut r = Cursor::new(w);
+    r.read_u64::<BigEndian>().unwrap() == x && r.read_u64::<LittleEndian>().unwrap() == x
+}
+
+/// `write_uint` then `read_uint` of the same width gives the value.
+// hydo: requires nbytes >= 1 && nbytes <= 8
+// hydo: ensures result
+pub fn prop_uint_roundtrip(x: u64, nbytes: usize) -> bool {
+    let x = if nbytes == 8 { x } else { x & ((1u64 << (8 * nbytes)) - 1) };
+    let mut w = Vec::new();
+    w.write_uint::<BigEndian>(x, nbytes).unwrap();
+    Cursor::new(w).read_uint::<BigEndian>(nbytes).unwrap() == x
+}
+
+/// `read_uint` on a reader returns the errors of `read_exact`, as documented.
+// hydo: ensures result
+pub fn prop_reader_read_uint(data: Vec<u8>, nbytes: usize) -> bool {
+    let mut r = Cursor::new(&data);
+    match r.read_uint::<BigEndian>(nbytes) {
+        Ok(_) => nbytes <= data.len(),
+        Err(e) => e.kind() == io::ErrorKind::UnexpectedEof && nbytes > data.len(),
+    }
+}
+
+/// The slice form agrees with the reader form.
+// hydo: requires len(data) >= 8
+// hydo: ensures result
+pub fn prop_slice_matches_reader(data: Vec<u8>) -> bool {
+    Cursor::new(&data).read_u64::<LittleEndian>().unwrap() == LittleEndian::read_u64(&data)
+}
+
+/// A writer that fails after `n` bytes makes `write_u32` fail.
+struct Fails(usize);
+impl Write for Fails {
+    fn write(&mut self, b: &[u8]) -> io::Result<usize> {
+        if self.0 == 0 {
+            return Err(io::Error::new(io::ErrorKind::Other, "full"));
+        }
+        let k = b.len().min(self.0);
+        self.0 -= k;
+        Ok(k)
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+// hydo: requires n < 4
+// hydo: ensures result
+pub fn prop_failing_writer(x: u32, n: usize) -> bool {
+    Fails(n).write_u32::<BigEndian>(x).is_err()
+}
+
+/// i16 values keep their sign through a reader.
+// hydo: ensures result
+pub fn prop_i16_sign(x: i16) -> bool {
+    let mut w = Vec::new();
+    w.write_i16::<LittleEndian>(x).unwrap();
+    Cursor::new(w).read_i16::<LittleEndian>().unwrap() == x
+}

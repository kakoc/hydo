+//! Properties for `hydo fuzz`: sets built from bits, compared with a `BTreeSet`.
+
+use crate::FixedBitSet;
+use alloc::collections::BTreeSet;
+use alloc::vec::Vec;
+
+fn build(v: &[u16]) -> FixedBitSet {
+    let mut s = FixedBitSet::with_capacity(1 << 16);
+    for &b in v {
+        s.insert(b as usize);
+    }
+    s
+}
+
+fn model(v: &[u16]) -> BTreeSet<usize> {
+    v.iter().map(|&b| b as usize).collect()
+}
+
+// hydo: ensures result
+pub fn insert_then_contains(bits: Vec<u16>) -> bool {
+    let s = build(&bits);
+    bits.iter().all(|&b| s.contains(b as usize))
+}
+
+// hydo: ensures result
+pub fn count_ones_matches(bits: Vec<u16>) -> bool {
+    build(&bits).count_ones(..) == model(&bits).len()
+}
+
+// hydo: ensures result
+pub fn ones_sorted_and_unique(bits: Vec<u16>) -> bool {
+    build(&bits).ones().collect::<Vec<_>>() == model(&bits).into_iter().collect::<Vec<_>>()
+}
+
+// hydo: ensures result
+pub fn union_matches(a: Vec<u16>, b: Vec<u16>) -> bool {
+    let mut s = build(&a);
+    s.union_with(&build(&b));
+    let m: BTreeSet<usize> = model(&a).union(&model(&b)).copied().collect();
+    s.ones().collect::<BTreeSet<_>>() == m
+}
+
+// hydo: ensures result
+pub fn intersection_matches(a: Vec<u16>, b: Vec<u16>) -> bool {
+    let mut s = build(&a);
+    s.intersect_with(&build(&b));
+    let m: BTreeSet<usize> = model(&a).intersection(&model(&b)).copied().collect();
+    s.ones().collect::<BTreeSet<_>>() == m
+}
+
+// hydo: ensures result
+pub fn difference_matches(a: Vec<u16>, b: Vec<u16>) -> bool {
+    let mut s = build(&a);
+    s.difference_with(&build(&b));
+    let m: BTreeSet<usize> = model(&a).difference(&model(&b)).copied().collect();
+    s.ones().collect::<BTreeSet<_>>() == m
+}
+
+// hydo: ensures result
+pub fn symmetric_difference_matches(a: Vec<u16>, b: Vec<u16>) -> bool {
+    let mut s = build(&a);
+    s.symmetric_difference_with(&build(&b));
+    let m: BTreeSet<usize> = model(&a).symmetric_difference(&model(&b)).copied().collect();
+    s.ones().collect::<BTreeSet<_>>() == m
+}
+
+// hydo: ensures result
+pub fn subset_matches(a: Vec<u16>, b: Vec<u16>) -> bool {
+    build(&a).is_subset(&build(&b)) == model(&a).is_subset(&model(&b))
+}
+
+// hydo: ensures result
+pub fn disjoint_matches(a: Vec<u16>, b: Vec<u16>) -> bool {
+    build(&a).is_disjoint(&build(&b)) == model(&a).is_disjoint(&model(&b))
+}
+
+// hydo: ensures result
+pub fn min_max_match(bits: Vec<u16>) -> bool {
+    let s = build(&bits);
+    let m = model(&bits);
+    s.minimum() == m.first().copied() && s.maximum() == m.last().copied()
+}

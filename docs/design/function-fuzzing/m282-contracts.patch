+//! Properties for `hydo fuzz`: memchr's searches against the naive ones.
+
+use alloc::vec::Vec;
+
+fn naive_find(h: &[u8], n: &[u8]) -> Option<usize> {
+    if n.is_empty() {
+        return Some(0);
+    }
+    h.windows(n.len()).position(|w| w == n)
+}
+
+fn naive_rfind(h: &[u8], n: &[u8]) -> Option<usize> {
+    if n.is_empty() {
+        return Some(h.len());
+    }
+    h.windows(n.len()).rposition(|w| w == n)
+}
+
+// hydo: ensures result
+pub fn memchr_naive(needle: u8, haystack: Vec<u8>) -> bool {
+    crate::memchr(needle, &haystack) == haystack.iter().position(|&b| b == needle)
+}
+
+// hydo: ensures result
+pub fn memrchr_naive(needle: u8, haystack: Vec<u8>) -> bool {
+    crate::memrchr(needle, &haystack) == haystack.iter().rposition(|&b| b == needle)
+}
+
+// hydo: ensures result
+pub fn memchr2_naive(n1: u8, n2: u8, haystack: Vec<u8>) -> bool {
+    crate::memchr2(n1, n2, &haystack) == haystack.iter().position(|&b| b == n1 || b == n2)
+}
+
+// hydo: ensures result
+pub fn memchr3_naive(n1: u8, n2: u8, n3: u8, haystack: Vec<u8>) -> bool {
+    crate::memchr3(n1, n2, n3, &haystack)
+        == haystack.iter().position(|&b| b == n1 || b == n2 || b == n3)
+}
+
+// hydo: ensures result
+pub fn find_naive(haystack: Vec<u8>, needle: Vec<u8>) -> bool {
+    crate::memmem::find(&haystack, &needle) == naive_find(&haystack, &needle)
+}
+
+// hydo: ensures result
+pub fn rfind_naive(haystack: Vec<u8>, needle: Vec<u8>) -> bool {
+    crate::memmem::rfind(&haystack, &needle) == naive_rfind(&haystack, &needle)
+}
+
+// hydo: ensures result
+pub fn memchr_iter_naive(needle: u8, haystack: Vec<u8>) -> bool {
+    crate::memchr_iter(needle, &haystack).collect::<Vec<_>>()
+        == haystack
+            .iter()
+            .enumerate()
+            .filter(|(_, &b)| b == needle)
+            .map(|(i, _)| i)
+            .collect::<Vec<_>>()
+}

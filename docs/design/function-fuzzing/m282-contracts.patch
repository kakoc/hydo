+//! Properties for `hydo fuzz`, from num-integer's documentation, over concrete types.
+
+use crate::{Average, Integer, Roots};
+
+/// The gcd is not negative and divides both values.
+// hydo: ensures result
+pub fn prop_gcd_i64(a: i64, b: i64) -> bool {
+    let g = a.gcd(&b);
+    g >= 0 && (g == 0 || (a % g == 0 && b % g == 0)) && (g != 0 || (a == 0 && b == 0))
+}
+
+/// The same for u64.
+// hydo: ensures result
+pub fn prop_gcd_u64(a: u64, b: u64) -> bool {
+    let g = a.gcd(&b);
+    (g == 0 && a == 0 && b == 0) || (g != 0 && a % g == 0 && b % g == 0)
+}
+
+/// `div_mod_floor`: `q * y + r == x`, and `r` has the sign of `y`.
+// hydo: requires y != 0
+// hydo: ensures result
+pub fn prop_div_mod_floor(x: i32, y: i32) -> bool {
+    if x == i32::MIN && y == -1 {
+        return true;
+    }
+    let (q, r) = x.div_mod_floor(&y);
+    (q as i64) * (y as i64) + (r as i64) == x as i64 && (r == 0 || (r < 0) == (y < 0))
+}
+
+/// `div_ceil` rounds up.
+// hydo: requires y > 0
+// hydo: ensures result
+pub fn prop_div_ceil(x: i64, y: i64) -> bool {
+    let q = x.div_ceil(&y) as i128;
+    q * (y as i128) >= x as i128 && (q - 1) * (y as i128) < x as i128
+}
+
+/// `next_multiple_of` is a multiple, at least `x`.
+// hydo: requires y > 0 && x <= 1000000000000
+// hydo: ensures result
+pub fn prop_next_multiple(x: u64, y: u64) -> bool {
+    let m = Integer::next_multiple_of(&x, &y);
+    m % y == 0 && m >= x && m - x < y
+}
+
+/// The extended gcd: `x * a + y * b == gcd`.
+// hydo: requires a > -1000000000 && a < 1000000000 && b > -1000000000 && b < 1000000000
+// hydo: ensures result
+pub fn prop_extended_gcd(a: i64, b: i64) -> bool {
+    let e = a.extended_gcd(&b);
+    (e.x as i128) * (a as i128) + (e.y as i128) * (b as i128) == e.gcd as i128
+}
+
+/// `sqrt` is the floor of the square root.
+// hydo: ensures result
+pub fn prop_sqrt_u64(x: u64) -> bool {
+    let r = x.sqrt() as u128;
+    r * r <= x as u128 && (r + 1) * (r + 1) > x as u128
+}
+
+/// `cbrt` is the floor of the cube root, for negative values too.
+// hydo: ensures result
+pub fn prop_cbrt_i64(x: i64) -> bool {
+    let r = x.cbrt() as i128;
+    let x = x as i128;
+    if x >= 0 {
+        r * r * r <= x && (r + 1) * (r + 1) * (r + 1) > x
+    } else {
+        r * r * r >= x && (r - 1) * (r - 1) * (r - 1) < x
+    }
+}
+
+/// For a negative `x` and an odd `n`, `(r-1)^n < x <= r^n`.
+// hydo: requires x < 0 && n % 2 == 1 && n < 64
+// hydo: ensures result
+pub fn prop_nth_root_negative(x: i64, n: u32) -> bool {
+    let r = x.nth_root(n) as i128;
+    let x = x as i128;
+    let pow = |b: i128| (0..n).fold(1i128, |p, _| p.saturating_mul(b));
+    pow(r - 1) < x && x <= pow(r)
+}
+
+/// `average_floor` is the floor of the mean.
+// hydo: ensures result
+pub fn prop_average_floor(a: i64, b: i64) -> bool {
+    let m = a.average_floor(&b) as i128;
+    let s = a as i128 + b as i128;
+    m == s.div_euclid(2)
+}
+
+/// `binomial(n, k)` is `n! / (k! (n-k)!)`, up to the documented n of 67.
+// hydo: requires n <= 67 && k <= n
+// hydo: ensures result
+pub fn prop_binomial(n: u64, k: u64) -> bool {
+    let b = crate::binomial(n, k) as u128;
+    let mut c: u128 = 1;
+    for i in 0..k as u128 {
+        c = c * (n as u128 - i) / (i + 1);
+    }
+    b == c
+}

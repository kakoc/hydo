+//! Properties for `hydo fuzz`, from base64's documentation.
+
+use crate::engine::general_purpose::{STANDARD, STANDARD_NO_PAD_INDIFFERENT, URL_SAFE_NO_PAD};
+use crate::{decoded_len_estimate, encoded_len, Engine};
+
+/// Decoding what the standard engine encoded gives the bytes back.
+// hydo: ensures result
+pub fn roundtrip_standard(data: Vec<u8>) -> bool {
+    STANDARD.decode(STANDARD.encode(&data)).ok() == Some(data)
+}
+
+/// The same for the URL-safe engine without padding.
+// hydo: ensures result
+pub fn roundtrip_url_safe_no_pad(data: Vec<u8>) -> bool {
+    URL_SAFE_NO_PAD.decode(URL_SAFE_NO_PAD.encode(&data)).ok() == Some(data)
+}
+
+/// The encoded text is as long as `encoded_len` says.
+// hydo: ensures result
+pub fn encode_len_matches(data: Vec<u8>) -> bool {
+    Some(STANDARD.encode(&data).len()) == encoded_len(data.len(), true)
+}
+
+/// Text that decodes fits into a buffer of `decoded_len_estimate` bytes.
+// hydo: ensures result
+pub fn decode_slice_fits_estimate(text: &str) -> bool {
+    match STANDARD.decode(text) {
+        Ok(v) => {
+            let mut buf = vec![0u8; decoded_len_estimate(text.len())];
+            STANDARD.decode_slice(text, &mut buf).ok() == Some(v.len())
+        }
+        Err(_) => true,
+    }
+}
+
+/// A pad-indifferent engine decodes padded and unpadded text alike.
+// hydo: ensures result
+pub fn indifferent_takes_both(data: Vec<u8>) -> bool {
+    let padded = STANDARD.encode(&data);
+    let bare = padded.trim_end_matches('=');
+    STANDARD_NO_PAD_INDIFFERENT.decode(&padded).ok() == Some(data.clone())
+        && STANDARD_NO_PAD_INDIFFERENT.decode(bare).ok() == Some(data)
+}
+
+/// Standard text that decodes is the canonical encoding of its bytes.
+// hydo: ensures result
+pub fn decode_is_canonical(text: &str) -> bool {
+    match STANDARD.decode(text) {
+        Ok(v) => STANDARD.encode(v) == text,
+        Err(_) => true,
+    }
+}
+
+/// `encoded_len` grows with the input.
+// hydo: ensures result
+pub fn encoded_len_grows(n: usize) -> bool {
+    match (encoded_len(n, true), encoded_len(n.saturating_add(1), true)) {
+        (Some(a), Some(b)) => a <= b,
+        _ => true,
+    }
+}
